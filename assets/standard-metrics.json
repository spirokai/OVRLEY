{
  "displayTypes": {
    "definitions": {
      "text": {
        "label": "Text",
        "icon": { "source": "shared", "assetFile": "display-type-text.svg" },
        "layoutMode": "intrinsic",
        "defaults": {
          "x": 100,
          "y": 100,
          "prefix": "",
          "suffix": "",
          "decimals": 0,
          "display_type": "text",
          "unit_color": "#ffffff",
          "show_icon": true,
          "icon_size": 45,
          "icon_offset_x": 0,
          "icon_offset_y": 0,
          "icon_color": "#ffffff",
          "font": "Arial.ttf",
          "font_size": 100,
          "color": "#ffffff",
          "opacity": 1,
          "show_units": false,
          "display_unit": null
        },
        "fontSizeByType": {
          "time": 72,
          "gradient": 96,
          "heading": 100,
          "default": 100
        },
        "metricTypeOverrides": {
          "time": {
            "format": "time-24"
          },
          "distance": {
            "decimals": 1,
            "show_full_distance": true
          },
          "gps_coordinates": {
            "coordinate_format": "dms"
          },
          "total_ascent": {
            "decimals": 1,
            "show_full_ascent": true
          },
          "left_right_balance": {
            "balance_format": "percent_label"
          },
          "vertical_speed": {
            "decimals": 1
          },
          "speed": {
            "decimals": 0
          }
        }
      },
      "lap_timer": {
        "label": "Lap Times",
        "layoutMode": "intrinsic",
        "defaults": {
          "show_label": true,
          "negative_delta_color": "#61ffab",
          "positive_delta_color": "#ff6e83",
          "font_size": 50,
          "label_font": "Arial.ttf",
          "label_font_size": 17.5,
          "label_color": "#ffffff"
        },
        "modes": [
          { "value": "current_lap", "label": "Current Lap", "icon": { "source": "lucide", "name": "Timer" } },
          {
            "value": "best_lap",
            "label": "Best Lap",
            "icon": { "source": "custom", "assetFile": "display-mode-best-lap.svg" }
          },
          {
            "value": "delta",
            "label": "Delta",
            "icon": { "source": "custom", "assetFile": "display-mode-delta.svg" }
          },
          {
            "value": "lap_log",
            "label": "Lap Log",
