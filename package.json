{
  "name": "ovrley",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "postinstall": "node scripts/install-ffmpeg.mjs && node scripts/install-mdk.mjs",
    "build": "node scripts/package.mjs",
    "prepare:packaging": "node packaging/resources.mjs",
    "release": "semantic-release",
    "dev:native": "cargo run -p ovrley_ui --bin ovrley",
    "dev:native:live": "SLINT_LIVE_PREVIEW=1 cargo run -p ovrley_ui --bin ovrley --features live-preview",
    "showcase:native": "cargo run -p ovrley_ui --features dev-windows --example showcase",
    "test:native-ui": "cargo test -p ovrley_app -p ovrley_ui -p ovrley_services -p ovrley_mcp --features ovrley_ui/dev-windows",
    "benchmark:transparent": "cargo run -p ovrley_core --bin benchmark_transparent --",
    "benchmark:composite": "cargo run -p ovrley_core --bin benchmark_composite --",
    "benchmark:widget-rate": "cargo run -p ovrley_core --bin benchmark_widget_rate --",
    "benchmark:widgets": "node benchmarks/widgets/run.mjs",
    "benchmark:widgets:build": "node benchmarks/widgets/run.mjs --build",
    "benchmark:widgets:summary": "node benchmarks/widgets/summarize.mjs",
    "benchmark:interactions": "node benchmarks/widget-interactions/run.mjs",
    "benchmark:map-labels": "node benchmarks/map-labels/run.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@10.25.0",
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "semantic-release": "^25.0.3"
  }
}
