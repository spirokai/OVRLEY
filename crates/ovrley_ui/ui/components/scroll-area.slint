import { Theme } from "../theme.slint";

// A Flickable with the app's one scrollbar, `.thin-scrollbar`: 0.148rem wide, a 1px radius thumb
// `foreground` at 40%, `accent` on hover and while dragged, on a transparent track. The bar sits
// beside the content, never over it (`scrollbar-gutter: stable`).
export component ScrollArea {
    in-out property <length> content-y <=> flick.content-y;
    out property <length> content-height: flick.content-height;
    out property <length> visible-height: flick.height;

    property <length> bar-size: Theme.scrollbar-size * 1rem;
    property <length> scroll-range: max(0px, flick.content-height - flick.height);
    property <length> thumb-length: flick.content-height > 0px ? max(2rem, flick.height * flick.height / flick.content-height) : 0px;
    property <length> drag-start-content-y;

    // Desktop scroll areas scroll with the wheel and the scrollbar, never by dragging the content
    // with the mouse (Slint's default), and only vertically.
    flick := Flickable {
        width: root.width;
        height: root.height;
        interactive: false;
        content-width: self.width;
        // Here the width would then depend on the height it produces, a binding loop, so the
        // scrollbar's width is always reserved. `x` pins the content to the left edge: an element
        // with a width but no `x` is centred, which would push it half a bar under the scrollbar.
        VerticalLayout {
            x: 0px;
            width: root.width - root.bar-size;
            alignment: start;
            @children
        }
    }

    if root.scroll-range > 0px: Rectangle {
        x: root.width - root.bar-size;
        width: root.bar-size;
        height: root.height;

        property <length> thumb-y: (root.height - root.thumb-length) * (-flick.content-y / root.scroll-range);
        property <bool> thumb-hovered: track-touch.has-hover && track-touch.mouse-y >= self.thumb-y && track-touch.mouse-y < self.thumb-y + root.thumb-length;
        property <bool> dragging;

        Rectangle {
            y: parent.thumb-y;
            height: root.thumb-length;
            border-radius: Theme.scrollbar-thumb-radius * 1rem;
            background: parent.thumb-hovered || parent.dragging ? Theme.scrollbar-thumb-hover : Theme.scrollbar-thumb;
        }

        // The touch area covers the fixed track, not the moving thumb: pointer positions inside the
        // thumb would shift as it moves and feed back into the drag.
        track-touch := TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    parent.dragging = parent.thumb-hovered;
                    root.drag-start-content-y = flick.content-y;
                } else if event.kind == PointerEventKind.up {
                    parent.dragging = false;
                }
            }
            moved => {
                if parent.dragging {
                    flick.content-y = clamp(
                        root.drag-start-content-y - (self.mouse-y - self.pressed-y) * root.scroll-range / (root.height - root.thumb-length),
                        -root.scroll-range,
                        0px);
                }
            }
        }
    }
}
