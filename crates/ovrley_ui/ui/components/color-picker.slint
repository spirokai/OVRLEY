import { Theme, WindowMetrics } from "../theme.slint";
import { AppText } from "text.slint";
import { Shadow, ShadowSize, GroupPosition, GroupSurface, OverlayMotion } from "surface.slint";
import { FocusRing } from "focus.slint";
import { Slider } from "slider.slint";
import { Input } from "input.slint";
import { Select } from "select.slint";
import { Choice, ColorFormat, ColorPickerLogic, Hsv, Rgba, Placement, PlacementAlign, PlacementLogic, PlacementSide } from "logic.slint";

// Slint has no context, so the parts take the picker's state (`color`, `hsv`, `format`) from their
// caller, which owns it, and report changes through callbacks.

// The saturation/value area: 10rem high, crosshair cursor. Its background is the hue at full
// saturation and value, under white fading to transparent left to right and transparent fading to
// black top to bottom. Pressing or dragging sets saturation = x and value = 1 − y, in whole
// percent. The thumb is 0.75rem, white, with a 2px border. The border and radius are the caller's
// `h-40 w-full rounded-sm border border-border/60`.
export component ColorPickerArea {
    in property <Hsv> hsv;
    in property <bool> disabled;
    callback hsv-changed(hsv: Hsv);
    callback drag-started();
    callback drag-ended();

    function update(x: length, y: length) {
        root.hsv-changed({
            h: root.hsv.h,
            s: round(clamp(x / root.width, 0, 1) * 100),
            v: round(clamp(1 - y / root.height, 0, 1) * 100),
            a: root.hsv.a,
        });
    }

    height: 10rem;
    horizontal-stretch: 1;
    opacity: root.disabled ? 0.5 : 1;

    Rectangle {
        border-radius: Theme.radius-sm * 1rem;
        border-width: 1px;
        border-color: Theme.border.transparentize(0.4);
        clip: true;

        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            border-radius: Theme.radius-xs * 1rem;
            clip: true;
            background: ColorPickerLogic.hex-to-color(ColorPickerLogic.rgb-to-hex(ColorPickerLogic.hsv-to-rgb({ h: root.hsv.h, s: 100, v: 100, a: 1 })));

            Rectangle {
                background: @linear-gradient(90deg, #ffffff 0%, #ffffff00 100%);
            }
            Rectangle {
                background: @linear-gradient(180deg, #00000000 0%, #000000 100%);
            }
        }
    }

    Rectangle {
        width: 0.75rem;
        height: 0.75rem;
        x: root.width * root.hsv.s / 100 - self.width / 2;
        y: root.height * (100 - root.hsv.v) / 100 - self.height / 2;

        Shadow {
            size: ShadowSize.sm;
            radius: parent.width / 2;
        }
        Rectangle {
            border-radius: parent.width / 2;
            border-width: 2px;
            border-color: #ffffff;
        }
    }

    TouchArea {
        enabled: !root.disabled;
        mouse-cursor: MouseCursor.crosshair;
        pointer-event(event) => {
            if event.button != PointerEventButton.left {
                return;
            }
            if event.kind == PointerEventKind.down {
                root.drag-started();
                root.update(self.mouse-x, self.mouse-y);
            } else if event.kind == PointerEventKind.up {
                root.drag-ended();
            }
        }
        moved => {
            if self.pressed {
                root.update(self.mouse-x, self.mouse-y);
            }
        }
    }
}

// The hue slider: 0–360 in steps of 1, a 0.75rem rainbow track with 7 stops, a 1rem thumb with a
// `primary`-at-50% border on `background`, and a 1px focus ring.
export component ColorPickerHueSlider inherits Slider {
    minimum: 0;
    maximum: 360;
    step: 1;
    track-thickness: 0.75rem;
    track-background: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.66%, #00ff00 33.33%, #00ffff 50%, #0000ff 66.66%, #ff00ff 83.33%, #ff0000 100%);
    range-background: transparent;
    thumb-background: Theme.background;
    thumb-border-color: Theme.primary.transparentize(0.5);
    thumb-ring: false;
}

// Its size, radius, border and shadow are the caller's (`size-5 rounded-xs border border-border/70
// shadow-sm` in the trigger).
export component ColorPickerSwatch {
    in property <Rgba> color;
    in property <ColorFormat> format;
    in property <bool> disabled;

    accessible-role: AccessibleRole.image;
    accessible-label: @tr("components.currentColorVal" => "Current color: {0}", ColorPickerLogic.color-to-string(root.color, root.format));
    opacity: root.disabled ? 0.5 : 1;

    Shadow {
        size: ShadowSize.sm;
        radius: Theme.radius-xs * 1rem;
    }
    Rectangle {
        border-radius: Theme.radius-xs * 1rem;
        border-width: 1px;
        border-color: Theme.border.transparentize(0.3);
        background: ColorPickerLogic.hex-to-color(ColorPickerLogic.rgb-to-hex(root.color));
    }
}

// The format select: HEX, RGB, HSL, HSB.
export component ColorPickerFormatSelect inherits Select {
    in property <ColorFormat> format;
    callback format-changed(format: ColorFormat);

    items: [{ value: "hex", label: "HEX" }, { value: "rgb", label: "RGB" }, { value: "hsl", label: "HSL" }, { value: "hsb", label: "HSB" }];
    value: root.format == ColorFormat.rgb ? "rgb" : root.format == ColorFormat.hsl ? "hsl" : root.format == ColorFormat.hsb ? "hsb" : "hex";
    width: 4.5rem;
    horizontal-stretch: 0;
    background: Theme.surface;
    border-color: Theme.border.transparentize(0.3);
    font-size: Theme.text-xs * 1rem;
    mono: true;
    uppercase: true;
    value-changed(value) => {
        root.format-changed(value == "rgb" ? ColorFormat.rgb : value == "hsl" ? ColorFormat.hsl : value == "hsb" ? ColorFormat.hsb : ColorFormat.hex);
    }
}

// One input of the group. It shows `value` and reports text that parses as an integer within
// 0..=max; other text is replaced by `value` again.
component ChannelInput {
    in property <float> value;
    in property <float> max;
    in property <string> label;
    in property <GroupPosition> group-position;
    in property <bool> disabled;
    callback value-entered(value: float);

    property <string> text: round(root.value) + "";
    changed value => {
        root.text = round(root.value) + "";
    }

    width: 3.25rem;
    Input {
        width: root.width;
        text <=> root.text;
        label: root.label;
        placeholder: "0";
        group-position: root.group-position;
        disabled: root.disabled;
        background: Theme.surface;
        border-color: Theme.border.transparentize(0.3);
        font-size: Theme.text-xs * 1rem;
        mono: true;
        horizontal-alignment: center;
        edited(text) => {
            let parsed = ColorPickerLogic.parse-channel(text, root.max);
            if parsed.valid {
                root.value-entered(parsed.value);
            }
            root.text = round(root.value) + "";
        }
    }
}

// While focused it keeps the typed text and applies each value that parses; on blur it shows the
// parsed value normalized, or the current one. - rgb (0–255), hsl (hue 0–360, saturation and
// lightness 0–100) and hsb: each channel applies when it is an integer within range. The channels
// form an input group.
export component ColorPickerInput {
    in property <Rgba> color;
    in property <Hsv> hsv;
    in property <ColorFormat> format;
    in property <bool> disabled;
    callback color-entered(color: Rgba);

    // The hex field and the three 3.25rem channels are both 9.75rem wide.
    width: 9.75rem;
    height: 2.25rem;

    property <string> hex-value: ColorPickerLogic.rgb-to-hex(root.color);
    // The field's text.
    property <string> hex-text;
    property <bool> hex-focused;
    // The parts live in the picker's popup, created after the logic is bound.
    init => {
        root.hex-text = root.hex-value.to-uppercase();
    }
    changed hex-value => {
        if !root.hex-focused {
            root.hex-text = root.hex-value.to-uppercase();
        }
    }

    if root.format == ColorFormat.hex: Input {
        width: 9.75rem;
        text <=> root.hex-text;
        label: @tr("components.hexColorValue" => "Hex color value");
        placeholder: "#000000";
        disabled: root.disabled;
        background: Theme.surface;
        border-color: Theme.border.transparentize(0.3);
        font-size: Theme.text-xs * 1rem;
        mono: true;
        horizontal-alignment: center;
        focus-changed(focused) => {
            root.hex-focused = focused;
            if !focused {
                let parsed = ColorPickerLogic.parse-color-string(root.hex-text);
                root.hex-text = (parsed.valid ? ColorPickerLogic.rgb-to-hex(parsed.color) : root.hex-value).to-uppercase();
            }
        }
        edited(text) => {
            let parsed = ColorPickerLogic.parse-color-string(text);
            if parsed.valid {
                root.color-entered({ r: parsed.color.r, g: parsed.color.g, b: parsed.color.b, a: root.color.a });
            }
        }
    }

    if root.format == ColorFormat.rgb: HorizontalLayout {
        ChannelInput {
            value: root.color.r;
            max: 255;
            label: @tr("components.redColorComponent0255" => "Red color component (0-255)");
            group-position: GroupPosition.first;
            disabled: root.disabled;
            value-entered(v) => { root.color-entered({ r: v, g: root.color.g, b: root.color.b, a: root.color.a }); }
        }
        ChannelInput {
            value: root.color.g;
            max: 255;
            label: @tr("components.greenColorComponent0255" => "Green color component (0-255)");
            group-position: GroupPosition.middle;
            disabled: root.disabled;
            value-entered(v) => { root.color-entered({ r: root.color.r, g: v, b: root.color.b, a: root.color.a }); }
        }
        ChannelInput {
            value: root.color.b;
            max: 255;
            label: @tr("components.blueColorComponent0255" => "Blue color component (0-255)");
            group-position: GroupPosition.last;
            disabled: root.disabled;
            value-entered(v) => { root.color-entered({ r: root.color.r, g: root.color.g, b: v, a: root.color.a }); }
        }
    }

    if root.format == ColorFormat.hsl: HorizontalLayout {
        ChannelInput {
            value: ColorPickerLogic.rgb-to-hsl(root.color).h;
            max: 360;
            label: @tr("components.hueDegree0360" => "Hue degree (0-360)");
            group-position: GroupPosition.first;
            disabled: root.disabled;
            value-entered(v) => {
                let hsl = ColorPickerLogic.rgb-to-hsl(root.color);
                root.color-entered(ColorPickerLogic.hsl-to-rgb({ h: v, s: hsl.s, l: hsl.l }, root.color.a));
            }
        }
        ChannelInput {
            value: ColorPickerLogic.rgb-to-hsl(root.color).s;
            max: 100;
            label: @tr("components.saturationPercentage0100" => "Saturation percentage (0-100)");
            group-position: GroupPosition.middle;
            disabled: root.disabled;
            value-entered(v) => {
                let hsl = ColorPickerLogic.rgb-to-hsl(root.color);
                root.color-entered(ColorPickerLogic.hsl-to-rgb({ h: hsl.h, s: v, l: hsl.l }, root.color.a));
            }
        }
        ChannelInput {
            value: ColorPickerLogic.rgb-to-hsl(root.color).l;
            max: 100;
            label: @tr("components.lightnessPercentage0100" => "Lightness percentage (0-100)");
            group-position: GroupPosition.last;
            disabled: root.disabled;
            value-entered(v) => {
                let hsl = ColorPickerLogic.rgb-to-hsl(root.color);
                root.color-entered(ColorPickerLogic.hsl-to-rgb({ h: hsl.h, s: hsl.s, l: v }, root.color.a));
            }
        }
    }

    if root.format == ColorFormat.hsb: HorizontalLayout {
        ChannelInput {
            value: root.hsv.h;
            max: 360;
            label: @tr("components.hueDegree0360" => "Hue degree (0-360)");
            group-position: GroupPosition.first;
            disabled: root.disabled;
            value-entered(v) => { root.color-entered(ColorPickerLogic.hsv-to-rgb({ h: v, s: root.hsv.s, v: root.hsv.v, a: root.hsv.a })); }
        }
        ChannelInput {
            value: root.hsv.s;
            max: 100;
            label: @tr("components.saturationPercentage0100" => "Saturation percentage (0-100)");
            group-position: GroupPosition.middle;
            disabled: root.disabled;
            value-entered(v) => { root.color-entered(ColorPickerLogic.hsv-to-rgb({ h: root.hsv.h, s: v, v: root.hsv.v, a: root.hsv.a })); }
        }
        ChannelInput {
            value: root.hsv.v;
            max: 100;
            label: @tr("components.brightnessPercentage0100" => "Brightness percentage (0-100)");
            group-position: GroupPosition.last;
            disabled: root.disabled;
            value-entered(v) => { root.color-entered(ColorPickerLogic.hsv-to-rgb({ h: root.hsv.h, s: root.hsv.s, v: v, a: root.hsv.a })); }
        }
    }
}

// Its value is normalized with `normalize-hex-color`. With `custom-trigger` the caller draws the
// trigger: the picker fills its parent, which it anchors to, and the caller opens it with `open`
// (the gradient stops). Top to bottom: the area, the hue slider, the format select and input, the
// presets, and the slot (extra content). Commit rules, exactly as today: - while open, edits change
// a draft, which every picker change passes through `normalize-hex-color(value, draft)`; outside
// the hex format the picker reports `rgb(…)`-style strings, which keep the previous draft; -
// dragging in the area commits at most once per frame and again on release. It shows the draft
// while open and the committed value otherwise.
export component HexColorPicker {
    in property <string> value;
    in property <bool> disabled;
    in property <bool> show-value: true;
    in property <bool> custom-trigger;
    in property <[string]> preset-colors: ["#ffffff", "#afeeee", "#40e0d0", "#005b5b", "#c65102", "#000000"];
    // The hex field's fill, the call site's override: the widget editor's fields sit on `surface`.
    in property <color> field-background: transparent;
    // The hex field's type, the call site's override: the widget editor matches its fields.
    in property <length> field-font-size: 0.815rem;
    in property <bool> field-mono: true;
    out property <bool> is-open: popup.is-open;
    callback changed(hex: string);

    property <string> normalized: ColorPickerLogic.normalize-hex-color(root.value, "#000000");
    property <string> draft;
    property <Rgba> color;
    property <Hsv> hsv;
    property <ColorFormat> format: ColorFormat.hex;
    property <bool> area-dragging;
    property <bool> commit-scheduled;
    property <length> content-width: 21.25rem;
    property <length> radius: Theme.radius-sm * 1rem;
    property <bool> popup-open: popup.is-open;
    // What the trigger shows: the draft while open, the committed value otherwise.
    property <string> shown-value: popup.is-open ? root.draft : root.normalized;
    // The hex field's text: the shown value until the user edits it, and again after each commit or
    // revert.
    property <string> hex-text: root.shown-value.to-uppercase();
    property <bool> hex-field-focused;

    // The store follows the draft, keeping its alpha.
    function sync-store() {
        root.color = ColorPickerLogic.hex-to-rgb(root.draft, root.color.a);
        root.hsv = ColorPickerLogic.rgb-to-hsv(root.color);
    }
    function set-draft(next: string) {
        if next != root.draft {
            root.draft = next;
            root.sync-store();
        }
    }
    function value-change(color: Rgba) {
        root.set-draft(ColorPickerLogic.normalize-hex-color(ColorPickerLogic.color-to-string(color, root.format), root.draft));
        if root.area-dragging {
            root.commit-scheduled = true;
        }
    }
    function set-hsv(next: Hsv) {
        root.hsv = next;
        root.value-change(ColorPickerLogic.hsv-to-rgb(next));
    }
    function set-color(next: Rgba) {
        root.color = next;
        root.value-change(next);
    }
    function commit-draft() {
        root.commit-scheduled = false;
        let next = ColorPickerLogic.normalize-hex-color(root.draft, root.normalized);
        if next != root.normalized {
            root.changed(next);
        }
    }
    // Commits the hex field's text when it is a valid hex colour that differs from the value;
    // otherwise the field shows the value again.
    function commit-hex-text() {
        let next = ColorPickerLogic.normalize-hex-color(root.hex-text, "");
        if next != "" && next != root.normalized {
            root.changed(next);
        }
        root.hex-text = (next != "" ? next : root.shown-value).to-uppercase();
    }
    public function close-picker() {
        popup.close();
    }
    public function open() {
        if root.disabled || popup.is-open {
            return;
        }
        popup.show();
    }

    changed normalized => {
        if !popup.is-open {
            root.set-draft(root.normalized);
        }
    }
    changed shown-value => {
        root.hex-text = root.shown-value.to-uppercase();
    }
    changed popup-open => {
        if !root.popup-open {
            root.area-dragging = false;
            root.commit-draft();
            root.set-draft(root.normalized);
        } else {
            root.set-draft(root.normalized);
            root.sync-store();
        }
    }

    // Area drags commit at most once per frame (~16 ms).
    Timer {
        interval: 16ms;
        running: root.commit-scheduled;
        triggered => {
            root.commit-draft();
        }
    }

    min-height: root.custom-trigger ? 0px : 2.25rem;
    max-height: root.custom-trigger ? 100000px : 2.25rem;
    horizontal-stretch: root.custom-trigger ? 0 : 1;

    // The default trigger (user's design, 2026-11-14): a group like the input + button one. The
    // hex field on the left takes typed or pasted values and commits a valid one on Enter or blur
    // (normalized; anything else reverts). The swatch button on the right is filled with the colour
    // edge to edge and opens the picker; beside the field it is square, without it it takes the
    // picker's whole width. One focus ring goes around the field and the swatch.
    if !root.custom-trigger: Rectangle {
      opacity: root.disabled ? 0.5 : 1;
      HorizontalLayout {

        if root.show-value: hex-field := Input {
            horizontal-stretch: 1;
            text <=> root.hex-text;
            label: @tr("components.hexColorValue" => "Hex color value");
            placeholder: "#000000";
            group-position: GroupPosition.first;
            disabled: root.disabled;
            mono: root.field-mono;
            font-size: root.field-font-size;
            background: root.field-background;
            show-focus-ring: false;
            focus-changed(focused) => {
                root.hex-field-focused = focused;
                if focused {
                    root.hex-text = root.shown-value.to-uppercase();
                } else {
                    root.commit-hex-text();
                }
            }
            accepted => {
                self.blur();
            }
        }

        swatch-button := Rectangle {
            min-width: 2.25rem;
            max-width: root.show-value ? 2.25rem : 100000px;
            horizontal-stretch: root.show-value ? 0 : 1;
            accessible-role: AccessibleRole.button;
            accessible-label: @tr("components.currentColorVal" => "Current color: {0}", root.shown-value);
            accessible-action-default => {
                root.open();
            }

            Shadow {
                size: ShadowSize.xs;
                radius: root.radius;
            }
            GroupSurface {
                group-position: root.show-value ? GroupPosition.last : GroupPosition.isolated;
                radius: root.radius;
                background: ColorPickerLogic.hex-to-color(root.shown-value);
            }
            swatch-touch := TouchArea {
                enabled: !root.disabled;
                mouse-cursor: root.disabled ? MouseCursor.not-allowed : MouseCursor.pointer;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        swatch-focus.focus();
                    }
                }
                clicked => {
                    root.open();
                }
            }
            swatch-focus := FocusScope {
                out property <bool> focus-visible;
                enabled: !root.disabled;
                focus-on-click: false;
                focus-gained(reason) => {
                    self.focus-visible = reason == FocusReason.tab-navigation;
                }
                focus-lost => {
                    self.focus-visible = false;
                }
                key-pressed(event) => {
                    if event.text == Key.Return || event.text == " " {
                        root.open();
                        return accept;
                    }
                    reject
                }
            }
        }
      }
      FocusRing {
          shown: root.hex-field-focused || swatch-focus.focus-visible;
          ring-width: 1px;
          radius: root.radius;
      }
    }

    popup := PopupWindow {
        property <Placement> placed: PlacementLogic.place(
            { x: root.absolute-position.x, y: root.absolute-position.y, width: root.width, height: root.height },
            root.content-width, content.preferred-height, WindowMetrics.width, WindowMetrics.height,
            PlacementSide.bottom, PlacementAlign.start, 8px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        x: self.placed.x - root.absolute-position.x;
        y: self.placed.y - root.absolute-position.y;
        width: root.content-width;
        height: content.preferred-height;

        OverlayMotion {
            side: popup.placed.side;
            Shadow {
                size: ShadowSize.xxl;
                radius: root.radius;
                has-color: true;
                color: Theme.background.transparentize(0.6);
            }
            Rectangle {
                border-radius: root.radius;
                border-width: 1px;
                border-color: Theme.border.transparentize(0.2);
                background: Theme.card.transparentize(0.05);
            }
            content := VerticalLayout {
                padding: 0.75rem;
                spacing: 1rem;

                ColorPickerArea {
                    hsv: root.hsv;
                    disabled: root.disabled;
                    drag-started => {
                        root.area-dragging = true;
                    }
                    drag-ended => {
                        root.area-dragging = false;
                        root.commit-draft();
                    }
                    hsv-changed(next) => {
                        root.set-hsv(next);
                        root.set-color(ColorPickerLogic.hsv-to-rgb(next));
                    }
                }
                ColorPickerHueSlider {
                    value: root.hsv.h;
                    disabled: root.disabled;
                    value-changed(h) => {
                        let next = { h: h, s: root.hsv.s, v: root.hsv.v, a: root.hsv.a };
                        root.set-hsv(next);
                        root.set-color(ColorPickerLogic.hsv-to-rgb(next));
                    }
                    value-committed => {
                        root.commit-draft();
                    }
                }
                HorizontalLayout {
                    spacing: 0.5rem;
                    alignment: space-between;
                    ColorPickerFormatSelect {
                        format: root.format;
                        disabled: root.disabled;
                        format-changed(next) => {
                            root.format = next;
                        }
                    }
                    ColorPickerInput {
                        color: root.color;
                        hsv: root.hsv;
                        format: root.format;
                        disabled: root.disabled;
                        color-entered(next) => {
                            root.set-color(next);
                            root.set-hsv(ColorPickerLogic.rgb-to-hsv(next));
                        }
                    }
                }
                VerticalLayout {
                    spacing: 0.5rem;
                    AppText {
                        content: @tr("components.presets" => "Presets");
                        uppercase: true;
                        font-size: 0.667rem;
                        font-weight: Theme.font-weight-bold;
                        tracking: 0.24;
                        color: Theme.muted-foreground;
                    }
                    // `grid grid-cols-6 gap-2`: each swatch at the start of an equal cell.
                    HorizontalLayout {
                        spacing: 0.5rem;
                        for preset in root.preset-colors: Rectangle {
                            horizontal-stretch: 1;
                            height: 2.25rem;
                            swatch := Rectangle {
                                x: 0px;
                                width: 2.25rem;
                                height: 2.25rem;
                                accessible-role: AccessibleRole.button;
                                accessible-label: "Use color " + preset;
                                accessible-action-default => {
                                    swatch.choose();
                                }
                                function choose() {
                                    let next = ColorPickerLogic.normalize-hex-color(preset, "#000000");
                                    root.set-draft(next);
                                    root.changed(next);
                                }
                                Shadow {
                                    size: ShadowSize.sm;
                                    radius: Theme.radius-xs * 1rem;
                                }
                                Rectangle {
                                    border-radius: Theme.radius-xs * 1rem;
                                    border-width: 1px;
                                    border-color: preset-touch.has-hover ? Theme.accent-border : Theme.border.transparentize(0.3);
                                    background: ColorPickerLogic.hex-to-color(ColorPickerLogic.normalize-hex-color(preset, "#000000"));
                                }
                                preset-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        swatch.choose();
                                    }
                                }
                            }
                        }
                    }
                }
                @children
            }
        }
    }

}
