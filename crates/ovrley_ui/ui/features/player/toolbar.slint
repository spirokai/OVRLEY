import { Theme } from "../../theme.slint";
import { AppText } from "../../components/text.slint";
import { Icons } from "../../components/icons.slint";
import { Button, ButtonVariant, ButtonSize } from "../../components/button.slint";
import { SimpleTooltip } from "../../components/tooltip.slint";
import { Shadow, ShadowSize } from "../../components/surface.slint";
import { TabsList, TabsListVariant, TabsTriggerVariant } from "../../components/tabs.slint";
import { Choice, PlacementSide } from "../../components/logic.slint";
import { Player } from "index.slint";

// A `toolbar-icon` button with its tooltip above (`SimpleTooltip side="top"`).
export component PlayerToolButton {
    height: 1.75rem;
    width: 1.75rem;
    in property <string> icon;
    in property <length> icon-size: 1.1rem;
    in property <string> label;
    in property <ButtonVariant> variant: ButtonVariant.toolbar;
    in property <bool> disabled;
    in property <bool> pressed;
    in property <bool> tooltip: true;
    callback clicked();

    SimpleTooltip {
        content: root.tooltip ? root.label : "";
        side: PlacementSide.top;
        Button {
            variant: root.variant;
            size: ButtonSize.toolbar-icon;
            icon: root.icon;
            icon-size: root.icon-size;
            disabled: root.disabled;
            pressed: root.pressed;
            accessible-label: root.label;
            clicked => {
                root.clicked();
            }
        }
    }
}

// A ghost `toolbar-icon` button showing a monospace character, with its tooltip above.
component PlayerTextButton {
    in property <string> text;
    in property <string> label;
    in property <bool> disabled;
    callback clicked();
    height: 1.75rem;
    width: 1.75rem;
    SimpleTooltip {
        content: root.label;
        side: PlacementSide.top;
        Button {
            variant: ButtonVariant.ghost;
            size: ButtonSize.toolbar-icon;
            disabled: root.disabled;
            accessible-label: root.label;
            clicked => {
                root.clicked();
            }
            AppText {
                content: root.text;
                mono: true;
                uppercase: false;
                font-size: Theme.text-base * 1rem;
                color: Theme.foreground;
            }
        }
    }
}

// Left: zoom out, zoom in, reset view and the fit tabs. "Play", "Pause", "Mute video" and "Unmute
// video" stay English.
export component PlayerToolbar {
    property <length> transport-width: transport.preferred-width;
    property <length> side-width: max(0px, (root.width - root.transport-width - 2 * 1rem) / 2);
    // The transport group.
    property <length> row-height: 1.75rem + 2 * root.inset;
    property <length> inset: 0.125rem + 1px;

    height: root.row-height;

    // The zoom, fit, trim and edit buttons and the transport are still during playback: drawn from
    // cached layers. The time label changes every second and stays outside them.
    left := HorizontalLayout {
        x: 0px;
        y: 0px;
        height: root.row-height;
        width: root.side-width;
        cache-rendering-hint: true;
        spacing: 0.25rem;
        alignment: start;
        // The transport group's inset, so the buttons share its centre line.
        padding-top: root.inset;
        padding-bottom: root.inset;
        PlayerToolButton {
            icon: Icons.zoom-out;
            label: @tr("player.zoomOut" => "Zoom out");
            disabled: !Player.can-zoom-out;
            clicked => {
                Player.zoom-out();
            }
        }

        PlayerToolButton {
            icon: Icons.zoom-in;
            label: @tr("player.zoomIn" => "Zoom in");
            disabled: !Player.can-zoom-in;
            clicked => {
                Player.zoom-in();
            }
        }

        PlayerToolButton {
            icon: Icons.rotate-ccw;
            label: @tr("player.resetView" => "Reset view");
            disabled: Player.reset-view-disabled;
            clicked => {
                Player.reset-view();
            }
        }

        HorizontalLayout {
            padding-left: 0.25rem;
            VerticalLayout {
                alignment: center;
                TabsList {
                    items: Player.fit-targets;
                    value: Player.fit-target;
                    variant: TabsListVariant.toolbar;
                    trigger-variant: TabsTriggerVariant.toolbar;
                    value-changed(id) => {
                        Player.fit-target-selected(id);
                    }
                }
            }
        }
        // `[` and `]` trim the video at the playhead, or the activity without videos.
        if Player.trim-visible: HorizontalLayout {
            padding-left: 0.5rem;
            spacing: 0.25rem;
            PlayerTextButton {
                text: "[";
                label: Player.trim-targets-video ? @tr("player.trimVideoBeforePlayhead" => "Trim the video before the playhead") : @tr("player.trimActivityBeforePlayhead" => "Trim the activity before the playhead");
                disabled: !Player.can-trim-start;
                clicked => {
                    Player.trim(true);
                }
            }

            PlayerTextButton {
                text: "]";
                label: Player.trim-targets-video ? @tr("player.trimVideoAfterPlayhead" => "Trim the video after the playhead") : @tr("player.trimActivityAfterPlayhead" => "Trim the activity after the playhead");
                disabled: !Player.can-trim-end;
                clicked => {
                    Player.trim(false);
                }
            }
        }
        // Cut (Scissors, 0.875rem) and exclude (Eye or EyeOff, pressed state).
        if Player.video-edit-visible: HorizontalLayout {
            padding-left: 0.5rem;
            spacing: 0.25rem;
            PlayerToolButton {
                icon: Icons.scissors;
                variant: ButtonVariant.ghost;
                label: @tr("player.cutAtPlayhead" => "Cut the video at the playhead");
                disabled: !Player.can-cut;
                clicked => {
                    Player.cut();
                }
            }

            PlayerToolButton {
                icon: Player.excluded ? Icons.eye-off : Icons.eye;
                variant: ButtonVariant.ghost;
                label: Player.excluded ? @tr("player.includeAtPlayhead" => "Include this part in export") : @tr("player.excludeAtPlayhead" => "Exclude this part from export");
                disabled: Player.exclude-disabled;
                pressed: Player.excluded;
                clicked => {
                    Player.toggle-excluded();
                }
            }
        }
    }

    transport := HorizontalLayout {
        x: root.side-width + 1rem;
        y: 0px;
        height: root.row-height;
        width: root.transport-width;
        alignment: center;
        Rectangle {
            cache-rendering-hint: true;
            Shadow {
                size: ShadowSize.sm;
                radius: Theme.radius-xs * 1rem;
            }

            Rectangle {
                border-radius: Theme.radius-xs * 1rem;
                border-width: 1px;
                border-color: Theme.border.transparentize(0.7);
            }

            HorizontalLayout {
                padding: 0.125rem;
                spacing: 0.25rem;
                PlayerToolButton {
                    tooltip: false;
                    icon: Icons.rewind;
                    label: @tr("player.rewindToStart" => "Rewind to start");
                    disabled: Player.transport-disabled;
                    clicked => {
                        Player.reset-to-start();
                    }
                }

                PlayerToolButton {
                    tooltip: false;
                    icon: Icons.step-back;
                    label: @tr("player.stepBack" => "Step back");
                    disabled: Player.transport-disabled;
                    clicked => {
                        Player.step(-1);
                    }
                }

                PlayerToolButton {
                    tooltip: false;
                    icon: Player.playing ? Icons.pause : Icons.play;
                    label: Player.playing ? "Pause" : "Play";
                    variant: Player.playing ? ButtonVariant.secondary : ButtonVariant.default;
                    disabled: Player.transport-disabled;
                    clicked => {
                        if Player.playing {
                            Player.pause();
                        } else {
                            Player.play();
                        }
                    }
                }

                PlayerToolButton {
                    tooltip: false;
                    icon: Icons.step-forward;
                    label: @tr("player.stepForward" => "Step forward");
                    disabled: Player.transport-disabled;
                    clicked => {
                        Player.step(1);
                    }
                }

                PlayerToolButton {
                    tooltip: false;
                    icon: Icons.rewind;
                    label: @tr("player.rewindToEnd" => "Rewind to end");
                    disabled: Player.transport-disabled;
                    transform-rotation: 180deg;
                    clicked => {
                        Player.jump-to-end();
                    }
                }
            }
        }
    }

    HorizontalLayout {
        x: root.width - self.width;
        y: 0px;
        height: root.row-height;
        width: min(12rem, root.side-width);
        spacing: 1rem;
        alignment: end;
        padding-top: root.inset;
        padding-bottom: root.inset;
        if Player.has-video: PlayerToolButton {
            tooltip: false;
            icon: Player.muted ? Icons.volume-x : Icons.volume-2;
            label: Player.muted ? "Unmute video" : "Mute video";
            variant: ButtonVariant.ghost;
            pressed: Player.muted;
            clicked => {
                Player.toggle-mute();
            }
        }
        VerticalLayout {
            alignment: center;
            AppText {
                content: Player.time-label;
                font-size: Theme.text-xs * 1rem;
                font-weight: Theme.font-weight-medium;
                color: Theme.muted-foreground;
            }
        }
    }
}
