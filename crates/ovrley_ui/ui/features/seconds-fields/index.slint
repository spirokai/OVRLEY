import { SecondsInput, SecondsSlot } from "../../components/seconds-input.slint";

// What a keyed seconds field shows; Rust owns its state (`features/seconds_fields.rs`).
export struct SecondsFieldView {
    key: string,
    text: string,
    preview: string,
    error: string,
}

// The keyed seconds fields of the import dialog, the video drawer and the video panel. Each call
// names its field by key.
export global SecondsFields {
    callback edited(key: string, text: string) -> bool;
    callback key(key: string, text: string, alt: bool, control: bool, shift: bool, meta: bool) -> bool;
    callback key-up(key: string, text: string) -> bool;
    callback blurred(key: string);
    callback step(key: string, direction: int);
    // The placement slot's reset clears the draft; the caller runs the reset action.
    callback clear(key: string);
}

// A `SecondsInput` bound to a keyed field.
export component FieldSecondsInput inherits SecondsInput {
    in property <SecondsFieldView> field;
    text: root.field.text;
    preview: root.field.preview;
    error: root.field.error;
    edited(text) => {
        SecondsFields.edited(root.field.key, text)
    }
    key(text, alt, control, shift, meta) => {
        SecondsFields.key(root.field.key, text, alt, control, shift, meta)
    }
    key-up(text) => {
        SecondsFields.key-up(root.field.key, text)
    }
    blurred => {
        SecondsFields.blurred(root.field.key);
    }
    step(direction) => {
        SecondsFields.step(root.field.key, direction);
    }
}
