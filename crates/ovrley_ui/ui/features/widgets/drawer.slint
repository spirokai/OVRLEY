import { Theme } from "../../theme.slint";
import { AppText } from "../../components/text.slint";
import { Icon } from "../../components/icons.slint";
import { Popover } from "../../components/popup.slint";
import { ShadowSize } from "../../components/surface.slint";
import { ScrollArea } from "../../components/scroll-area.slint";
import { PlacementAlign, PlacementSide } from "../../components/logic.slint";
import { DrawerItemView, DrawerOptionView, WidgetDrawer } from "index.slint";

// A manifest icon: a lucide glyph, or a bundled SVG tinted with `color`.
component ManifestIcon {
    in property <string> glyph;
    in property <image> image;
    in property <length> size;
    in property <color> color;
    width: root.size;
    height: root.size;
    if root.glyph != "": Icon {
        glyph: root.glyph;
        size: root.size;
        color: root.color;
    }
    if root.glyph == "": Image {
        width: root.size;
        height: root.size;
        source: root.image;
        colorize: root.color;
    }
}

component OptionItem inherits Rectangle {
    in property <DrawerOptionView> option;
    callback clicked();

    background: touch.has-hover ? Theme.accent : transparent;
    accessible-role: AccessibleRole.button;
    accessible-label: root.option.label;
    accessible-action-default => {
        root.clicked();
    }
    HorizontalLayout {
        padding-left: 0.4rem;
        padding-right: 0.4rem;
        padding-top: 0.3rem;
        padding-bottom: 0.3rem;
        spacing: 1rem;
        VerticalLayout {
            alignment: center;
            ManifestIcon {
                glyph: root.option.glyph;
                image: root.option.image;
                size: 1.125rem;
                color: touch.has-hover ? Theme.accent-foreground : Theme.muted-foreground;
            }
        }
        AppText {
            horizontal-stretch: 1;
            content: root.option.label;
            uppercase: false;
            font-size: 0.85rem;
            color: touch.has-hover ? Theme.accent-foreground : Theme.foreground;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

// An available item has a 0.375rem `success` triangle in its top right corner.
component WidgetButton inherits Rectangle {
    in property <DrawerItemView> item;
    property <bool> open;
    property <bool> hovered: touch.has-hover || root.open;

    border-radius: Theme.radius-xs * 1rem;
    border-width: 1px;
    border-color: root.hovered ? Theme.accent-border : Theme.border.transparentize(0.3);
    background: root.hovered ? Theme.surface.mix(Theme.surface-accent-soft, 0.7) : Theme.surface;
    clip: true;
    accessible-role: AccessibleRole.button;
    accessible-label: root.item.short-name;
    accessible-action-default => {
        touch.clicked();
    }

    VerticalLayout {
        alignment: center;
        spacing: 0.5rem;
        HorizontalLayout {
            alignment: center;
            ManifestIcon {
                glyph: root.item.glyph;
                image: root.item.image;
                size: 1.25rem;
                color: root.hovered ? Theme.primary : Theme.muted-foreground;
            }
        }
        HorizontalLayout {
            padding-left: 0.125rem;
            padding-right: 0.125rem;
            AppText {
                content: root.item.short-name;
                uppercase: false;
                font-size: 0.7rem;
                line-height: 1.25;
                wrap: word-wrap;
                horizontal-alignment: center;
                color: root.hovered ? Theme.primary : Theme.foreground;
            }
        }
    }
    if root.item.available: Path {
        x: parent.width - self.width;
        y: 0px;
        width: 0.375rem;
        height: 0.375rem;
        viewbox-width: 1;
        viewbox-height: 1;
        commands: "M1 0 L0 0 L1 1 Z";
        fill: Theme.success;
        stroke-width: 0px;
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            if root.item.options.length > 1 {
                root.open = !root.open;
            } else {
                WidgetDrawer.add(root.item.key, 0);
            }
        }
    }
    if root.item.options.length > 1: Rectangle {
        y: 1.5rem;
        Popover {
            open: root.open;
            side: PlacementSide.right;
            align: PlacementAlign.start;
            side-offset: 6.8px - 0.5rem;
            content-width: 13rem;
            content-padding: 0.2rem;
            shadow: ShadowSize.md;
            has-shadow-color: true;
            shadow-color: #000000b3;
            radius: 0px;
            open-changed(open) => {
                root.open = open;
            }
            VerticalLayout {
                spacing: 0.11rem;
                for option[index] in root.item.options: OptionItem {
                    option: option;
                    clicked => {
                        root.open = false;
                        WidgetDrawer.add(root.item.key, index);
                    }
                }
            }
        }
    }
}

export component WidgetButtonGrid inherits ScrollArea {
    VerticalLayout {
        padding-left: 0.5rem;
        padding-right: 0.25rem;
        for group in WidgetDrawer.groups: VerticalLayout {
            padding-bottom: 0.75rem;
            spacing: 0.375rem;
            HorizontalLayout {
                padding-left: 0.25rem;
                padding-right: 0.25rem;
                AppText {
                    content: group.name;
                    font-size: 0.7rem;
                    font-weight: Theme.font-weight-bold;
                    tracking: Theme.tracking-wider;
                    color: Theme.muted-foreground.transparentize(0.4);
                }
            }
            grid := Rectangle {
                property <length> gap: 0.25rem;
                property <length> cell: (self.width - 3 * self.gap) / 4;
                height: ceil(group.items.length / 4) * (self.cell + self.gap) - self.gap;
                for item[index] in group.items: WidgetButton {
                    x: mod(index, 4) * (grid.cell + grid.gap);
                    y: floor(index / 4) * (grid.cell + grid.gap);
                    width: grid.cell;
                    height: grid.cell;
                    item: item;
                }
            }
        }
    }
}
