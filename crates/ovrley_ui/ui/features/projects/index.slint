import { UnsavedAnswer } from "../template-manager/index.slint";

// A project of the startup dialog.
export struct ProjectCardView {
    name: string,
    path: string,
    thumbnail: image,
    has-thumbnail: bool,
}

// A source of the projects drawer.
export struct ProjectSourceView {
    filename: string,
    path: string,
}

// The missing source asked about.
export enum MissingSourceRole { activity, video }

// The one-time notice about an older project.
export enum ProjectNoticeKind { none, format-upgraded, legacy-batch-folder }

// What the project unsaved-changes dialog asks before.
export enum ProjectIntent { new-project, open-project, close-window }

// The projects feature's global (Phase 6A D11), written by `src/features/projects.rs`.
export global Projects {
    // A project operation, an activity import or a quiet video import runs.
    in property <bool> busy;
    // A project loads: the workspace shows the loading overlay.
    in property <bool> loading;
    // The project is saved: Save Project is disabled.
    in property <bool> save-disabled;
    // The canvas badge: shown with unsaved changes; `Modified` is styled apart.
    in property <bool> status-shown;
    in property <bool> status-modified;

    // The projects drawer.
    in property <bool> has-project;
    in property <ProjectSourceView> project;
    in property <bool> has-activity;
    in property <ProjectSourceView> activity;
    in property <[ProjectSourceView]> videos;

    // `StartupProjectsDialog`.
    in property <bool> startup-open;
    in property <bool> startup-opening;
    in property <[ProjectCardView]> startup-projects;

    // `MissingSourceDialog`.
    in property <bool> missing-open;
    in property <MissingSourceRole> missing-role;
    in property <string> missing-file-name;

    // `ProjectNoticeDialog`.
    in property <ProjectNoticeKind> notice;
    in property <string> notice-detail;

    // The project `UnsavedChangesDialog`.
    in property <bool> confirm-open;
    in property <ProjectIntent> confirm-intent;

    callback new-project();
    callback open-project();
    callback save-project();
    callback save-project-as();
    callback startup-dismiss();
    callback startup-new();
    callback startup-open-project(path: string);
    callback locate-source();
    callback load-anyway();
    callback cancel-missing();
    callback close-notice();
    callback answer-confirm(UnsavedAnswer);
}
