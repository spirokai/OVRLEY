import { Choice } from "../components/logic.slint";
import { Theme, WindowMetrics } from "../theme.slint";
import { AppText } from "../components/text.slint";
import { Icon, Icons } from "../components/icons.slint";
import { Button, ButtonVariant } from "../components/button.slint";
import { Dialog, DialogTitle, DialogDescription } from "../components/popup.slint";
import { ScrollArea } from "../components/scroll-area.slint";
import { DashedBorder } from "../components/surface.slint";
import { DialogPanel, UnsavedChangesDialog } from "shell/dialogs.slint";

// How the user answers the unsaved-changes dialog.
export enum UnsavedAnswer { save, discard, cancel }

// The template-manager feature's global, written by `src/features/documents.rs`.
export global TemplateManager {
    // The template select's entries: per resolution group a label and a separator, then the
    // templates, user templates suffixed "(User)".
    in property <[Choice]> choices;
    // The bundled template's id while one is loaded, else empty.
    in property <string> selected;
    // A file source's file name for the empty select; empty shows "Select Template...".
    in property <string> file-name;
    // Save is enabled while the status shows (Draft or Modified).
    in property <bool> can-save;
    // Increments when the select should open (`template.select`, Mod+T).
    in property <int> selector-open-serial;
    // The unsaved-changes dialog for a new template.
    in property <bool> confirm-open;

    callback select-template(string);
    callback new-template();
    callback import-template();
    callback save-template();
    callback answer-confirm(UnsavedAnswer);
}

// A project of the startup dialog.
export struct ProjectCardView {
    name: string,
    path: string,
    thumbnail: image,
    has-thumbnail: bool,
}

// A source of the projects drawer.
export struct ProjectSourceView {
    filename: string,
    path: string,
}

// The missing source asked about.
export enum MissingSourceRole { activity, video }

// The one-time notice about an older project.
export enum ProjectNoticeKind { none, format-upgraded, legacy-batch-folder }

// What the project unsaved-changes dialog asks before.
export enum ProjectIntent { new-project, open-project, close-window }

// The projects feature's global, written by `src/features/documents.rs`.
export global Projects {
    // A project operation, an activity import or a quiet video import runs.
    in property <bool> busy;
    // A project loads: the workspace shows the loading overlay.
    in property <bool> loading;
    // The project is saved: Save Project is disabled.
    in property <bool> save-disabled;
    in property <bool> status-shown;
    in property <bool> status-modified;

    // The projects drawer.
    in property <bool> has-project;
    in property <ProjectSourceView> project;
    in property <bool> has-activity;
    in property <ProjectSourceView> activity;
    in property <[ProjectSourceView]> videos;

    // `StartupProjectsDialog`.
    in property <bool> startup-open;
    in property <bool> startup-opening;
    in property <[ProjectCardView]> startup-projects;

    // `MissingSourceDialog`.
    in property <bool> missing-open;
    in property <MissingSourceRole> missing-role;
    in property <string> missing-file-name;

    // `ProjectNoticeDialog`.
    in property <ProjectNoticeKind> notice;
    in property <string> notice-detail;

    // The project `UnsavedChangesDialog`.
    in property <bool> confirm-open;
    in property <ProjectIntent> confirm-intent;

    callback new-project();
    callback open-project();
    callback save-project();
    callback save-project-as();
    callback startup-dismiss();
    callback startup-new();
    callback startup-open-project(path: string);
    callback locate-source();
    callback load-anyway();
    callback cancel-missing();
    callback close-notice();
    callback answer-confirm(UnsavedAnswer);
}

// New Project's border is dashed and it shows a 4.5rem circle (`foreground` at 10%) with a 3rem
// plus; a project shows its thumbnail, covering, or a 2.5rem FileBox.
component ProjectCard inherits VerticalLayout {
    in property <bool> new-project;
    in property <ProjectCardView> card;
    in property <bool> disabled;
    callback clicked();

    property <bool> hover: touch.has-hover && !root.disabled;
    spacing: 0.5rem;
    opacity: root.disabled ? 0.5 : 1;
    box := Rectangle {
        height: self.width * 9 / 16;
        border-radius: Theme.radius-xs * 1rem;
        property <color> outline: root.hover ? Theme.primary : Theme.foreground.transparentize(0.2);
        border-width: root.new-project ? 0px : 1px;
        border-color: self.outline;
        background: root.hover ? Theme.surface-elevated : Theme.surface;
        clip: true;
        if root.new-project: DashedBorder {
            radius: Theme.radius-xs * 1rem;
            border-color: box.outline;
        }
        if root.new-project: Rectangle {
            width: 4.5rem;
            height: 4.5rem;
            border-radius: self.width / 2;
            background: Theme.foreground.transparentize(root.hover ? 0.85 : 0.9);
            Icon {
                glyph: Icons.plus;
                size: 3rem;
                color: root.hover ? Theme.foreground : Theme.foreground.transparentize(0.3);
            }
        }
        // Inside the border.
        if !root.new-project && root.card.has-thumbnail: Image {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            source: root.card.thumbnail;
            image-fit: cover;
        }
        if !root.new-project && !root.card.has-thumbnail: Icon {
            glyph: Icons.file-box;
            size: 2.5rem;
            color: root.hover ? Theme.primary : Theme.muted-foreground;
        }
        touch := TouchArea {
            mouse-cursor: root.disabled ? MouseCursor.default : MouseCursor.pointer;
            clicked => {
                if !root.disabled {
                    root.clicked();
                }
            }
        }
    }
    AppText {
        content: root.new-project ? @tr("projects.newProject" => "New Project") : root.card.name;
        // A project's name keeps its case.
        uppercase: root.new-project;
        horizontal-alignment: center;
        font-size: Theme.text-sm * 1rem;
        font-weight: Theme.font-weight-medium;
        overflow: elide;
        max-lines: 1;
    }
}

// `StartupProjectsDialog`: at most 56rem wide and 80% of the window high, 1.5rem padding, the scrim
// at 70%. The title, then 1.5rem below a grid of cards at least 12.7575rem wide (`auto-fill`), 1rem
// apart across and 1.5rem down, 30rem to 50rem high, scrolling. Escape or the scrim dismisses it.
export component StartupProjectsDialog {
    property <length> min-card: 12.7575rem;
    property <length> gap-x: 1rem;

    Dialog {
        open: Projects.startup-open;
        scrim: Theme.surface-overlay.transparentize(0.3);
        title: @tr("projects.openAProject" => "Open a project");
        open-changed(open) => {
            if !open {
                Projects.startup-dismiss();
            }
        }
        DialogPanel {
            max-width: 56rem;
            preferred-width: 56rem;
            max-height: WindowMetrics.height * 0.8;
            VerticalLayout {
                padding: 1.5rem;
                spacing: 1.5rem;
                DialogTitle {
                    content: @tr("projects.openAProject" => "Open a project");
                    font-size: Theme.text-sm * 1rem;
                    font-weight: Theme.font-weight-semibold;
                    color: Theme.primary;
                }
                grid := ScrollArea {
                    // As tall as its cards, between 30rem and 50rem.
                    min-height: 30rem;
                    preferred-height: cards.preferred-height;
                    max-height: 50rem;
                    property <int> columns: max(1, Math.floor((self.width + root.gap-x) / (root.min-card + root.gap-x)));
                    property <int> count: Projects.startup-projects.length + 1;
                    cards := VerticalLayout {
                        spacing: 1.5rem;
                        alignment: start;
                        for row in Math.ceil(grid.count / grid.columns): HorizontalLayout {
                            spacing: root.gap-x;
                            // The cards are the row's layout items, so each row is as high as
                            // its cards; the cells past the last project keep the columns even.
                            for column in grid.columns: ProjectCard {
                                property <int> index: row * grid.columns + column;
                                horizontal-stretch: 1;
                                preferred-width: 0px;
                                min-width: 0px;
                                visible: index < grid.count;
                                new-project: index == 0;
                                card: Projects.startup-projects[index - 1];
                                disabled: Projects.startup-opening || index >= grid.count;
                                clicked => {
                                    if self.new-project {
                                        Projects.startup-new();
                                    } else {
                                        Projects.startup-open-project(self.card.path);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// A dialog's file or folder line.
component DetailLine inherits AppText {
    font-size: Theme.text-sm * 1rem;
    font-weight: Theme.font-weight-medium;
    wrap: char-wrap;
}

// `MissingSourceDialog`: at most 32rem wide, 1.5rem padding. Escape or the scrim do nothing: the
// load waits for an answer.
export component MissingSourceDialog {
    property <string> role-label: Projects.missing-role == MissingSourceRole.video ? @tr("projects.video" => "Video") : @tr("projects.activity" => "Activity");
    property <string> title: @tr("projects.sourceNotFound" => "{0} source not found", root.role-label);
    property <string> description: @tr("projects.missingSourceDescription" => "The {0} file does not seem to exist. Locate the moved file or cancel without changing the current session.", root.role-label);

    Dialog {
        open: Projects.missing-open;
        title: root.title;
        description: root.description;
        DialogPanel {
            max-width: 32rem;
            preferred-width: 32rem;
            VerticalLayout {
                padding: 1.5rem;
                DialogTitle {
                    content: root.title;
                    font-size: Theme.text-lg * 1rem;
                    font-weight: Theme.font-weight-bold;
                }
                HorizontalLayout {
                    padding-top: 0.5rem;
                    DialogDescription {
                        content: root.description;
                        font-size: Theme.text-sm * 1rem;
                        color: Theme.muted-foreground;
                    }
                }
                HorizontalLayout {
                    padding-top: 0.75rem;
                    DetailLine {
                        content: Projects.missing-file-name;
                    }
                }
                HorizontalLayout {
                    padding-top: 1.5rem;
                    spacing: 0.5rem;
                    alignment: end;
                    Button {
                        variant: ButtonVariant.ghost;
                        text: @tr("projects.cancel" => "Cancel");
                        clicked => {
                            Projects.cancel-missing();
                        }
                    }
                    Button {
                        variant: ButtonVariant.secondary;
                        text: @tr("projects.loadAnyway" => "Load Anyway");
                        clicked => {
                            Projects.load-anyway();
                        }
                    }
                    Button {
                        text: @tr("projects.locate" => "Locate");
                        clicked => {
                            Projects.locate-source();
                        }
                    }
                }
            }
        }
    }
}

// `ProjectNoticeDialog`: as the missing-source dialog, with the backup or folder path and OK.
// Escape or the scrim close it.
export component ProjectNoticeDialog {
    property <bool> upgraded: Projects.notice == ProjectNoticeKind.format-upgraded;
    property <string> title: root.upgraded ? @tr("projects.formatUpgradedTitle" => "Project saved in the new format") : @tr("projects.legacyBatchFolderTitle" => "Batch video folder not imported");
    property <string> description: root.upgraded
        ? @tr("projects.formatUpgradedDescription" => "Older OVRLEY versions cannot open this project anymore. The original file was kept as a backup:")
        : @tr("projects.legacyBatchFolderDescription" => "This project rendered every video of a folder as a separate file. Import the videos of that folder to render them again:");

    Dialog {
        open: Projects.notice != ProjectNoticeKind.none;
        title: root.title;
        description: root.description;
        open-changed(open) => {
            if !open {
                Projects.close-notice();
            }
        }
        DialogPanel {
            max-width: 32rem;
            preferred-width: 32rem;
            VerticalLayout {
                padding: 1.5rem;
                DialogTitle {
                    content: root.title;
                    font-size: Theme.text-lg * 1rem;
                    font-weight: Theme.font-weight-bold;
                }
                HorizontalLayout {
                    padding-top: 0.5rem;
                    DialogDescription {
                        content: root.description;
                        font-size: Theme.text-sm * 1rem;
                        color: Theme.muted-foreground;
                    }
                }
                HorizontalLayout {
                    padding-top: 0.75rem;
                    DetailLine {
                        content: Projects.notice-detail;
                    }
                }
                HorizontalLayout {
                    padding-top: 1.5rem;
                    alignment: end;
                    Button {
                        text: @tr("projects.ok" => "OK");
                        clicked => {
                            Projects.close-notice();
                        }
                    }
                }
            }
        }
    }
}

// The project `UnsavedChangesDialog`; its texts follow the intent: closing uses the exit wording,
// opening "Unsaved Changes" and "Open Project", a new project "Create New Project".
export component ProjectUnsavedDialog {
    property <ProjectIntent> intent: Projects.confirm-intent;

    UnsavedChangesDialog {
        open: Projects.confirm-open;
        title: root.intent == ProjectIntent.new-project ? @tr("projects.createNewProject" => "Create New Project") : @tr("projects.unsavedChangesTitle" => "Unsaved Changes");
        description: root.intent == ProjectIntent.close-window
            ? @tr("projects.unsavedChangesBeforeExit" => "Your project has unsaved changes. Do you want to save the changes or close without saving?")
            : @tr("projects.unsavedChanges" => "Your project has unsaved changes. Save them or discard them.");
        cancel-label: @tr("projects.cancel" => "Cancel");
        save-label: @tr("app-shell.save" => "Save");
        discard-label: root.intent == ProjectIntent.close-window ? @tr("projects.closeWithoutSaving" => "Close Without Saving")
            : root.intent == ProjectIntent.open-project ? @tr("toolbar.openProject" => "Open Project")
            : @tr("projects.newProject" => "New Project");
        cancel => {
            Projects.answer-confirm(UnsavedAnswer.cancel);
        }
        save => {
            Projects.answer-confirm(UnsavedAnswer.save);
        }
        discard => {
            Projects.answer-confirm(UnsavedAnswer.discard);
        }
    }
}
