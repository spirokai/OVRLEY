import { Theme } from "../../theme.slint";
import { AppText } from "../../components/text.slint";
import { Icons } from "../../components/icons.slint";
import { Button, ButtonVariant, ButtonSize } from "../../components/button.slint";
import { SimpleTooltip } from "../../components/tooltip.slint";
import { Shadow, ShadowSize } from "../../components/surface.slint";
import { DrawerTool, Toolbar } from "index.slint";
import { ActivityDrawer } from "activity.slint";
import { VideoDrawer } from "videos.slint";
import { ProjectsDrawer } from "projects.slint";
import { AppShell } from "../shell/index.slint";
import { VideoSyncDrawer } from "../sync/drawer.slint";
import { WidgetButtonGrid } from "../widgets/drawer.slint";

// The rail's tools: label and icon per `DrawerTool`.
component RailButton {
    in property <DrawerTool> tool;
    in property <bool> selected;
    callback clicked();

    property <string> label: root.tool == DrawerTool.projects ? @tr("toolbar.projects" => "Projects")
        : root.tool == DrawerTool.activity ? @tr("toolbar.activity" => "Activity")
        : root.tool == DrawerTool.video ? @tr("toolbar.video" => "Video")
        : root.tool == DrawerTool.video-sync ? @tr("toolbar.videoSync" => "Sync Doctor")
        : @tr("toolbar.widgets" => "Widgets");
    property <string> glyph: root.tool == DrawerTool.projects ? Icons.folder-kanban
        : root.tool == DrawerTool.activity ? Icons.activity
        : root.tool == DrawerTool.video ? Icons.film
        : root.tool == DrawerTool.video-sync ? Icons.rotate-cw-clock
        : Icons.blocks;

    SimpleTooltip {
        content: root.label;
        side: right;
        Button {
            variant: root.selected ? ButtonVariant.default : ButtonVariant.ghost;
            size: ButtonSize.icon;
            icon: root.glyph;
            icon-size: 1rem;
            pressed: root.selected;
            accessible-label: root.label;
            clicked => {
                root.clicked();
            }
        }
    }
}

// `VerticalToolbar`: the 3rem rail, `card` with a right border, 1rem vertical padding, 0.5rem gaps.
// A tool button uses the `default` variant while its drawer shows; the settings button sits at
// the bottom.
export component VerticalToolbar inherits Rectangle {
    in property <DrawerTool> active-tool;
    in property <bool> drawer-visible;
    callback select-tool(DrawerTool);
    callback open-settings();

    background: Theme.card;
    Rectangle {
        x: parent.width - Theme.hairline;
        width: Theme.hairline;
        background: Theme.border;
    }
    VerticalLayout {
        padding-top: 1rem;
        padding-bottom: 1rem;
        spacing: 0.5rem;
        for tool in [DrawerTool.projects, DrawerTool.activity, DrawerTool.video, DrawerTool.video-sync, DrawerTool.widgets]: HorizontalLayout {
            alignment: center;
            RailButton {
                tool: tool;
                selected: root.drawer-visible && root.active-tool == tool;
                clicked => {
                    root.select-tool(tool);
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
        HorizontalLayout {
            alignment: center;
            SimpleTooltip {
                content: @tr("app-shell.settings" => "Settings");
                side: right;
                Button {
                    variant: ButtonVariant.ghost;
                    size: ButtonSize.icon;
                    icon: Icons.settings;
                    icon-size: 1rem;
                    accessible-label: @tr("app-shell.settings" => "Settings");
                    clicked => {
                        root.open-settings();
                    }
                }
            }
        }
    }
}

// `ToolbarDrawerLayout`: the rail, the drawer's allocation (22rem when pinned, its width animated
// over 200 ms), then the children: the workspace and the control panel. The drawer slides in from
// the left over 300 ms above the workspace. While it shows unpinned, a transparent backdrop covers
// everything right of the rail, control panel included, and a press on it dismisses the drawer.
export component ToolbarDrawerLayout {
    in property <DrawerTool> active-tool;
    in property <bool> drawer-visible;
    in property <bool> pinned;
    // The width of the children after the workspace (the control panel), which the blocker leaves.
    in property <length> trailing-width;
    // The video panel in the control panel's place stays usable above the backdrop.
    in property <bool> trailing-above-backdrop;
    callback select-tool(DrawerTool);
    callback set-pinned(bool);
    callback dismiss-overlay();
    callback open-settings();

    property <length> rail-width: 3rem;
    property <length> drawer-width: 22rem;
    property <length> allocation: root.pinned ? root.drawer-width : 0px;
    property <bool> allocation-transitioning;

    animate allocation { duration: Theme.duration-200; easing: ease-in-out; }

    transition-timer := Timer {
        interval: 200ms;
        running: root.allocation-transitioning;
        triggered => {
            root.allocation-transitioning = false;
        }
    }

    HorizontalLayout {
        Rectangle {
            width: root.rail-width;
        }
        Rectangle {
            width: root.allocation;
        }
        @children
    }

    // Below the drawer, above the workspace.
    if root.drawer-visible && !root.pinned: backdrop := TouchArea {
        x: root.rail-width;
        width: root.width - root.rail-width - (root.trailing-above-backdrop ? root.trailing-width : 0px);
        clicked => {
            root.dismiss-overlay();
        }
    }

    if root.allocation-transitioning: blocker := TouchArea {
        x: root.rail-width + root.allocation;
        width: root.width - root.rail-width - root.allocation - root.trailing-width;
    }

    drawer := Rectangle {
        x: root.rail-width + (root.drawer-visible ? 0px : -root.drawer-width);
        width: root.drawer-width;
        height: root.height;
        animate x { duration: Theme.duration-300; easing: ease-in-out; }
        // A still region: drawn from a cached layer, which also slides without being redrawn.
        cache-rendering-hint: true;
        // The drawer's rectangle, for the kept areas of the clip selection.
        function report-area() {
            AppShell.video-drawer-area = { x: self.absolute-position.x, y: self.absolute-position.y, width: self.width, height: self.height };
        }
        init => {
            self.report-area();
        }
        changed x => {
            self.report-area();
        }
        changed height => {
            self.report-area();
        }

        Shadow {
            size: ShadowSize.md;
            has-color: true;
            color: #000000cc;
        }
        Rectangle {
            background: Theme.card;
        }
        Rectangle {
            x: parent.width - Theme.hairline;
            width: Theme.hairline;
            background: Theme.border;
        }
        // Presses inside the drawer do not reach the workspace under it.
        TouchArea { }
        VerticalLayout {
            HorizontalLayout {
                padding-left: 0.75rem;
                padding-right: 0.75rem;
                padding-top: 1rem;
                padding-bottom: 1rem;
                AppText {
                    content: root.active-tool == DrawerTool.projects ? @tr("toolbar.projects" => "Projects")
                        : root.active-tool == DrawerTool.activity ? @tr("toolbar.activity" => "Activity")
                        : root.active-tool == DrawerTool.video ? @tr("toolbar.video" => "Video")
                        : root.active-tool == DrawerTool.video-sync ? @tr("toolbar.videoSync" => "Sync Doctor")
                        : @tr("toolbar.widgets" => "Widgets");
                    uppercase: true;
                    font-size: Theme.text-sm * 1rem;
                    font-weight: Theme.font-weight-extrabold;
                    tracking: 0.025;
                    color: Theme.muted-foreground;
                    horizontal-stretch: 1;
                }
                Button {
                    variant: ButtonVariant.ghost;
                    size: ButtonSize.icon-sm;
                    width: 1.5rem;
                    height: 1.5rem;
                    icon: root.pinned ? Icons.pin-off : Icons.pin;
                    icon-size: 0.875rem;
                    disabled: root.allocation-transitioning;
                    accessible-label: root.pinned ? @tr("toolbar.unpinDrawer" => "Unpin drawer") : @tr("toolbar.pinDrawer" => "Pin drawer");
                    clicked => {
                        root.allocation-transitioning = true;
                        root.set-pinned(!root.pinned);
                    }
                }
            }
            // The drawers.
            if root.active-tool == DrawerTool.activity: ActivityDrawer {
                vertical-stretch: 1;
                has-activity: Toolbar.has-activity;
                file-name: Toolbar.activity-file-name;
                can-delete: Toolbar.can-delete-activity;
                format-label: Toolbar.activity-format;
                metadata: Toolbar.activity-metadata;
                extracted: Toolbar.activity-extracted;
                derived: Toolbar.activity-derived;
                laps: Toolbar.activity-laps;
                load-activity => {
                    Toolbar.load-activity();
                }
                delete-activity => {
                    Toolbar.delete-activity();
                }
                lap-enabled-changed(id, enabled) => {
                    Toolbar.set-lap-enabled(id, enabled);
                }
            }
            if root.active-tool == DrawerTool.video: VideoDrawer {
                vertical-stretch: 1;
            }
            if root.active-tool == DrawerTool.widgets: WidgetButtonGrid {
                vertical-stretch: 1;
            }
            if root.active-tool == DrawerTool.projects: ProjectsDrawer {
                vertical-stretch: 1;
            }
            if root.active-tool == DrawerTool.video-sync: VideoSyncDrawer {
                vertical-stretch: 1;
            }
        }
    }

    // Above the drawer, which slides out from under it.
    VerticalToolbar {
        x: 0px;
        width: root.rail-width;
        height: root.height;
        // A still region: drawn from a cached layer.
        cache-rendering-hint: true;
        active-tool: root.active-tool;
        drawer-visible: root.drawer-visible;
        select-tool(tool) => {
            root.select-tool(tool);
        }
        open-settings => {
            root.open-settings();
        }
    }
}
