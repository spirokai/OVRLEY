import { SecondsFieldView } from "../video/fields.slint";
import { VideoSyncView } from "../sync/index.slint";

// Where a video's creation time comes from.
export enum CreationTimeSource { detected, filename }

// The drawer's tools, in the rail's order.
export enum DrawerTool { projects, activity, video, video-sync, widgets }

// One metadata row of the activity drawer's details.
export struct DrawerRowView {
    label: string,
    value: string,
}

// One detected lap.
export struct ActivityLapView {
    id: int,
    number: string,
    duration: string,
    start: string,
    enabled: bool,
}

export struct JoinControlView {
    // The `TransitionSelect` target of the join.
    target: string,
    type-label: string,
    preview-index: int,
    has-duration: bool,
    duration: SecondsFieldView,
    error: string,
}

// One part of the selected video.
export struct VideoSegmentView {
    key: string,
    range: string,
    included: bool,
    shows-overlay: bool,
    overlay-label: string,
    include-label: string,
    has-join: bool,
    join: JoinControlView,
    removable: bool,
    remove-label: string,
}

// A join out of the selected video into the next one.
export struct VideoExitView {
    next-filename: string,
    join: JoinControlView,
}

export struct SelectedVideoView {
    id: string,
    filename: string,
    path: string,
    missing: bool,
    remove-label: string,
    warnings: [string],
    metadata: [DrawerRowView],
    start: SecondsFieldView,
    creation-source: CreationTimeSource,
    filename-available: bool,
    timezone-shown: bool,
    applies-timezone: bool,
    timezone-disabled: bool,
    segments: [VideoSegmentView],
    exits: [VideoExitView],
}

// A card of the video panel.
export struct VideoCardView {
    id: string,
    filename: string,
    duration: string,
    thumbnail: image,
    has-thumbnail: bool,
    missing: bool,
    selected: bool,
    // In Sync Doctor, the video whose landmarks hold the sync.
    holds-sync: bool,
    remove-label: string,
}

// The toolbar feature's global, written by `src/features/toolbar.rs`.
export global Toolbar {
    in property <DrawerTool> active-tool: DrawerTool.widgets;
    in property <bool> visible;
    in property <bool> pinned;

    in property <bool> has-activity;
    in property <string> activity-file-name;
    in property <bool> can-delete-activity;
    in property <string> activity-format;
    in property <[DrawerRowView]> activity-metadata;
    in property <[string]> activity-extracted;
    in property <[string]> activity-derived;
    in property <[ActivityLapView]> activity-laps;

    // The video drawer and the video panel.
    in property <bool> has-videos;
    in property <bool> has-selected-video;
    in property <SelectedVideoView> selected-video;
    in property <bool> video-panel-shown;
    // Sync Doctor's panel: only the cards, the one whose landmarks hold the sync marked.
    in property <bool> video-panel-in-sync;
    in property <[VideoCardView]> video-cards;
    in property <VideoSyncView> panel-sync;
    in property <string> panel-transition-label;
    in property <int> panel-transition-preview-index: -1;
    in property <SecondsFieldView> panel-transition-duration;
    in property <SecondsFieldView> panel-continuity-threshold;

    callback select-tool(DrawerTool);
    callback load-videos();
    callback remove-video(id: string);
    callback locate-video(id: string);
    callback sync-video(id: string);
    callback set-creation-source(id: string, source: CreationTimeSource);
    callback set-applies-timezone(id: string, applies: bool);
    callback set-segment-included(id: string, key: string, included: bool);
    callback set-segment-overlay(id: string, key: string, shows: bool);
    callback remove-segment(id: string, key: string);
    callback seek-segment(id: string, key: string);
    callback sync-all-videos();
    callback panel-reset-creation-times();
    callback panel-filename-creation-times();
    callback panel-set-utc(utc: bool);
    callback remove-all-videos();
    callback select-card(id: string);
    callback set-pinned(bool);
    callback dismiss-overlay();
    callback load-activity();
    callback delete-activity();
    callback set-lap-enabled(int, bool);
}
