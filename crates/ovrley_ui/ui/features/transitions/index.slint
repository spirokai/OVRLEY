// The transitions feature's preview sprite sheet (D13): one animated frame every tile shares, each
// tile clipping its transition's cell. Written by `src/features/transitions.rs`.
export global TransitionPreviews {
    in property <image> frame;
    // The sheet's grid from the catalogue: cells of `cell-width` × `cell-height` pixels, `columns`
    // per row.
    in property <int> columns;
    in property <int> cell-width;
    in property <int> cell-height;
}

export enum TransitionOptionKind { default, none, xfade }

// One picker option: its value (`default`, `none` or an `xfade` name), its label, and for an
// `xfade` its catalogue index (its cell in the sheet).
export struct TransitionOption {
    kind: TransitionOptionKind,
    value: string,
    label: string,
    index: int,
}

// The open `TransitionSelect` popover (one at a time): its target, the options its filter keeps and
// the selected value. Written by `src/features/transitions.rs`.
export global TransitionSelect {
    in property <string> open-target;
    in property <[TransitionOption]> options;
    in property <string> value;
    in property <string> filter;
    callback open(target: string);
    callback close();
    callback filter-edited(text: string);
    callback chosen(value: string);
}
