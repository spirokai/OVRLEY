import { Theme } from "../../theme/theme.slint";
import { AppText } from "../../components/app-text.slint";
import { Icon, Icons } from "../../components/icons.slint";
import { Button, ButtonVariant } from "../../components/button.slint";
import { Dialog, DialogTitle, DialogDescription } from "../../components/dialog.slint";
import { Progress } from "../../components/progress.slint";
import { DialogPanel } from "../app-shell/dialogs.slint";
import { AppUpdates, UpdatePromptPhase } from "index.slint";

component PromptButton inherits Button {
    variant: ButtonVariant.outline;
    background: Theme.surface-elevated;
    hover-background: Theme.surface-strong;
    border-color: Theme.border.transparentize(0.2);
    text-color: Theme.foreground;
}

// The announcement's and the versions' text: `normal-case text-[0.9rem] font-light leading-5`.
component PromptText inherits AppText {
    uppercase: false;
    font-size: 0.9rem;
    font-weight: Theme.font-weight-normal - 100;
    line-height: 1.25 / 0.9;
    color: Theme.muted-foreground;
}

component VersionText inherits AppText {
    uppercase: false;
    font-size: Theme.text-2xl * 1rem;
    line-height: Theme.text-2xl-line-height;
    font-weight: Theme.font-weight-bold;
}

// `animate-pulse`: a third of the track, its opacity between 1 and 0.5 every 2 s.
component IndeterminateProgress inherits Rectangle {
    height: 0.5rem;
    border-radius: self.height / 2;
    background: Theme.primary.transparentize(0.8);
    Rectangle {
        x: 0px;
        width: parent.width / 3;
        border-radius: self.height / 2;
        background: Theme.primary;
        opacity: 0.75 + 0.25 * Math.cos(Math.mod(animation-tick(), 2s) / 2s * 360deg);
    }
}

// `UpdatePromptDialog`: at most 28rem wide, 1.5rem padding, the scrim at 82%. Escape and the scrim
// dismiss it, except while an update downloads and installs.
export component UpdatePromptDialog {
    property <bool> available: AppUpdates.phase == UpdatePromptPhase.available;
    property <bool> downloading: AppUpdates.phase == UpdatePromptPhase.downloading;
    property <bool> failed: AppUpdates.phase == UpdatePromptPhase.failed;
    property <string> heading: root.failed ? @tr("app-update.updateFailed" => "Update failed")
        : root.downloading ? @tr("app-update.downloadingUpdate" => "Downloading update")
        : @tr("app-update.updateAvailable" => "Update available");
    property <string> failure: @tr("app-update.continueWithInstalledVersion" => "The installed version remains available. You can close this dialog and continue working.");

    Dialog {
        open: AppUpdates.open;
        title: root.heading;
        description: root.failed ? root.failure
            : root.downloading ? AppUpdates.version
            : AppUpdates.announcement-before + " " + AppUpdates.version + " " + AppUpdates.announcement-after;
        open-changed(open) => {
            if !open && !root.downloading {
                AppUpdates.dismiss();
            }
        }
        DialogPanel {
            max-width: 28rem;
            preferred-width: 28rem;
            VerticalLayout {
                padding: 1.5rem;
                HorizontalLayout {
                    spacing: 0.75rem;
                    alignment: start;
                    Icon {
                        glyph: Icons.download;
                        size: 1rem;
                        color: Theme.primary;
                    }
                    DialogTitle {
                        content: root.heading;
                        font-size: Theme.text-sm * 1rem;
                        line-height: Theme.text-sm-line-height;
                        font-weight: Theme.font-weight-semibold;
                    }
                }
                if root.failed: HorizontalLayout {
                    padding-top: 1.5rem;
                    DialogDescription {
                        content: root.failure;
                        uppercase: false;
                        font-size: 0.9rem;
                        font-weight: Theme.font-weight-normal - 100;
                        line-height: 1.25 / 0.9;
                        color: Theme.muted-foreground;
                    }
                }
                if root.available: HorizontalLayout {
                    padding-top: 1.5rem;
                    // A space. The text after the version wraps in its own column.
                    spacing: 0.22rem;
                    PromptText {
                        content: AppUpdates.announcement-before;
                        vertical-alignment: top;
                    }
                    PromptText {
                        content: AppUpdates.version;
                        vertical-alignment: top;
                        font-weight: Theme.font-weight-bold;
                        color: Theme.foreground;
                    }
                    PromptText {
                        content: AppUpdates.announcement-after;
                        vertical-alignment: top;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
                if root.downloading: VerticalLayout {
                    padding-top: 1.5rem;
                    HorizontalLayout {
                        spacing: 1rem;
                        alignment: center;
                        VersionText {
                            content: AppUpdates.current-version;
                        }
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                glyph: Icons.chevrons-right;
                                size: 1.5rem;
                                color: Theme.primary;
                            }
                        }
                        VersionText {
                            content: AppUpdates.version;
                        }
                    }
                    VerticalLayout {
                        padding-top: 0.75rem;
                        spacing: 0.5rem;
                        AppText {
                            content: AppUpdates.determinate ? AppUpdates.progress-label : @tr("app-update.downloadingUpdate" => "Downloading update");
                            horizontal-alignment: right;
                            font-size: Theme.text-xs * 1rem;
                            line-height: Theme.text-xs-line-height;
                            color: Theme.muted-foreground;
                        }
                        if AppUpdates.determinate: Progress {
                            value: AppUpdates.progress;
                            accessible-label: @tr("app-update.updateDownloadProgress" => "Update download progress");
                        }
                        if !AppUpdates.determinate: IndeterminateProgress { }
                    }
                }
                HorizontalLayout {
                    padding-top: 1.5rem;
                    spacing: 0.75rem;
                    alignment: end;
                    if root.failed: PromptButton {
                        text: @tr("app-update.close" => "Close");
                        clicked => {
                            AppUpdates.dismiss();
                        }
                    }
                    if root.available: PromptButton {
                        text: @tr("app-update.later" => "Later");
                        clicked => {
                            AppUpdates.dismiss();
                        }
                    }
                    if root.available: Button {
                        text: @tr("app-update.updateNow" => "Update now");
                        clicked => {
                            AppUpdates.update-now();
                        }
                    }
                }
            }
        }
    }
}
