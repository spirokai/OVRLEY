import { Theme } from "../../theme/theme.slint";
import { AppText } from "../../components/app-text.slint";
import { Icon, Icons } from "../../components/icons.slint";
import { Button, ButtonVariant } from "../../components/button.slint";
import { Progress } from "../../components/progress.slint";
import { ScrollArea } from "../../components/scroll-area.slint";
import { SimpleTooltip } from "../../components/simple-tooltip.slint";
import { RenderVideo, RenderProgressView, RenderQueueRow } from "index.slint";

// `Loader2` with `animate-spin`: one turn a second.
export component SpinningLoader {
    in property <length> size: 1rem;
    in property <color> color: Theme.primary;
    width: root.size;
    height: root.size;
    Rectangle {
        transform-rotation: mod(animation-tick(), 1s) / 1s * 360deg;
        Icon {
            glyph: Icons.loader-circle;
            size: root.size;
            color: root.color;
        }
    }
}

// The 0.741rem bold uppercase label over a `text-lg` mono value (Render FPS, Est. Remaining).
component Stat inherits VerticalLayout {
    in property <string> icon;
    in property <string> label;
    in property <string> value;
    alignment: center;
    HorizontalLayout {
        alignment: center;
        spacing: 0.375rem;
        padding-bottom: 0.25rem;
        Icon {
            glyph: root.icon;
            size: 0.875rem;
            color: Theme.muted-foreground;
        }
        AppText {
            content: root.label;
            uppercase: true;
            font-size: 0.741rem;
            font-weight: Theme.font-weight-bold;
            color: Theme.muted-foreground;
        }
    }
    AppText {
        content: root.value;
        horizontal-alignment: center;
        mono: true;
        font-size: Theme.text-lg * 1rem;
        font-weight: Theme.font-weight-bold;
        color: Theme.foreground;
    }
}

// `RenderProgressPanel`, `space-y-6`: the 4rem icon box (the spinner over the film, or the green
// check), the title (`text-xl` bold) and the line below, the summary at 0.65rem with `/` between
// items, the percent and frames row over the `h-2` bar, Render FPS and Est. Remaining, Cancel
// (ghost) for a single render, and the keep-open note.
export component RenderProgressPanel inherits VerticalLayout {
    in property <RenderProgressView> view;
    spacing: 1.5rem;

    VerticalLayout {
        alignment: center;
        spacing: 1rem;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 4rem;
                height: 4rem;
                border-radius: Theme.radius-sm * 1rem;
                background: Theme.surface-accent-soft;
                if root.view.finished: Icon {
                    glyph: Icons.circle-check;
                    size: 2.5rem;
                    color: #15803d;
                }
                if !root.view.finished: SpinningLoader {
                    size: 2.5rem;
                }
                if !root.view.finished: Icon {
                    glyph: Icons.film;
                    size: 1.25rem;
                    color: Theme.primary.transparentize(0.4);
                }
            }
        }
        VerticalLayout {
            AppText {
                content: root.view.title;
                horizontal-alignment: center;
                font-size: Theme.text-xl * 1rem;
                font-weight: Theme.font-weight-bold;
                color: Theme.foreground;
            }
            if !root.view.finished: AppText {
                content: root.view.subtitle;
                horizontal-alignment: center;
                font-size: Theme.text-sm * 1rem;
                color: Theme.muted-foreground;
            }
            if root.view.summary.length > 0: HorizontalLayout {
                padding-top: 2rem;
                alignment: center;
                spacing: 0.25rem;
                for item[index] in root.view.summary: HorizontalLayout {
                    spacing: 0.25rem;
                    if index > 0: AppText {
                        content: "/";
                        font-size: 0.65rem;
                        color: Theme.muted-foreground.transparentize(0.75);
                    }
                    AppText {
                        content: item;
                        font-size: 0.65rem;
                        color: Theme.muted-foreground.transparentize(0.45);
                    }
                }
            }
        }
    }

    if !root.view.finished: VerticalLayout {
        padding-top: 1.5rem;
        spacing: 0.75rem;
        HorizontalLayout {
            AppText {
                horizontal-stretch: 1;
                content: root.view.percent-text;
                font-size: Theme.text-xs * 1rem;
                font-weight: Theme.font-weight-medium;
                color: Theme.primary;
            }
            AppText {
                content: root.view.frames-text;
                font-size: Theme.text-xs * 1rem;
                font-weight: Theme.font-weight-medium;
                color: Theme.muted-foreground;
            }
        }
        Progress {
            height: 0.5rem;
            value: root.view.percent;
            track-color: Theme.surface-strong;
        }
    }

    if root.view.show-stats: HorizontalLayout {
        padding-top: 0.5rem;
        alignment: center;
        spacing: 1.5rem;
        Stat {
            icon: Icons.activity;
            label: @tr("render-video.renderFps" => "Render FPS");
            value: root.view.fps;
        }
        Stat {
            icon: Icons.timer;
            label: @tr("render-video.estRemaining" => "Est. Remaining");
            value: root.view.remaining;
        }
    }

    if !root.view.finished && root.view.cancel-shown: HorizontalLayout {
        padding-top: 0.5rem;
        alignment: center;
        Button {
            variant: ButtonVariant.ghost;
            text: root.view.cancelling ? @tr("render-video.cancelling" => "Cancelling...") : @tr("render-video.cancel" => "Cancel");
            disabled: root.view.cancelling;
            text-color: Theme.muted-foreground;
            clicked => {
                RenderVideo.cancel-render();
            }
        }
    }

    if !root.view.finished: AppText {
        content: @tr("render-video.keepAppOpen" => "Please keep the application open during rendering");
        horizontal-alignment: center;
        font-italic: true;
        font-size: 0.741rem;
        color: Theme.muted-foreground.transparentize(0.5);
    }
}

// `BatchRenderQueueRow` beside the progress: the name (its tooltip the path), Done, Queued or the
// percent, the row's `h-1.5` bar, its fps and time remaining while rendering, and its note or
// failure (`red-700`).
component QueueRow inherits VerticalLayout {
    in property <RenderQueueRow> item;
    padding: 0.5rem;
    spacing: 0.125rem;
    HorizontalLayout {
        spacing: 0.75rem;
        SimpleTooltip {
            horizontal-stretch: 1;
            content: root.item.tooltip;
            wrap-text: true;
            AppText {
                content: root.item.filename;
                font-size: Theme.text-xs * 1rem;
                font-weight: Theme.font-weight-medium;
                color: Theme.foreground;
                max-lines: 1;
                overflow: elide;
            }
        }
        if root.item.status-text != "": AppText {
            content: root.item.status-text;
            horizontal-alignment: right;
            font-size: 0.7rem;
            font-weight: Theme.font-weight-semibold;
            color: root.item.done ? #15803d : Theme.muted-foreground.transparentize(0.4);
        }
    }
    if root.item.note != "": AppText {
        content: root.item.note;
        font-size: 0.7rem;
        color: Theme.muted-foreground.transparentize(0.4);
    }
    if root.item.error != "": AppText {
        content: root.item.error;
        uppercase: false;
        font-size: 0.7rem;
        color: #b91c1c;
        wrap: char-wrap;
    }
    if root.item.show-progress: HorizontalLayout {
        padding-top: 0.5rem;
        Progress {
            height: 0.375rem;
            value: root.item.progress;
        }
    }
    if root.item.has-stats: HorizontalLayout {
        padding-top: 0.25rem;
        spacing: 0.75rem;
        alignment: start;
        AppText {
            content: root.item.stats-fps;
            font-size: 0.7rem;
            color: Theme.muted-foreground.transparentize(0.4);
        }
        AppText {
            content: root.item.stats-remaining;
            font-size: 0.7rem;
            color: Theme.muted-foreground.transparentize(0.4);
        }
    }
}

// `BatchRenderQueue` beside the progress: the rows in a scrolling box with a faint border.
export component BatchRenderQueue inherits Rectangle {
    border-radius: Theme.radius-sm * 1rem;
    border-width: 1px;
    border-color: Theme.border.transparentize(0.75);
    ScrollArea {
        VerticalLayout {
            padding: 0.5rem;
            spacing: 0.25rem;
            alignment: start;
            for row in RenderVideo.rows: QueueRow {
                item: row;
            }
        }
    }
}
