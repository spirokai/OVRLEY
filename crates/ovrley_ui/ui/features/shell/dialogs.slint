import { Theme, WindowMetrics } from "../../theme.slint";
import { AppText, Kbd } from "../../components/text.slint";
import { Icon, Icons } from "../../components/icons.slint";
import { Button, ButtonVariant, ButtonSize } from "../../components/button.slint";
import { Dialog, DialogTitle, DialogDescription } from "../../components/popup.slint";
import { Shadow, ShadowSize } from "../../components/surface.slint";
import { Select } from "../../components/select.slint";
import { ScrollArea } from "../../components/scroll-area.slint";
import { Switch } from "../../components/switch.slint";
import { HelpTooltip } from "../../components/tooltip.slint";
import { Choice, ChoiceKind, PlacementAlign } from "../../components/logic.slint";
import { Progress } from "../../components/progress.slint";
import { SliderField } from "../widgets/controls.slint";
import { SettingsSection, ShortcutGroupView, DiskCache, DiskCacheView } from "index.slint";

// A dialog panel.
export component DialogPanel inherits Rectangle {
    Shadow {
        size: ShadowSize.xxl;
        radius: Theme.radius-sm * 1rem;
    }
    Rectangle {
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.accent-border.transparentize(0.2);
        border-radius: Theme.radius-sm * 1rem;
    }
    @children
}

// `UnsavedChangesDialog`: at most 28rem wide, 1.5rem padding. Escape or the scrim answers cancel.
// Cancel and Save are outline buttons on `surface`; Discard is the default button.
export component UnsavedChangesDialog {
    in property <bool> open;
    in property <string> title;
    in property <string> description;
    in property <string> discard-label;
    in property <string> cancel-label: "Cancel";
    in property <string> save-label: "Save";
    callback cancel();
    callback save();
    callback discard();

    Dialog {
        open: root.open;
        title: root.title;
        description: root.description;
        open-changed(open) => {
            if !open {
                root.cancel();
            }
        }
        DialogPanel {
            max-width: 28rem;
            preferred-width: 28rem;
            VerticalLayout {
                padding: 1.5rem;
                spacing: 0px;
                HorizontalLayout {
                    spacing: 1rem;
                    alignment: start;
                    Icon {
                        glyph: Icons.file-plus-2;
                        size: 1rem;
                        color: Theme.primary;
                    }
                    DialogTitle {
                        content: root.title;
                        font-size: Theme.text-sm * 1rem;
                        font-weight: Theme.font-weight-semibold;
                    }
                }
                HorizontalLayout {
                    padding-top: 0.5rem;
                    padding-bottom: 0.5rem;
                    DialogDescription {
                        content: root.description;
                        font-size: Theme.text-xs * 1rem;
                        line-height: 1.25 / 0.75;
                        color: Theme.muted-foreground;
                    }
                }
                HorizontalLayout {
                    padding-top: 1.5rem;
                    spacing: 0.75rem;
                    alignment: end;
                    Button {
                        variant: ButtonVariant.outline;
                        text: root.cancel-label;
                        background: Theme.surface;
                        hover-background: Theme.surface-elevated;
                        border-color: Theme.border.transparentize(0.3);
                        text-color: Theme.foreground;
                        clicked => {
                            root.cancel();
                        }
                    }
                    Button {
                        variant: ButtonVariant.outline;
                        text: root.save-label;
                        background: Theme.surface;
                        hover-background: Theme.surface-elevated;
                        border-color: Theme.border.transparentize(0.3);
                        text-color: Theme.foreground;
                        clicked => {
                            root.save();
                        }
                    }
                    Button {
                        text: root.discard-label;
                        clicked => {
                            root.discard();
                        }
                    }
                }
            }
        }
    }
}

// A labelled row of the General panel: the label on the left, the control on the right.
component SettingsRow inherits HorizontalLayout {
    in property <string> label;
    spacing: 1.5rem;
    AppText {
        content: root.label;
        font-size: Theme.text-sm * 1rem;
        horizontal-stretch: 1;
    }
    @children
}

// A disk cache row: its usage, Clear cache and the size limit slider.
component DiskCacheSettings inherits VerticalLayout {
    in property <string> title;
    in property <string> help;
    in property <DiskCacheView> cache;
    callback draft(mib: float);
    callback commit(mib: float);
    callback clear();

    spacing: 1rem;
    Rectangle {
        height: 1px;
        background: Theme.border.transparentize(0.4);
    }
    HorizontalLayout {
        spacing: 1.5rem;
        VerticalLayout {
            spacing: 0.5rem;
            horizontal-stretch: 1;
            alignment: center;
            AppText {
                content: root.title;
                uppercase: false;
                font-size: Theme.text-sm * 1rem;
                color: Theme.foreground;
            }
            HorizontalLayout {
                spacing: 0.375rem;
                alignment: start;
                AppText {
                    content: @tr("app-shell.mapTileCacheUsage" => "{0} of {1} used", root.cache.used, root.cache.limit);
                    uppercase: false;
                    font-size: Theme.text-xs * 1rem;
                    color: Theme.muted-foreground;
                    vertical-alignment: center;
                }
                HelpTooltip {
                    content: root.help;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                variant: ButtonVariant.outline;
                size: ButtonSize.sm;
                text: @tr("app-shell.clearMapTileCache" => "Clear cache");
                disabled: root.cache.clear-disabled;
                clicked => {
                    root.clear();
                }
            }
        }
    }
    Progress {
        height: 0.25rem;
        radius: Theme.radius-xs * 1rem;
        value: root.cache.used-percent;
        track-color: Theme.surface-strong;
        indicator-color: Theme.muted-foreground;
    }
    SliderField {
        label: @tr("app-shell.mapTileCacheLimit" => "Cache size");
        editable: false;
        value: root.cache.value-mib;
        minimum: root.cache.min-mib;
        maximum: root.cache.max-mib;
        step: root.cache.step-mib;
        value-display: root.cache.value-display;
        value-changed(value) => {
            root.draft(value);
        }
        value-committed(value) => {
            root.commit(value);
        }
    }
}

// `GeneralSettingsPanel`: the language and unit system selects, whether agents may edit, and the
// map tile and filmstrip caches once their usage has loaded.
component GeneralSettingsPanel {
    in property <string> language;
    in property <[Choice]> languages;
    in property <string> unit-system;
    in property <bool> allow-agent-edits;
    in property <DiskCacheView> map-tile-cache;
    in property <DiskCacheView> filmstrip-cache;
    callback change-language(string);
    callback change-unit-system(string);
    callback set-allow-agent-edits(bool);
    callback disk-caches-opened();
    callback disk-cache-draft(cache: DiskCache, mib: float);
    callback disk-cache-commit(cache: DiskCache, mib: float);
    callback disk-cache-clear(cache: DiskCache);

    init => {
        root.disk-caches-opened();
    }

    ScrollArea {
        width: 100%;
        height: 100%;
        VerticalLayout {
            padding-left: 1.5rem;
            padding-right: 1.5rem;
            padding-top: 1rem;
            padding-bottom: 1rem;
            spacing: 1rem;
            alignment: start;
            SettingsRow {
                label: @tr("app-shell.language" => "Language");
                Select {
                    width: 11rem;
                    height: 2rem;
                    items: root.languages;
                    value: root.language;
                    align: PlacementAlign.end;
                    font-size: Theme.text-xs * 1rem;
                    accessible-label: @tr("app-shell.language" => "Language");
                    value-changed(value) => {
                        root.change-language(value);
                    }
                }
            }
            SettingsRow {
                label: @tr("app-shell.unitSystem" => "Units");
                Select {
                    width: 11rem;
                    height: 2rem;
                    items: [
                        { kind: ChoiceKind.item, value: "metric", label: @tr("app-shell.unitSystems.metric" => "Metric") },
                        { kind: ChoiceKind.item, value: "imperial", label: @tr("app-shell.unitSystems.imperial" => "Imperial") },
                    ];
                    value: root.unit-system;
                    align: PlacementAlign.end;
                    font-size: Theme.text-xs * 1rem;
                    accessible-label: @tr("app-shell.unitSystem" => "Units");
                    value-changed(value) => {
                        root.change-unit-system(value);
                    }
                }
            }
            HorizontalLayout {
                spacing: 1.5rem;
                HorizontalLayout {
                    spacing: 0.5rem;
                    alignment: start;
                    horizontal-stretch: 1;
                    AppText {
                        content: @tr("app-shell.allowAgentEdits" => "Allow agent edits");
                        font-size: Theme.text-sm * 1rem;
                    }
                    HelpTooltip {
                        content: @tr("app-shell.allowAgentEditsHelp" => "Lets an AI agent connected over MCP (ovrley --mcp) change this window, such as the language and the drawers. Turn it off to refuse every agent request.");
                    }
                }
                Switch {
                    checked: root.allow-agent-edits;
                    accessible-label: @tr("app-shell.allowAgentEdits" => "Allow agent edits");
                    checked-changed(checked) => {
                        root.set-allow-agent-edits(checked);
                    }
                }
            }
            if root.map-tile-cache.shown: DiskCacheSettings {
                title: @tr("app-shell.mapTileCache" => "Map tile cache");
                help: @tr("app-shell.mapTileCacheHelp" => "Map tiles downloaded for previews and renders are kept on disk so maps load faster and work offline. When the cache is full, the least recently used tiles are removed first.");
                cache: root.map-tile-cache;
                draft(mib) => {
                    root.disk-cache-draft(DiskCache.map-tiles, mib);
                }
                commit(mib) => {
                    root.disk-cache-commit(DiskCache.map-tiles, mib);
                }
                clear => {
                    root.disk-cache-clear(DiskCache.map-tiles);
                }
            }
            if root.filmstrip-cache.shown: DiskCacheSettings {
                title: @tr("app-shell.filmstripCache" => "Filmstrip cache");
                help: @tr("app-shell.filmstripCacheHelp" => "The timeline's video thumbnails are kept on disk so they show at once when a project opens again. When the cache is full, the least recently used filmstrips are removed first.");
                cache: root.filmstrip-cache;
                draft(mib) => {
                    root.disk-cache-draft(DiskCache.filmstrips, mib);
                }
                commit(mib) => {
                    root.disk-cache-commit(DiskCache.filmstrips, mib);
                }
                clear => {
                    root.disk-cache-clear(DiskCache.filmstrips);
                }
            }
        }
    }
}

// `KeyboardShortcutsPanel`: an intro paragraph, then under a top border the groups, 2rem apart,
// each row on a two-column grid (16rem and the rest, 2rem apart).
component KeyboardShortcutsPanel {
    in property <[ShortcutGroupView]> groups;

    VerticalLayout {
        HorizontalLayout {
            padding-left: 1.5rem;
            padding-right: 1.5rem;
            padding-top: 1rem;
            padding-bottom: 0.75rem;
            AppText {
                content: @tr("app-shell.keyboardShortcutsDescription" => "You can use the following keyboard shortcuts to improve your workflow:");
                uppercase: false;
                font-size: 0.9rem;
                font-weight: 300;
                wrap: word-wrap;
            }
        }
        Rectangle {
            height: Theme.hairline;
            background: Theme.border.transparentize(0.4);
        }
        ScrollArea {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 1.5rem;
                padding-right: 1.5rem;
                padding-top: 1rem;
                padding-bottom: 1rem;
                spacing: 2rem;
                for group in root.groups: VerticalLayout {
                    spacing: 0.75rem;
                    AppText {
                        content: group.name;
                        uppercase: true;
                        font-size: 1rem;
                        font-weight: Theme.font-weight-extrabold;
                        color: Theme.primary;
                    }
                    VerticalLayout {
                        spacing: 0.5rem;
                        for row in group.rows: HorizontalLayout {
                            spacing: 2rem;
                            HorizontalLayout {
                                width: 16rem;
                                spacing: 0.75rem;
                                alignment: start;
                                for option in row.options: HorizontalLayout {
                                    spacing: 0.25rem;
                                    for modifier[index] in option.modifiers: HorizontalLayout {
                                        spacing: 0.25rem;
                                        Kbd {
                                            text: modifier;
                                        }
                                        if index < option.modifiers.length - 1: AppText {
                                            content: "+";
                                            font-size: 0.9rem;
                                            color: Theme.muted-foreground;
                                        }
                                    }
                                    if option.modifiers.length > 0 && option.keys.length > 0: AppText {
                                        content: "+";
                                        font-size: 0.9rem;
                                        color: Theme.muted-foreground;
                                    }
                                    for key in option.keys: Kbd {
                                        text: key;
                                    }
                                }
                            }
                            AppText {
                                content: row.description;
                                font-size: Theme.text-xs * 1rem;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}

// A section button of the settings navigation: 2.25rem high, the selected one in the `default`
// variant and marked as the current page; the others ghost and muted, `foreground` on hover.
component SectionButton {
    in property <string> label;
    in property <string> glyph;
    in property <bool> selected;
    callback clicked();
    min-height: 2.25rem;
    Button {
        width: root.width;
        variant: root.selected ? ButtonVariant.default : ButtonVariant.ghost;
        height: 2.25rem;
        text: root.label;
        icon: root.glyph;
        icon-size: 1rem;
        alignment: LayoutAlignment.start;
        spacing: 0.75rem;
        padding-x: 0.75rem;
        text-color: root.selected ? Theme.primary-foreground : Theme.muted-foreground;
        hover-text-color: root.selected ? Theme.primary-foreground : Theme.foreground;
        pressed: root.selected;
        clicked => {
            root.clicked();
        }
    }
}

// `SettingsDialog`: 70% of the window height (at most 42.5rem) and at most 56rem wide; a 12rem
// section navigation, a close button, and the section's title row above its panel.
export component SettingsDialog {
    in property <bool> open;
    in property <SettingsSection> section;
    in property <string> language;
    in property <[Choice]> languages;
    in property <string> unit-system;
    in property <[ShortcutGroupView]> shortcut-groups;
    in property <bool> allow-agent-edits;
    in property <DiskCacheView> map-tile-cache;
    in property <DiskCacheView> filmstrip-cache;
    callback close();
    callback select-section(SettingsSection);
    callback change-language(string);
    callback change-unit-system(string);
    callback set-allow-agent-edits(bool);
    callback disk-caches-opened();
    callback disk-cache-draft(cache: DiskCache, mib: float);
    callback disk-cache-commit(cache: DiskCache, mib: float);
    callback disk-cache-clear(cache: DiskCache);

    property <string> section-title: root.section == SettingsSection.settings ? @tr("app-shell.settings" => "Settings") : @tr("app-shell.shortcuts" => "Shortcuts");

    Dialog {
        open: root.open;
        title: root.section-title;
        open-changed(open) => {
            if !open {
                root.close();
            }
        }
        DialogPanel {
            preferred-width: min(56rem, WindowMetrics.width - 2rem);
            max-width: 56rem;
            height: min(42.5rem, WindowMetrics.height * 0.7);
            HorizontalLayout {
                VerticalLayout {
                    width: 12rem;
                    padding: 0.75rem;
                    spacing: 0.25rem;
                    alignment: start;
                    accessible-role: AccessibleRole.list;
                    accessible-label: @tr("app-shell.settings" => "Settings");
                    SectionButton {
                        label: @tr("app-shell.settings" => "Settings");
                        glyph: Icons.settings;
                        selected: root.section == SettingsSection.settings;
                        clicked => {
                            root.select-section(SettingsSection.settings);
                        }
                    }
                    SectionButton {
                        label: @tr("app-shell.shortcuts" => "Shortcuts");
                        glyph: Icons.keyboard;
                        selected: root.section == SettingsSection.shortcuts;
                        clicked => {
                            root.select-section(SettingsSection.shortcuts);
                        }
                    }
                }
                Rectangle {
                    width: Theme.hairline;
                    background: Theme.border.transparentize(0.4);
                }
                VerticalLayout {
                    padding-top: 1.5rem;
                    spacing: 0.5rem;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        padding-left: 1.5rem;
                        padding-right: 4rem;
                        spacing: 0.75rem;
                        Icon {
                            glyph: root.section == SettingsSection.settings ? Icons.settings : Icons.keyboard;
                            size: 1rem;
                            color: Theme.primary;
                        }
                        DialogTitle {
                            content: root.section-title;
                            font-size: Theme.text-sm * 1rem;
                            font-weight: Theme.font-weight-semibold;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }
                    if root.section == SettingsSection.settings: GeneralSettingsPanel {
                        vertical-stretch: 1;
                        language: root.language;
                        languages: root.languages;
                        unit-system: root.unit-system;
                        allow-agent-edits: root.allow-agent-edits;
                        map-tile-cache: root.map-tile-cache;
                        filmstrip-cache: root.filmstrip-cache;
                        disk-caches-opened => {
                            root.disk-caches-opened();
                        }
                        disk-cache-draft(cache, mib) => {
                            root.disk-cache-draft(cache, mib);
                        }
                        disk-cache-commit(cache, mib) => {
                            root.disk-cache-commit(cache, mib);
                        }
                        disk-cache-clear(cache) => {
                            root.disk-cache-clear(cache);
                        }
                        change-language(value) => {
                            root.change-language(value);
                        }
                        change-unit-system(value) => {
                            root.change-unit-system(value);
                        }
                        set-allow-agent-edits(allowed) => {
                            root.set-allow-agent-edits(allowed);
                        }
                    }
                    if root.section == SettingsSection.shortcuts: KeyboardShortcutsPanel {
                        vertical-stretch: 1;
                        groups: root.shortcut-groups;
                    }
                }
            }
            Button {
                x: parent.width - self.width - 1rem;
                y: 1rem;
                variant: ButtonVariant.ghost;
                size: ButtonSize.icon-sm;
                width: 2rem;
                height: 2rem;
                icon: Icons.x;
                icon-size: 1rem;
                text-color: Theme.muted-foreground;
                hover-text-color: Theme.foreground;
                accessible-label: @tr("app-shell.close" => "Close");
                clicked => {
                    root.close();
                }
            }
        }
    }
}
