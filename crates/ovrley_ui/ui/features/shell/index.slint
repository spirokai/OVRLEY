import { Choice, PlacementRect } from "../../components/logic.slint";

// The settings dialog's sections, in the navigation's order.
export enum SettingsSection { settings, shortcuts }

// One way to press a shortcut: modifier labels joined by "+", then the alternative keys.
export struct ShortcutOptionView {
    modifiers: [string],
    keys: [string],
}

export struct ShortcutRowView {
    description: string,
    options: [ShortcutOptionView],
}

export struct ShortcutGroupView {
    name: string,
    rows: [ShortcutRowView],
}

// The app-shell feature's global: the properties its projection writes and the callbacks
// `src/features/shell.rs` binds to dispatches. Only the shell's composition components read it.
// Settings → Map tile cache: shown once its usage has loaded. Sizes are in MiB for the slider; the
// texts are formatted in Rust.
export struct MapTileCacheView {
    shown: bool,
    used: string,
    limit: string,
    used-percent: float,
    value-mib: float,
    min-mib: float,
    max-mib: float,
    step-mib: float,
    value-display: string,
    clear-disabled: bool,
}

export global AppShell {
    // The startup screen shows until the drawer is hydrated and startup work ran.
    in property <bool> show-startup-screen: true;
    // A startup failure once the window exists (a malformed `lng`), shown as a full-window page.
    in property <string> startup-error;
    // macOS, and the window is not fullscreen.
    in property <bool> traffic-light-inset;
    // The window is maximised or fullscreen, written from winit's resize events. It opens maximised.
    in property <bool> window-maximized: true;
    // Windows before 11 (build 22000), whose frameless window has no edge. Set once by the
    // platform layer before the window shows.
    in property <bool> windows-10;
    // A file hovers the window and drops are accepted.
    in property <bool> file-drag-hovering;
    // An import or a template load runs; the workspace shows the loading overlay.
    in property <bool> processing;
    // A quiet import runs.
    in property <bool> importing-video;
    // `v<version>`, the workspace's, read at compile time.
    in property <string> version;

    in property <bool> settings-open;
    in property <SettingsSection> settings-section;
    // The resolved language's code, and the 15 locales with their native labels.
    in property <string> language;
    in property <[Choice]> languages;
    // `metric` or `imperial`.
    in property <string> unit-system: "metric";
    in property <[ShortcutGroupView]> shortcut-groups;

    // The areas whose presses switch the keyboard workspace, in window coordinates: the editor and
    // the control panel select `editor`, the player selects `player`. The window's raw press
    // handler reads them.
    in-out property <PlacementRect> editor-area;
    in-out property <PlacementRect> control-panel-area;
    in-out property <PlacementRect> player-area;

    // MCP: the user allows agent edits; an agent is connected and allowed (the badge).
    in property <bool> allow-agent-edits;
    in property <bool> agent-connected;

    callback open-settings();
    callback close-settings();
    callback select-settings-section(SettingsSection);
    callback change-language(string);
    callback change-unit-system(string);
    callback set-allow-agent-edits(bool);
    in property <MapTileCacheView> map-tile-cache;
    callback map-tile-cache-opened();
    callback map-tile-cache-draft(mib: float);
    callback map-tile-cache-commit(mib: float);
    callback map-tile-cache-clear();
    // The File menu's "Import Activity".
    callback import-activity();
    callback import-videos();

    // Keys no focused control used (`key-pressed`) and the capture phase (`capture-key-pressed`),
    // as the window's root focus scope receives them. They answer whether the key was consumed.
    callback app-key(text: string, alt: bool, control: bool, shift: bool, meta: bool, repeat: bool) -> bool;
    callback capture-key(text: string, alt: bool, control: bool, shift: bool, meta: bool, repeat: bool) -> bool;
    // A key release (a clip nudge commits on it).
    callback app-key-released(text: string, alt: bool, control: bool, shift: bool, meta: bool) -> bool;

    // The window buttons: minimise and maximise change no app state; close goes through the guard.
    callback minimize-window();
    callback toggle-maximize-window();
    callback close-window();
}

// Fills its parent and reports the parent's rectangle in window coordinates when it changes.
export component AreaReport {
    callback report(area: PlacementRect);
    function send() {
        root.report({ x: root.absolute-position.x, y: root.absolute-position.y, width: root.width, height: root.height });
    }
    width: 100%;
    height: 100%;
    init => {
        root.send();
    }
    changed width => {
        root.send();
    }
    changed height => {
        root.send();
    }
    changed absolute-position => {
        root.send();
    }
}

export enum UpdatePromptPhase { hidden, available, downloading, failed }

// The app-update feature's global, written by `src/features/shell.rs`.
export global AppUpdates {
    in property <UpdatePromptPhase> phase;
    out property <bool> open: self.phase != UpdatePromptPhase.hidden;
    in property <string> current-version;
    in property <string> version;
    // The announcement's text before and after the version.
    in property <string> announcement-before;
    in property <string> announcement-after;
    in property <bool> determinate;
    in property <float> progress;
    in property <string> progress-label;
    callback update-now();
    callback dismiss();
}

// The undo-redo feature's global, written by `src/features/shell.rs`.
export global UndoRedo {
    in property <bool> can-undo;
    in property <bool> can-redo;
    callback undo();
    callback redo();
}
