import { Theme } from "../theme/theme.slint";
import { FluidWindow } from "../theme/fluid-window.slint";
import { AppText } from "../components/app-text.slint";
import { Icon, Icons } from "../components/icons.slint";
import { ScrollArea } from "../components/scroll-area.slint";
import { Checkerboard } from "../components/checkerboard.slint";
import { Separator } from "../components/separator.slint";
import { Label } from "../components/label.slint";
import { Kbd, KbdGroup } from "../components/kbd.slint";
import { Badge, BadgeVariant } from "../components/badge.slint";
import { Alert, AlertTitle, AlertDescription, AlertVariant } from "../components/alert.slint";
import { Button, ButtonVariant, ButtonSize } from "../components/button.slint";
import { ButtonGroup, ButtonGroupVertical, ButtonGroupText, ButtonGroupSeparator } from "../components/button-group.slint";
import { GroupPosition } from "../components/group-surface.slint";
import { Toggle, ToggleVariant, ToggleSize } from "../components/toggle.slint";
import { Input, InputVariant } from "../components/input.slint";
import { Switch, SwitchVariant } from "../components/switch.slint";
import { Progress } from "../components/progress.slint";
import { Slider } from "../components/slider.slint";
import { SectionHeading, SectionHeadingVariant } from "../components/section-heading.slint";
import { TabsList, TabsContent, TabsListVariant, TabsTriggerVariant } from "../components/tabs.slint";
import { Choice } from "../components/logic.slint";
import { ToggleGroup, ToggleGroupType, ToggleGroupSize } from "../components/toggle-group.slint";
import { AccordionItem, AccordionTrigger, AccordionContent } from "../components/accordion.slint";
import { BlurInput } from "../components/blur-input.slint";
import { InlineNumberInput } from "../components/inline-number-input.slint";
import { SimpleTooltip } from "../components/simple-tooltip.slint";
import { HelpTooltip } from "../components/help-tooltip.slint";
import { Popover, PopoverHeader, PopoverTitle, PopoverDescription } from "../components/popover.slint";
import { Dialog, DialogTitle, DialogDescription } from "../components/dialog.slint";
import { Select, SelectSize, SelectPosition } from "../components/select.slint";
import { FontSelectField } from "../components/font-select-field.slint";
import { HexColorPicker } from "../components/hex-color-picker.slint";
import { GradientPicker } from "../components/gradient-picker.slint";
import { GradientStop } from "../components/logic.slint";
import { UnsavedChangesDialog } from "../features/app-shell/dialogs.slint";
import { LoadingOverlay } from "../features/app-shell/shell-panels.slint";
import { PlacementSide, PlacementAlign } from "../components/logic.slint";

// One section of the showcase: a heading and its demos.
component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 0.75rem;
    SectionHeading {
        title: root.title;
        icon: Icons.blocks;
    }
    @children
}

// A labelled row of demos.
component Row inherits HorizontalLayout {
    in property <string> caption;
    spacing: 0.75rem;
    alignment: start;
    AppText {
        content: root.caption;
        width: 9rem;
        font-size: 0.741rem;
        color: Theme.muted-foreground;
        uppercase: true;
    }
    @children
}

export component ShowcaseWindow inherits FluidWindow {
    title: "OVRLEY components";
    min-width: 1100px;
    min-height: 720px;
    preferred-width: 1280px;
    preferred-height: 860px;

    property <bool> switch-a: true;
    property <bool> switch-b;
    property <float> slider-value: 40;
    property <float> slider-committed: 40;
    property <float> vertical-value: 60;
    property <float> progress-value: 35;
    property <bool> toolbar-pressed: true;
    property <bool> toggle-pressed;
    property <string> tab-default: "one";
    property <string> tab-main: "layers";
    property <string> tab-toolbar: "a";
    property <string> align-value: "left";
    property <[Choice]> style-items: [
        { value: "bold", label: "B", pressed: true },
        { value: "italic", icon: Icons.italic, accessible-label: "Italic" },
        { value: "type", icon: Icons.type, accessible-label: "Type", disabled: true },
    ];
    property <int> open-item: 0;
    property <string> input-text: "Typed text";
    property <string> number-text: "30";
    property <int> clicks;
    property <string> fps: "30";
    property <string> fps-commits: "";
    property <string> width-text: "1920";
    property <float> inline-value: 12.5;
    in-out property <bool> popover-open;
    in-out property <bool> dialog-open;
    in-out property <bool> unsaved-open;
    in-out property <string> unsaved-answer;
    // For the snapshot mode.
    public function open-select() {
        demo-select.open();
    }
    property <string> select-value: "mp4";
    property <string> popper-value;
    property <string> font-value: "Inter";
    property <string> hex-value: "#40e0d0";
    property <string> hex-changes: "";
    in-out property <[GradientStop]> gradient: [{ offset: 0, color: "#ad5013" }, { offset: 1, color: "#40e0d0" }];
    property <int> gradient-commits;
    public function focus-group-input() {
        group-input.focus();
    }
    public function open-hex-picker() {
        demo-hex.open();
    }
    property <[Choice]> format-items: [
        { value: "mp4", label: "MP4 (H.264)" },
        { value: "hevc", label: "MP4 (HEVC)" },
        { kind: separator },
        { kind: label, label: "Alpha", trailing: "Video imported" },
        { value: "prores", label: "ProRes 4444", help: "Trailing help on an item." },
        { value: "png", label: "PNG sequence" },
        { value: "webm", label: "WebM (disabled)", disabled: true, trailing: "Unavailable" },
    ];
    property <[Choice]> recommended-fonts: [
        { value: "Inter", label: "Inter" }, { value: "Bebas Neue", label: "Bebas Neue" }, { value: "Roboto Mono", label: "Roboto Mono" },
        { value: "Oxanium", label: "Oxanium" }, { value: "Teko", label: "Teko" },
    ];
    property <[Choice]> system-fonts: [
        { value: "Arial", label: "Arial" }, { value: "Avenir", label: "Avenir" }, { value: "Baskerville", label: "Baskerville" },
        { value: "Courier", label: "Courier" }, { value: "Futura", label: "Futura" }, { value: "Georgia", label: "Georgia" },
        { value: "Gill Sans", label: "Gill Sans" }, { value: "Helvetica", label: "Helvetica" }, { value: "Menlo", label: "Menlo" },
        { value: "Monaco", label: "Monaco" }, { value: "Optima", label: "Optima" }, { value: "Palatino", label: "Palatino" },
        { value: "Times", label: "Times" }, { value: "Trebuchet", label: "Trebuchet" }, { value: "Verdana", label: "Verdana" },
        { value: "Zapfino", label: "Zapfino" },
    ];
    // Scroll position, set by the showcase example's snapshot mode.
    in-out property <length> scroll-y <=> page.content-y;

    page := ScrollArea {
        width: 100%;
        height: 100%;
        VerticalLayout {
            padding: 2rem;
            spacing: 1.5rem;

            AppText {
                content: "Phase 1 components";
                font-size: Theme.text-2xl * 1rem;
                font-weight: Theme.font-weight-bold;
                uppercase: true;
            }
            AppText {
                content: "Resize the window to see the fluid scaling. Root font size: " + round(1rem / 1px * 10) / 10 + "px";
                color: Theme.muted-foreground;
                uppercase: true;
            }

            Section {
                title: "Type and colour";
                Row {
                    caption: "Weights";
                    AppText { content: "400"; font-weight: 400; }
                    AppText { content: "500"; font-weight: 500; }
                    AppText { content: "600"; font-weight: 600; }
                    AppText { content: "700"; font-weight: 700; }
                    AppText { content: "800"; font-weight: 800; }
                    AppText { content: "Fira Code 400"; mono: true; }
                    AppText { content: "Fira 700"; mono: true; font-weight: 700; }
                }
                Row {
                    caption: "Fallback";
                    AppText { content: "Русский · 日本語 · 한국어 · 中文"; }
                }
                Row {
                    caption: "Surfaces";
                    for c in [Theme.background, Theme.card, Theme.popover, Theme.muted, Theme.surface, Theme.surface-elevated, Theme.surface-strong, Theme.surface-tooltip, Theme.surface-accent-soft, Theme.surface-accent-strong, Theme.surface-highlight, Theme.surface-highlight-soft]: Rectangle {
                        width: 2rem;
                        height: 2rem;
                        background: c;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: Theme.radius-xs * 1rem;
                    }
                }
                Row {
                    caption: "Accents";
                    for c in [Theme.primary, Theme.accent, Theme.ring, Theme.border, Theme.input, Theme.foreground, Theme.muted-foreground, Theme.destructive, Theme.success, Theme.grid-line, Theme.accent-border, Theme.chart-5]: Rectangle {
                        width: 2rem;
                        height: 2rem;
                        background: c;
                        border-radius: Theme.radius-xs * 1rem;
                    }
                }
                Row {
                    caption: "Checkerboard";
                    Checkerboard {
                        width: 16rem;
                        height: 6rem;
                    }
                }
            }

            Section {
                title: "Icons";
                HorizontalLayout {
                    spacing: 0.5rem;
                    alignment: start;
                    for glyph in [Icons.activity, Icons.circle-alert, Icons.bell, Icons.blocks, Icons.check, Icons.chevron-down, Icons.clock, Icons.compass, Icons.copy, Icons.database, Icons.download, Icons.film, Icons.flag, Icons.folder-open, Icons.gauge, Icons.grid-3x3, Icons.heart-pulse, Icons.image, Icons.info, Icons.keyboard, Icons.loader-circle, Icons.map-pin, Icons.mountain, Icons.palette, Icons.pause, Icons.pipette, Icons.play, Icons.plus, Icons.rotate-ccw, Icons.save, Icons.settings, Icons.sparkles, Icons.tags, Icons.timer, Icons.trash-2, Icons.triangle-alert, Icons.video, Icons.x, Icons.zoom-in]: Icon {
                        glyph: glyph;
                        size: 1.25rem;
                    }
                }
            }

            Section {
                title: "Basic";
                Row {
                    caption: "Separator";
                    Separator { width: 12rem; }
                    Separator { orientation: vertical; height: 2rem; }
                }
                Row {
                    caption: "Label";
                    Label { text: "Field label"; clicked => { root.clicks += 1; } }
                    Label { text: "Muted bold"; font-size: 0.667rem; font-weight: 700; color: Theme.muted-foreground; }
                    Label { text: "Disabled"; disabled: true; }
                    AppText { content: "label clicks: " + root.clicks; color: Theme.muted-foreground; }
                }
                Row {
                    caption: "Kbd";
                    KbdGroup {
                        Kbd { text: "Ctrl"; }
                        Kbd { text: "Shift"; }
                        Kbd { text: "Z"; }
                    }
                }
                Row {
                    caption: "Badge";
                    Badge { text: "Default"; }
                    Badge { text: "Secondary"; variant: secondary; }
                    Badge { text: "Destructive"; variant: destructive; }
                    Badge { text: "Outline"; variant: outline; icon: Icons.check; }
                }
                HorizontalLayout {
                    spacing: 1rem;
                    Alert {
                        icon: Icons.info;
                        AlertTitle { content: "Heads up"; }
                        AlertDescription { content: "Default alert with an icon and a description that wraps."; }
                    }
                    Alert {
                        variant: destructive;
                        icon: Icons.triangle-alert;
                        AlertTitle { content: "Render failed"; variant: destructive; }
                        AlertDescription { content: "Destructive alert description."; variant: destructive; }
                    }
                    Alert {
                        AlertTitle { content: "No icon"; }
                        AlertDescription { content: "Without the icon column."; }
                    }
                }
            }

            Section {
                title: "Button";
                Row {
                    caption: "Variants";
                    Button { text: "Default"; clicked => { root.clicks += 1; } }
                    Button { text: "Destructive"; variant: destructive; }
                    Button { text: "Outline"; variant: outline; }
                    Button { text: "Secondary"; variant: secondary; }
                    Button { text: "Ghost"; variant: ghost; }
                    Button { text: "Toolbar"; variant: toolbar; pressed: root.toolbar-pressed; clicked => { root.toolbar-pressed = !root.toolbar-pressed; } }
                    Button { text: "Link"; variant: link; }
                }
                Row {
                    caption: "Sizes";
                    Button { text: "Small"; size: sm; }
                    Button { text: "Default"; icon: Icons.plus; }
                    Button { text: "Large"; size: lg; }
                    Button { icon: Icons.settings; size: icon; variant: outline; accessible-label: "Settings"; }
                    Button { icon: Icons.settings; size: icon-sm; variant: ghost; accessible-label: "Settings"; }
                    Button { icon: Icons.settings; size: icon-lg; variant: secondary; accessible-label: "Settings"; }
                    Button { icon: Icons.move; size: toolbar-icon; variant: toolbar; accessible-label: "Move"; }
                }
                Row {
                    caption: "States";
                    Button { text: "Disabled"; disabled: true; }
                    Button { text: "Disabled outline"; variant: outline; disabled: true; }
                    Button { text: "Invalid"; variant: outline; invalid: true; }
                    Button { text: "Override"; background: Theme.surface-elevated; hover-background: Theme.surface-strong; text-color: Theme.muted-foreground; hover-text-color: Theme.foreground; border-width: 1px; border-color: Theme.border.transparentize(0.2); shadow: xs; }
                }
                Row {
                    caption: "Group";
                    ButtonGroup {
                        Button { text: "Left"; variant: outline; group-position: first; }
                        Button { text: "Middle"; variant: outline; group-position: middle; }
                        Button { text: "Right"; variant: outline; group-position: last; }
                    }
                    ButtonGroup {
                        group-input := Input { text: "Input + button"; group-position: first; width: 12rem; }
                        Button { icon: Icons.copy; size: icon; variant: outline; group-position: last; accessible-label: "Copy"; }
                    }
                    ButtonGroup {
                        ButtonGroupText { text: "Text"; }
                        ButtonGroupSeparator { }
                        Button { text: "After"; variant: secondary; }
                    }
                    ButtonGroupVertical {
                        Button { text: "Top"; size: sm; variant: outline; group-position: first; group-orientation: vertical; }
                        Button { text: "Bottom"; size: sm; variant: outline; group-position: last; group-orientation: vertical; }
                    }
                }
                Row {
                    caption: "Toggle";
                    Toggle { text: "Default"; pressed: root.toggle-pressed; pressed-changed(p) => { root.toggle-pressed = p; } }
                    Toggle { icon: Icons.italic; variant: outline; size: sm; pressed: root.toggle-pressed; pressed-changed(p) => { root.toggle-pressed = p; } }
                    Toggle { text: "Large"; size: lg; }
                    Toggle { text: "Disabled"; disabled: true; }
                }
            }

            Section {
                title: "Inputs";
                Row {
                    caption: "Input";
                    Input { text <=> root.input-text; width: 14rem; }
                    Input { placeholder: "Placeholder"; width: 14rem; }
                    Input { text <=> root.number-text; number: true; width: 8rem; }
                    Input { text: "Read only"; read-only: true; width: 10rem; }
                    Input { text: "Disabled"; disabled: true; width: 10rem; }
                    Input { text: "12.5"; variant: inline; width: 4rem; }
                }
                Row {
                    caption: "Switch";
                    Switch { checked: root.switch-a; checked-changed(c) => { root.switch-a = c; } }
                    Switch { checked: root.switch-b; checked-changed(c) => { root.switch-b = c; } }
                    Switch { checked: true; disabled: true; }
                    Switch { variant: SwitchVariant.status; checked: root.switch-a; checked-changed(c) => { root.switch-a = c; } }
                    Switch { variant: SwitchVariant.status; checked: root.switch-b; checked-changed(c) => { root.switch-b = c; } }
                }
                Row {
                    caption: "Progress";
                    VerticalLayout {
                        alignment: center;
                        Progress { value: root.progress-value; width: 20rem; }
                    }
                    Button { text: "+7"; size: sm; variant: outline; clicked => { root.progress-value = min(100, root.progress-value + 7); } }
                    Button { text: "Reset"; size: sm; variant: outline; clicked => { root.progress-value = 0; } }
                    AppText { content: round(root.progress-value) + "%"; }
                }
                Row {
                    caption: "Slider";
                    Slider {
                        width: 20rem;
                        value: root.slider-value;
                        value-changed(v) => { root.slider-value = v; }
                        value-committed(v) => { root.slider-committed = v; }
                    }
                    AppText { content: "value " + root.slider-value + " · committed " + root.slider-committed; }
                    Slider { width: 10rem; value: 50; disabled: true; }
                    Slider {
                        orientation: vertical;
                        value: root.vertical-value;
                        value-changed(v) => { root.vertical-value = v; }
                    }
                }
            }

            Section {
                title: "Draft inputs";
                Row {
                    caption: "BlurInput";
                    BlurInput {
                        width: 10rem;
                        value: root.fps;
                        number: true;
                        constraints: { has-min: true, min: 1, step: "1" };
                        label: "FPS";
                        changed(v) => { root.fps = v; root.fps-commits += v + " "; }
                    }
                    BlurInput {
                        width: 10rem;
                        value: root.width-text;
                        font-size: Theme.text-xs * 1rem;
                        mono: true;
                        changed(v) => { root.width-text = v; }
                    }
                    Button { text: "FPS ← 60 (upstream)"; size: sm; variant: outline; clicked => { root.fps = "60"; } }
                    Button { text: "FPS ← 24 (upstream)"; size: sm; variant: outline; clicked => { root.fps = "24"; } }
                }
                Row {
                    caption: "Committed";
                    AppText {
                        content: "FPS " + root.fps + " · width " + root.width-text + " · FPS commits: " + root.fps-commits;
                        color: Theme.muted-foreground;
                    }
                }
                Row {
                    caption: "";
                    AppText {
                        content: "A field keeps its draft while focused with an edit; the upstream buttons replace the value otherwise.";
                        color: Theme.muted-foreground;
                    }
                }
                Row {
                    caption: "Inline number";
                    InlineNumberInput {
                        width: 4rem;
                        value: root.inline-value;
                        constraints: { has-min: true, min: 0, has-max: true, max: 100, step: "0.5" };
                        committed(v) => { root.inline-value = v; }
                    }
                    AppText { content: "value " + root.inline-value + " (0–100, step 0.5)"; color: Theme.muted-foreground; }
                }
            }

            Section {
                title: "Overlays";
                Row {
                    caption: "Tooltip";
                    for side[i] in [PlacementSide.top, PlacementSide.right, PlacementSide.bottom, PlacementSide.left]: SimpleTooltip {
                        content: ["Top tooltip", "Right tooltip", "Bottom tooltip", "Left tooltip"][i];
                        side: side;
                        Button { text: ["Top", "Right", "Bottom", "Left"][i]; variant: outline; size: sm; }
                    }
                    SimpleTooltip {
                        content: "Starts aligned";
                        align: start;
                        side: bottom;
                        Button { text: "Start"; variant: outline; size: sm; }
                    }
                    HelpTooltip {
                        content: "Help tooltips open at once, 20rem wide.\nThey honour newlines and wrap long lines of text onto the next line.";
                    }
                }
                Row {
                    caption: "Popover";
                    Rectangle {
                        width: popover-trigger.preferred-width;
                        height: popover-trigger.preferred-height;
                        popover-trigger := Button {
                            text: "Open popover";
                            variant: outline;
                            clicked => { root.popover-open = !root.popover-open; }
                        }
                        Popover {
                            open: root.popover-open;
                            open-changed(o) => { root.popover-open = o; }
                            PopoverHeader {
                                PopoverTitle { content: "Dimensions"; }
                                PopoverDescription { content: "Set the dimensions for the layer."; }
                            }
                        }
                    }
                    Button { text: "Open dialog"; clicked => { root.dialog-open = true; } }
                    Dialog {
                        open: root.dialog-open;
                        title: "Export finished";
                        open-changed(o) => { root.dialog-open = o; }
                        Rectangle {
                            width: 28rem;
                            background: Theme.card;
                            border-width: 1px;
                            border-color: Theme.accent-border.transparentize(0.2);
                            border-radius: Theme.radius-sm * 1rem;
                            VerticalLayout {
                                padding: 1.5rem;
                                spacing: 1rem;
                                DialogTitle { content: "Export finished"; font-weight: 700; }
                                DialogDescription { content: "Escape or a click on the scrim closes this dialog."; color: Theme.muted-foreground; }
                                HorizontalLayout {
                                    alignment: end;
                                    Button { text: "Close"; clicked => { root.dialog-open = false; } }
                                }
                            }
                        }
                    }
                }
                Row {
                    caption: "Select";
                    demo-select := Select {
                        width: 14rem;
                        items: root.format-items;
                        value: root.select-value;
                        value-changed(v) => { root.select-value = v; }
                    }
                    Select {
                        width: 14rem;
                        size: sm;
                        position: popper;
                        items: root.format-items;
                        placeholder: "Pick a format";
                        value: root.popper-value;
                        font-size: Theme.text-xs * 1rem;
                        value-changed(v) => { root.popper-value = v; }
                    }
                    Select { width: 10rem; items: root.format-items; value: "mp4"; disabled: true; }
                    AppText { content: "values: " + root.select-value + ", " + (root.popper-value == "" ? "(none)" : root.popper-value); color: Theme.muted-foreground; }
                }
                Row {
                    caption: "Font select";
                    FontSelectField {
                        width: 14rem;
                        label: "Font";
                        value: root.font-value;
                        recommended-options: root.recommended-fonts;
                        system-options: root.system-fonts;
                        value-changed(v) => { root.font-value = v; }
                    }
                }
            }

            Section {
                title: "Colour";
                Row {
                    caption: "Hex picker";
                    demo-hex := HexColorPicker {
                        width: 14rem;
                        value: root.hex-value;
                        changed(hex) => { root.hex-value = hex; root.hex-changes += hex + " "; }
                    }
                    HexColorPicker { width: 3rem; value: "#ad5013"; show-value: false; }
                    HexColorPicker { width: 10rem; value: "#ffffff"; disabled: true; }
                    AppText { content: "changes: " + root.hex-changes; color: Theme.muted-foreground; }
                }
                Row {
                    caption: "Gradient";
                    GradientPicker {
                        width: 20rem;
                        stops: root.gradient;
                        changed(stops) => { root.gradient = stops; }
                        committed => { root.gradient-commits += 1; }
                    }
                    AppText { content: root.gradient.length + " stops · commits " + root.gradient-commits; color: Theme.muted-foreground; }
                }
            }

            Section {
                title: "Tabs and groups";
                Row {
                    caption: "Tabs default";
                    VerticalLayout {
                        TabsList {
                            items: [{ value: "one", label: "Overview" }, { value: "two", label: "Settings" }, { value: "three", label: "Disabled", disabled: true }];
                            value: root.tab-default;
                            value-changed(v) => { root.tab-default = v; }
                        }
                        TabsContent { value: "one"; active-value: root.tab-default; AppText { content: "Overview content"; } }
                        TabsContent { value: "two"; active-value: root.tab-default; AppText { content: "Settings content"; } }
                    }
                }
                Row {
                    caption: "Tabs main";
                    TabsList {
                        variant: main;
                        trigger-variant: main;
                        items: [{ value: "layers", label: "Layers", icon: Icons.rows-3 }, { value: "widgets", label: "Widgets", icon: Icons.blocks }];
                        value: root.tab-main;
                        value-changed(v) => { root.tab-main = v; }
                    }
                }
                Row {
                    caption: "Tabs toolbar";
                    TabsList {
                        variant: toolbar;
                        trigger-variant: toolbar;
                        items: [{ value: "a", label: "Fit" }, { value: "b", label: "Fill" }, { value: "c", label: "1:1" }];
                        value: root.tab-toolbar;
                        value-changed(v) => { root.tab-toolbar = v; }
                    }
                }
                Row {
                    caption: "Toggle group";
                    ToggleGroup {
                        items: [{ value: "left", icon: Icons.align-left, accessible-label: "Left" }, { value: "center", icon: Icons.align-center, accessible-label: "Center" }, { value: "right", icon: Icons.align-right, accessible-label: "Right" }];
                        value: root.align-value;
                        value-changed(v) => { root.align-value = v; }
                    }
                    AppText { content: "single: \"" + root.align-value + "\""; }
                    ToggleGroup {
                        type: multiple;
                        size: compact;
                        items: root.style-items;
                        item-pressed-changed(value, pressed) => {
                            if value == "bold" { root.style-items[0].pressed = pressed; }
                            if value == "italic" { root.style-items[1].pressed = pressed; }
                        }
                    }
                    ToggleGroup {
                        width: 16rem;
                        stretch: true;
                        item-padding-x: 0.75rem;
                        item-font-size: Theme.text-xs * 1rem;
                        items: [{ value: "km", label: "km/h" }, { value: "mph", label: "mph" }];
                        value: "km";
                    }
                }
            }

            Section {
                title: "Accordion";
                VerticalLayout {
                    width: 24rem;
                    for title[index] in ["Speed", "Heart rate", "Elevation"]: AccordionItem {
                        AccordionTrigger {
                            text: title;
                            open: root.open-item == index;
                            toggled => { root.open-item = root.open-item == index ? -1 : index; }
                        }
                        AccordionContent {
                            open: root.open-item == index;
                            AppText { content: title + " settings would go here."; color: Theme.muted-foreground; }
                        }
                    }
                }
            }

            // Phase 2 shell pieces with no caller yet.
            Section {
                title: "Shell";
                Row {
                    caption: "Unsaved changes dialog";
                    Button { text: "Open"; clicked => { root.unsaved-open = true; } }
                    AppText { content: root.unsaved-answer == "" ? "" : "Answer: " + root.unsaved-answer; color: Theme.muted-foreground; }
                    UnsavedChangesDialog {
                        open: root.unsaved-open;
                        title: "Start a new template?";
                        description: "Your template has unsaved changes. Save them first, discard them, or keep editing.";
                        discard-label: "Discard";
                        cancel => { root.unsaved-open = false; root.unsaved-answer = "cancel"; }
                        save => { root.unsaved-open = false; root.unsaved-answer = "save"; }
                        discard => { root.unsaved-open = false; root.unsaved-answer = "discard"; }
                    }
                }
                Row {
                    caption: "Loading overlay";
                    Rectangle {
                        width: 24rem;
                        height: 10rem;
                        background: Theme.surface-darken;
                        LoadingOverlay { }
                    }
                }
            }
        }
    }
}
