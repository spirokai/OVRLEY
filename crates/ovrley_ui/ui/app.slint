import { Theme } from "theme.slint";
import { FluidWindow, WindowFrame } from "window.slint";
import { AppShell, AreaReport, AppUpdates } from "features/shell/index.slint";
import { AppHeader } from "features/shell/header.slint";
import { ControlPanel, FileDropOverlay, LoadingOverlay, StartupError } from "features/shell/panels.slint";
import { FocusedField } from "components/focus.slint";
import { SettingsDialog, UnsavedChangesDialog } from "features/shell/dialogs.slint";
import { UpdatePromptDialog } from "features/shell/update.slint";
import { TemplateManager, UnsavedAnswer, Projects, ProjectNoticeKind, StartupProjectsDialog, MissingSourceDialog, ProjectNoticeDialog, ProjectUnsavedDialog } from "features/documents.slint";
import { OverlayEditorView } from "features/editor/editor.slint";
import { OverlayPlayer } from "features/player/player.slint";
import { Player } from "features/player/index.slint";
import { CutRemovalDialog } from "features/player/cut-removal.slint";
import { VideoImportDialog } from "features/video/import.slint";
import { VideoImport } from "features/video/index.slint";
import { Toolbar } from "features/toolbar/index.slint";
import { ToolbarDrawerLayout } from "features/toolbar/layout.slint";
import { VideoPanel } from "features/toolbar/panel.slint";
import { RenderVideo } from "features/render/index.slint";
import { RenderVideoDialog, RenderOverwriteDialog, RenderMissingVideosNotice } from "features/render/dialog.slint";

// Window chrome per platform: on macOS the native title bar stays, transparent, over the header;
// elsewhere the window has no frame, draws its own controls, and resizes from Slint's own border.
export component AppWindow inherits FluidWindow {
    title: "OVRLEY";
    min-width: 1100px;
    min-height: 720px;
    preferred-width: 1920px;
    preferred-height: 1080px;
    no-frame: Platform.os != OperatingSystemType.macos;
    resize-border-width: Platform.os == OperatingSystemType.macos ? 0px : 6px;
    // macOS and Windows 11 round and edge a frameless window themselves. Linux draws it square and
    // edgeless, so the app rounds and edges it. Windows 10 draws it square and edgeless too; the app
    // edges it, and the corners stay square: its DX12 swapchain has no alpha to show them through.
    drawn-frame: AppShell.window-maximized ? WindowFrame.none
        : Platform.os == OperatingSystemType.linux ? WindowFrame.rounded
        : AppShell.windows-10 ? WindowFrame.edge
        : WindowFrame.none;

    property <length> control-panel-width: 26.5rem;
    // macOS centres the traffic lights on the header's midline.
    out property <length> header-height: header.height;
    // The header follows the rem and its content, so its height also changes after a resize.
    callback header-height-changed(length);
    changed header-height => {
        root.header-height-changed(self.header-height);
    }

    // The root focus scope. Slint delivers a key to the focused element and bubbles what it rejects
    // to its parents, so `key-pressed` sees only keys no control used. A click on empty space
    // focuses it. It takes the focus back when a dialog closes.
    keys := FocusScope {
        init => {
            self.focus();
        }
        capture-key-pressed(event) => {
            AppShell.capture-key(event.text, event.modifiers.alt, event.modifiers.control, event.modifiers.shift, event.modifiers.meta, event.repeat) ? accept : reject
        }
        key-pressed(event) => {
            AppShell.app-key(event.text, event.modifiers.alt, event.modifiers.control, event.modifiers.shift, event.modifiers.meta, event.repeat) ? accept : reject
        }
        key-released(event) => {
            AppShell.app-key-released(event.text, event.modifiers.alt, event.modifiers.control, event.modifiers.shift, event.modifiers.meta) ? accept : reject
        }

    VerticalLayout {
        header := AppHeader {
            // Skia on wgpu repaints the whole window on every frame, and playback repaints at the
            // preview's frame rate. Regions that stay still draw from a cached layer, which is
            // rasterized again only when something inside it changes.
            cache-rendering-hint: true;
            traffic-light-inset: AppShell.traffic-light-inset;
            version: AppShell.version;
            agent-connected: AppShell.agent-connected;
            template-choices: TemplateManager.choices;
            selected-template: TemplateManager.selected;
            template-file-name: TemplateManager.file-name;
            can-save-template: TemplateManager.can-save;
            template-selector-open-serial: TemplateManager.selector-open-serial;
            import-videos => {
                AppShell.import-videos();
            }
            import-activity => {
                AppShell.import-activity();
            }
            select-template(id) => {
                TemplateManager.select-template(id);
            }
            new-template => {
                TemplateManager.new-template();
            }
            import-template => {
                TemplateManager.import-template();
            }
            save-template => {
                TemplateManager.save-template();
            }
            minimize-window => {
                AppShell.minimize-window();
            }
            toggle-maximize-window => {
                AppShell.toggle-maximize-window();
            }
            close-window => {
                AppShell.close-window();
            }
        }
        ToolbarDrawerLayout {
            vertical-stretch: 1;
            active-tool: Toolbar.active-tool;
            drawer-visible: Toolbar.visible;
            pinned: Toolbar.pinned;
            trailing-width: root.control-panel-width;
            trailing-above-backdrop: Toolbar.video-panel-shown;
            select-tool(tool) => {
                Toolbar.select-tool(tool);
            }
            set-pinned(pinned) => {
                Toolbar.set-pinned(pinned);
            }
            dismiss-overlay => {
                Toolbar.dismiss-overlay();
            }
            open-settings => {
                AppShell.open-settings();
            }

            // The workspace: the editor and, below it, the player. The loading overlay covers it
            // while an import or a template load runs.
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.surface-darken;
                VerticalLayout {
                    OverlayEditorView {
                        vertical-stretch: 1;
                        AreaReport {
                            report(area) => {
                                AppShell.editor-area = area;
                            }
                        }
                    }
                    if Player.visible: OverlayPlayer {
                        AreaReport {
                            report(area) => {
                                AppShell.player-area = area;
                            }
                        }
                    }
                }
                if AppShell.processing || AppShell.importing-video || Projects.loading: LoadingOverlay {
                    label: Projects.loading ? @tr("app.loadingProject" => "Loading project...") : AppShell.importing-video ? @tr("app.importingYourVideo" => "Importing your video...") : @tr("app.processingYourActivity" => "Processing your activity...");
                }
            }
            Rectangle {
                width: root.control-panel-width;
                // A still region: drawn from a cached layer (see `AppHeader`).
                cache-rendering-hint: true;
                background: Theme.card.transparentize(0.4);
                if !Toolbar.video-panel-shown: ControlPanel { }
                if Toolbar.video-panel-shown: VideoPanel {
                    width: parent.width;
                    height: parent.height;
                }
                AreaReport {
                    report(area) => {
                        AppShell.control-panel-area = area;
                    }
                }
            }
        }
    }
    }

    // After a press away from a text field, the window's root scope takes the focus, so keys keep
    // reaching the shortcuts.
    property <int> blur-serial: FocusedField.blur-serial;
    changed blur-serial => {
        keys.focus();
    }

    changed show-settings => {
        if !self.show-settings {
            keys.focus();
        }
    }
    property <bool> show-settings: AppShell.settings-open;

    changed show-template-confirm => {
        if !self.show-template-confirm {
            keys.focus();
        }
    }
    property <bool> show-template-confirm: TemplateManager.confirm-open;

    UnsavedChangesDialog {
        open: TemplateManager.confirm-open;
        title: @tr("template-manager.createNewTemplate" => "Create New Template");
        description: @tr("template-manager.unsavedChanges" => "Your template has unsaved changes. Save them or discard them.");
        cancel-label: @tr("template-manager.cancel" => "Cancel");
        save-label: @tr("template-manager.save" => "Save");
        discard-label: @tr("template-manager.newTemplate" => "New Template");
        cancel => {
            TemplateManager.answer-confirm(UnsavedAnswer.cancel);
        }
        save => {
            TemplateManager.answer-confirm(UnsavedAnswer.save);
        }
        discard => {
            TemplateManager.answer-confirm(UnsavedAnswer.discard);
        }
    }

    // The projects' dialogs.
    ProjectUnsavedDialog { }
    StartupProjectsDialog { }
    MissingSourceDialog { }
    ProjectNoticeDialog { }

    changed project-dialog-open => {
        if !self.project-dialog-open {
            keys.focus();
        }
    }
    property <bool> project-dialog-open: Projects.confirm-open || Projects.startup-open || Projects.missing-open || Projects.notice != ProjectNoticeKind.none;

    UpdatePromptDialog { }

    changed update-open => {
        if !self.update-open {
            keys.focus();
        }
    }
    property <bool> update-open: AppUpdates.open;

    CutRemovalDialog { }

    // The render dialog, its overwrite question and the missing-videos notice.
    RenderVideoDialog { }
    RenderOverwriteDialog { }
    RenderMissingVideosNotice { }

    changed render-dialog-open => {
        if !self.render-dialog-open {
            keys.focus();
        }
    }
    property <bool> render-dialog-open: RenderVideo.open || RenderVideo.overwrite-open || RenderVideo.missing-open;

    VideoImportDialog { }

    changed video-import-open => {
        if !self.video-import-open {
            keys.focus();
        }
    }
    property <bool> video-import-open: VideoImport.open;

    changed cut-removal-open => {
        if !self.cut-removal-open {
            keys.focus();
        }
    }
    property <bool> cut-removal-open: Player.cut-removal-open;

    SettingsDialog {
        open: AppShell.settings-open;
        section: AppShell.settings-section;
        language: AppShell.language;
        languages: AppShell.languages;
        unit-system: AppShell.unit-system;
        shortcut-groups: AppShell.shortcut-groups;
        allow-agent-edits: AppShell.allow-agent-edits;
        map-tile-cache: AppShell.map-tile-cache;
        close => {
            AppShell.close-settings();
        }
        map-tile-cache-opened => {
            AppShell.map-tile-cache-opened();
        }
        map-tile-cache-draft(mib) => {
            AppShell.map-tile-cache-draft(mib);
        }
        map-tile-cache-commit(mib) => {
            AppShell.map-tile-cache-commit(mib);
        }
        map-tile-cache-clear => {
            AppShell.map-tile-cache-clear();
        }
        select-section(section) => {
            AppShell.select-settings-section(section);
        }
        change-language(code) => {
            AppShell.change-language(code);
        }
        change-unit-system(system) => {
            AppShell.change-unit-system(system);
        }
        set-allow-agent-edits(allowed) => {
            AppShell.set-allow-agent-edits(allowed);
        }
    }

    // `!toolbarDrawer.initialized || !startupReady`: the startup screen.
    if AppShell.show-startup-screen && AppShell.startup-error == "": Rectangle {
        background: Theme.background;
        LoadingOverlay {
            label: @tr("app.ovrleyIsStarting" => "OVRLEY is starting...");
        }
    }

    FileDropOverlay {
        shown: AppShell.file-drag-hovering;
    }

    if AppShell.startup-error != "": StartupError {
        message: AppShell.startup-error;
    }
}
