import { FluidWindow } from "../../ui/window.slint";
import { BlurInput } from "../../ui/components/input.slint";
import { Button } from "../../ui/components/button.slint";

// The BlurInput test harness: a field labelled "FPS" whose committed value the test sets, and for
// the press-away blur a second field and a button.
export component BlurInputHarness inherits FluidWindow {
    width: 1100px;
    height: 720px;
    in-out property <string> value: "30";
    in-out property <int> commit-count;
    in-out property <string> second-value: "8";
    in-out property <int> second-commit-count;
    out property <bool> button-focused: probe.has-focus;

    VerticalLayout {
        alignment: start;
        padding: 20px;
        BlurInput {
            label: "FPS";
            value: root.value;
            changed(v) => {
                root.commit-count += 1;
            }
        }
        BlurInput {
            label: "Bitrate";
            value: root.second-value;
            changed(v) => {
                root.second-commit-count += 1;
            }
        }
        HorizontalLayout {
            alignment: start;
            probe := Button {
                text: "Probe";
            }
        }
    }
}
