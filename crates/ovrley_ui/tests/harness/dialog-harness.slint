import { FluidWindow } from "../../ui/window.slint";
import { Button } from "../../ui/components/button.slint";
import { Dialog } from "../../ui/components/popup.slint";
import { SimpleTooltip } from "../../ui/components/tooltip.slint";

// The Dialog test harness: a button behind the dialog and two buttons inside it, the first with a
// tooltip.
export component DialogHarness inherits FluidWindow {
    width: 1100px;
    height: 720px;
    in-out property <bool> open;
    out property <string> last-clicked;

    VerticalLayout {
        alignment: start;
        padding: 20px;
        Button {
            text: "Behind";
            clicked => { root.last-clicked = "behind"; }
        }
    }
    Dialog {
        open: root.open;
        title: "Probe";
        open-changed(o) => { root.open = o; }
        HorizontalLayout {
            spacing: 8px;
            SimpleTooltip {
                content: "First tip";
                Button { text: "First"; clicked => { root.last-clicked = "first"; } }
            }
            Button { text: "Second"; clicked => { root.last-clicked = "second"; } }
        }
    }
}
