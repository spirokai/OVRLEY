{
  "categories": [
    {
      "nameKey": "keyboard-shortcuts.generalCommands",
      "commands": [
        {
          "id": "project.new",
          "display": true,
          "scope": "app",
          "descriptionKey": "keyboard-shortcuts.projectNew",
          "bindings": [{ "key": "n", "modifiers": ["mod"] }]
        },
        {
          "id": "project.open",
          "display": true,
          "scope": "app",
          "descriptionKey": "keyboard-shortcuts.projectOpen",
          "bindings": [{ "key": "o", "modifiers": ["mod"] }]
        },
        {
          "id": "project.save",
          "display": true,
          "scope": "app",
          "descriptionKey": "keyboard-shortcuts.projectSave",
          "bindings": [{ "key": "s", "modifiers": ["mod"] }]
        },
        {
          "id": "project.saveAs",
          "display": true,
          "scope": "app",
          "descriptionKey": "keyboard-shortcuts.projectSaveAs",
          "bindings": [{ "key": "s", "modifiers": ["mod", "shift"] }]
        },
        {
          "id": "template.new",
          "display": true,
          "scope": "app",
          "descriptionKey": "keyboard-shortcuts.templateNew",
          "bindings": [{ "key": "t", "modifiers": ["mod", "shift"] }]
        },
        {
          "id": "template.import",
          "display": true,
          "scope": "app",
          "descriptionKey": "keyboard-shortcuts.templateImport",
          "bindings": [{ "key": "l", "modifiers": ["mod", "shift"] }]
        },
        {
          "id": "template.save",
          "display": true,
          "scope": "app",
          "descriptionKey": "keyboard-shortcuts.templateSave",
          "bindings": [{ "key": "p", "modifiers": ["mod", "shift"] }]
        },
        {
          "id": "activity.import",
          "display": true,
          "scope": "app",
          "descriptionKey": "keyboard-shortcuts.activityImport",
          "bindings": [{ "key": "k", "modifiers": ["mod"] }]
        },
        {
          "id": "video.import",
          "display": true,
          "scope": "app",
          "descriptionKey": "keyboard-shortcuts.videoImport",
          "bindings": [{ "key": "i", "modifiers": ["mod"] }]
        },
        {
          "id": "template.select",
          "display": true,
          "scope": "app",
          "descriptionKey": "keyboard-shortcuts.templateSelect",
          "bindings": [{ "key": "t", "modifiers": ["mod"] }]
        },
        {
          "id": "output.open",
          "display": true,
          "scope": "app",
          "descriptionKey": "keyboard-shortcuts.outputOpen",
          "bindings": [{ "key": "e", "modifiers": ["mod", "shift"] }]
        },
        {
          "id": "history.undo",
          "display": true,
          "scope": "history",
          "descriptionKey": "keyboard-shortcuts.historyUndo",
          "bindings": [{ "key": "z", "modifiers": ["mod"] }]
        },
        {
          "id": "history.redo",
          "display": true,
          "scope": "history",
          "descriptionKey": "keyboard-shortcuts.historyRedo",
          "bindings": [
            { "key": "z", "modifiers": ["mod", "shift"] },
            { "key": "y", "modifiers": ["ctrl"], "display": false }
          ]
        },
        {
          "id": "render.open",
          "display": true,
          "scope": "app",
          "descriptionKey": "keyboard-shortcuts.renderOpen",
          "bindings": [{ "key": "e", "modifiers": ["mod"] }]
        },
        {
          "id": "drawer.toggle",
          "display": true,
          "scope": "app",
          "descriptionKey": "keyboard-shortcuts.drawerToggle",
          "bindings": [{ "key": "w", "modifiers": ["alt"] }]
        },
        {
          "id": "drawer.close",
          "display": true,
          "scope": "drawer",
          "descriptionKey": "keyboard-shortcuts.drawerClose",
          "bindings": [{ "key": "escape", "modifiers": [], "display": false }]
        }
      ]
    },
    {
      "nameKey": "keyboard-shortcuts.widgetEditor",
      "commands": [
        {
          "id": "editor.clearSelection",
          "display": true,
          "scope": "editor",
          "descriptionKey": "keyboard-shortcuts.editorClearSelection",
          "bindings": [{ "key": "escape", "modifiers": [] }]
        },
        {
          "id": "editor.delete",
          "display": true,
          "scope": "editor",
          "descriptionKey": "keyboard-shortcuts.editorDelete",
          "bindings": [
            { "key": "delete", "modifiers": [] },
            { "key": "backspace", "modifiers": [] }
          ]
        },
        {
          "id": "editor.copy",
          "display": true,
          "scope": "editor",
          "descriptionKey": "keyboard-shortcuts.editorCopy",
          "bindings": [{ "key": "c", "modifiers": ["mod"] }]
        },
        {
          "id": "editor.paste",
          "display": true,
          "scope": "editor",
          "descriptionKey": "keyboard-shortcuts.editorPaste",
          "bindings": [{ "key": "v", "modifiers": ["mod"] }]
        },
        {
          "id": "editor.nudge",
          "display": true,
          "scope": "editor",
          "descriptionKey": "keyboard-shortcuts.editorNudge",
          "bindings": [
            { "key": "arrowup", "modifiers": [], "step": 1, "descriptionKey": "keyboard-shortcuts.editorMoveWidgetOnePixel" },
            { "key": "arrowdown", "modifiers": [], "step": 1, "descriptionKey": "keyboard-shortcuts.editorMoveWidgetOnePixel" },
            { "key": "arrowleft", "modifiers": [], "step": 1, "descriptionKey": "keyboard-shortcuts.editorMoveWidgetOnePixel" },
            { "key": "arrowright", "modifiers": [], "step": 1, "descriptionKey": "keyboard-shortcuts.editorMoveWidgetOnePixel" },
            { "key": "arrowup", "modifiers": ["shift"], "step": 10, "descriptionKey": "keyboard-shortcuts.editorMoveWidgetTenPixels" },
            { "key": "arrowdown", "modifiers": ["shift"], "step": 10, "descriptionKey": "keyboard-shortcuts.editorMoveWidgetTenPixels" },
            { "key": "arrowleft", "modifiers": ["shift"], "step": 10, "descriptionKey": "keyboard-shortcuts.editorMoveWidgetTenPixels" },
            { "key": "arrowright", "modifiers": ["shift"], "step": 10, "descriptionKey": "keyboard-shortcuts.editorMoveWidgetTenPixels" }
          ]
        },
        {
          "id": "editor.toggleSnap",
          "display": true,
          "scope": "editor",
          "descriptionKey": "keyboard-shortcuts.editorToggleSnap",
          "bindings": [{ "key": "n", "modifiers": [] }]
        },
        {
          "id": "editor.toggleGrid",
          "display": true,
          "scope": "editor",
          "descriptionKey": "keyboard-shortcuts.editorToggleGrid",
          "bindings": [{ "key": "g", "modifiers": [] }]
        },
        {
          "id": "editor.zoomIn",
          "display": true,
          "scope": "editor",
          "descriptionKey": "keyboard-shortcuts.editorZoomIn",
          "bindings": [
            { "key": "+", "modifiers": ["mod"], "display": true },
            { "key": "+", "modifiers": ["mod", "shift"], "display": false },
            { "key": "=", "modifiers": ["mod"], "display": false },
            { "key": "=", "modifiers": ["mod", "shift"], "display": false }
          ]
        },
        {
          "id": "editor.zoomOut",
          "display": true,
          "scope": "editor",
          "descriptionKey": "keyboard-shortcuts.editorZoomOut",
          "bindings": [{ "key": "-", "modifiers": ["mod"], "display": true }]
        },
        {
          "id": "editor.resetZoom",
          "display": true,
          "scope": "editor",
          "descriptionKey": "keyboard-shortcuts.editorResetZoom",
          "bindings": [{ "key": "0", "modifiers": ["mod"] }]
        },
        {
          "id": "editor.wheelZoom",
          "display": true,
          "scope": "editor",
          "descriptionKey": "keyboard-shortcuts.editorWheelZoom",
          "bindings": [{ "key": "wheel", "modifiers": ["mod"] }]
        },
        {
          "id": "editor.wheelScroll",
          "display": true,
          "scope": "editor",
          "descriptionKey": "keyboard-shortcuts.editorWheelScroll",
          "bindings": [
            { "key": "wheel", "modifiers": [], "displayOnly": true, "descriptionKey": "keyboard-shortcuts.editorScrollCanvasVertically" },
            { "key": "wheel", "modifiers": ["shift"], "descriptionKey": "keyboard-shortcuts.editorScrollCanvasHorizontally" }
          ]
        }
      ]
    },
    {
