          ]
        },
        {
          "id": "player.jumpToEnd",
          "display": true,
          "scope": "player",
          "descriptionKey": "keyboard-shortcuts.playerJumpToEnd",
          "bindings": [
            {
              "key": "end",
              "modifiers": [],
              "display": true,
              "label": "End"
            }
          ]
        },
        {
          "id": "player.toggleMute",
          "display": true,
          "scope": "player",
          "descriptionKey": "keyboard-shortcuts.playerToggleMute",
          "bindings": [{ "key": "m", "modifiers": [] }]
        },
        {
          "id": "export.setIn",
          "display": true,
          "scope": "player",
          "descriptionKey": "keyboard-shortcuts.exportSetIn",
          "bindings": [{ "key": "i", "modifiers": [] }]
        },
        {
          "id": "export.setOut",
          "display": true,
          "scope": "player",
          "descriptionKey": "keyboard-shortcuts.exportSetOut",
          "bindings": [{ "key": "o", "modifiers": [] }]
        },
        {
          "id": "export.clear",
          "display": true,
          "scope": "player",
          "descriptionKey": "keyboard-shortcuts.exportClear",
          "bindings": [{ "key": "x", "modifiers": ["mod"] }]
        },
        {
          "id": "export.goToIn",
          "display": true,
          "scope": "player",
          "descriptionKey": "keyboard-shortcuts.exportGoToIn",
          "bindings": [{ "key": "i", "modifiers": ["alt"] }]
        },
        {
          "id": "export.goToOut",
          "display": true,
          "scope": "player",
          "descriptionKey": "keyboard-shortcuts.exportGoToOut",
          "bindings": [{ "key": "o", "modifiers": ["alt"] }]
        }
      ]
    },
    {
      "nameKey": "keyboard-shortcuts.timelineAndSync",
      "commands": [
        {
          "id": "timeline.fitAll",
          "display": true,
          "scope": "player",
          "descriptionKey": "keyboard-shortcuts.timelineFitAll",
          "bindings": [{ "key": "z", "modifiers": ["shift"] }]
        },
        {
          "id": "timeline.fitMedia",
          "display": true,
          "scope": "player",
          "descriptionKey": "keyboard-shortcuts.timelineFitMedia",
          "bindings": [{ "key": "1", "modifiers": ["alt"] }]
        },
        {
          "id": "timeline.fitActivity",
          "display": true,
          "scope": "player",
          "descriptionKey": "keyboard-shortcuts.timelineFitActivity",
          "bindings": [{ "key": "2", "modifiers": ["alt"] }]
        },
        {
          "id": "timeline.fitVideo",
          "display": true,
          "scope": "player",
          "descriptionKey": "keyboard-shortcuts.timelineFitVideo",
          "bindings": [{ "key": "3", "modifiers": ["alt"] }]
        },
        {
          "id": "timeline.wheelZoom",
          "display": true,
          "scope": "player",
          "descriptionKey": "keyboard-shortcuts.timelineWheelZoom",
          "bindings": [{ "key": "wheel", "modifiers": ["ctrl"] }]
        },
        {
          "id": "timeline.wheelPan",
          "display": true,
          "scope": "player",
          "descriptionKey": "keyboard-shortcuts.timelineWheelPan",
          "bindings": [{ "key": "wheel", "modifiers": [] }]
        },
        {
          "id": "sync.auto",
          "display": true,
          "scope": "app",
          "descriptionKey": "keyboard-shortcuts.syncAuto",
          "bindings": [{ "key": "a", "modifiers": ["mod", "shift"] }]
        },
        {
          "id": "sync.globalNudge",
          "display": true,
          "scope": "player",
          "descriptionKey": "keyboard-shortcuts.syncGlobalNudge",
          "bindings": [
            { "key": "[", "modifiers": [], "seconds": -1 },
            { "key": "]", "modifiers": [], "seconds": 1 }
          ]
        },
        {
          "id": "timelineClip.nudge",
          "display": true,
          "scope": "timeline-clip",
          "descriptionKey": "keyboard-shortcuts.timelineClipNudge",
          "bindings": [
            {
              "key": "arrowleft",
              "modifiers": [],
              "seconds": -0.1,
              "descriptionKey": "keyboard-shortcuts.timelineClipNudgeTenthSecond"
            },
            {
              "key": "arrowright",
              "modifiers": [],
              "seconds": 0.1,
              "descriptionKey": "keyboard-shortcuts.timelineClipNudgeTenthSecond"
            },
            {
              "key": "arrowleft",
              "modifiers": ["shift"],
              "seconds": -1,
              "descriptionKey": "keyboard-shortcuts.timelineClipNudgeSecond"
            },
            {
              "key": "arrowright",
              "modifiers": ["shift"],
              "seconds": 1,
              "descriptionKey": "keyboard-shortcuts.timelineClipNudgeSecond"
            }
          ]
        }
      ]
    }
  ]
}
