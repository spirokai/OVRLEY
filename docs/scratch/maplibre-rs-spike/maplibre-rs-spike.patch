diff --git a/render-tests/src/bin/live.rs b/render-tests/src/bin/live.rs
new file mode 100644
index 0000000..e3ac9d0
--- /dev/null
+++ b/render-tests/src/bin/live.rs
@@ -0,0 +1,114 @@
+//! Throwaway: maplibre-rs as a live multi-tile map: real requests, camera, overzoom, timing.
+//! Usage: live <style.json> <size> <zoom> <pitch_deg> <frames> [png]
+use cgmath::Deg;
+use maplibre::{
+    coords::{LatLon, WorldCoords, Zoom},
+    headless::{create_headless_renderer, map::HeadlessMap, HeadlessPlugin},
+    platform::run_multithreaded,
+    plugin::Plugin,
+    render::{camera::Camera, RenderPlugin},
+    style::Style,
+    vector::{DefaultVectorTransferables, VectorPlugin},
+};
+use std::time::{Duration, Instant};
+
+const PATH: [(f64, f64); 5] = [
+    (47.3769, 8.5395),
+    (47.3745, 8.5392),
+    (47.3722, 8.5388),
+    (47.3712, 8.5365),
+    (47.3690, 8.5350),
+];
+
+fn metres(a: (f64, f64), b: (f64, f64)) -> f64 {
+    ((b.1 - a.1) * 111320.0 * 47.37_f64.to_radians().cos()).hypot((b.0 - a.0) * 110540.0)
+}
+fn at(mut d: f64) -> (f64, f64) {
+    for i in 0..PATH.len() - 1 {
+        let l = metres(PATH[i], PATH[i + 1]);
+        if d <= l || i + 2 == PATH.len() {
+            let k = d / l;
+            return (PATH[i].0 + (PATH[i + 1].0 - PATH[i].0) * k, PATH[i].1 + (PATH[i + 1].1 - PATH[i].1) * k);
+        }
+        d -= l;
+    }
+    PATH[0]
+}
+fn heading(d: f64) -> f64 {
+    let (a, b) = (at((d - 30.0).max(0.0)), at(d + 30.0));
+    ((b.1 - a.1) * 47.37_f64.to_radians().cos()).atan2(b.0 - a.0).to_degrees()
+}
+
+fn main() {
+    let a: Vec<String> = std::env::args().collect();
+    let (style_path, size, zoom, pitch, frames) = (
+        a[1].clone(),
+        a[2].parse::<u32>().unwrap(),
+        a[3].parse::<f64>().unwrap(),
+        a[4].parse::<f64>().unwrap(),
+        a[5].parse::<usize>().unwrap(),
+    );
+    let png = a.get(6).is_some();
+    run_multithreaded(async move {
+        let mut style: Style = if style_path == "default" {
+            Style::default()
+        } else {
+            serde_json::from_str(&std::fs::read_to_string(&style_path).unwrap()).expect("style parse")
+        };
+        if std::env::var("SPIKE_NO_LABELS").is_ok() {
+            style.layers.retain(|layer| layer.type_ != "symbol");
+        }
+        for (i, layer) in style.layers.iter_mut().enumerate() {
+            layer.index = i as u32 + 1;
+        }
+        println!("layers: {}", style.layers.len());
+        let (kernel, renderer) = create_headless_renderer(size, size, None).await;
+        let plugins: Vec<Box<dyn Plugin<_>>> = vec![
+            Box::new(RenderPlugin::default()),
+            Box::new(maplibre::background::BackgroundPlugin::default()),
+            Box::new(VectorPlugin::<DefaultVectorTransferables>::default()),
+            Box::new(maplibre::sdf::SdfPlugin::<DefaultVectorTransferables>::default()),
+            Box::new(HeadlessPlugin::live(png)),
+        ];
+        let mut map = HeadlessMap::new(style, renderer, kernel, plugins).unwrap();
+        let z = Zoom::new(zoom);
+        let place = |map: &mut HeadlessMap, d: f64| {
+            let (lat, lon) = at(d);
+            let world = WorldCoords::from_lat_lon(LatLon::new(lat, lon), z);
+            let view = &mut map.context_mut().view_state;
+            view.update_zoom(z);
+            let mut camera = Camera::new((world.x, world.y), Deg(0.0), Deg(pitch));
+            camera.roll(Deg(-heading(d)));
+            *view.camera_mut() = camera;
+        };
+        // Let tiles arrive and tessellate at the start position.
+        let started = Instant::now();
+        place(&mut map, 5.0);
+        let settle: usize = std::env::var("SPIKE_SETTLE").ok().and_then(|v| v.parse().ok()).unwrap_or(200);
+        for _ in 0..settle {
+            map.run_frame();
+            tokio::time::sleep(Duration::from_millis(25)).await;
+        }
+        println!("settled after {:.1} s", started.elapsed().as_secs_f64());
+        // 30 km/h at 30 fps. Frames cross tile borders on the longer runs.
+        let mut times = Vec::new();
+        for f in 0..frames {
+            place(&mut map, f as f64 * (30.0 / 3.6 / 30.0) + 5.0);
+            let started = Instant::now();
+            map.run_frame();
+            times.push(started.elapsed().as_secs_f64() * 1000.0);
+            if png {
+                // Give tile tasks time to land; PNG runs are for looking, not timing.
+                tokio::time::sleep(Duration::from_millis(40)).await;
+            }
+        }
+        let n = times.len();
+        times.sort_by(f64::total_cmp);
+        println!(
+            "{size} px z{zoom} pitch {pitch}: render + blocking readback median {:.2} ms, p95 {:.2} ms, max {:.2} ms over {n} frames",
+            times[n / 2],
+            times[n * 95 / 100],
+            times[n - 1]
+        );
+    });
+}
