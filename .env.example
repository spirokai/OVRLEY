# Copy to .env.local. Shell environment variables take precedence.
# Native Skia uses prebuilt binaries and needs no source-build tool paths.
EMSDK=C:/tools/emsdk
# Only required when regenerating vendor/skia-wasm, not for bindings builds.
LIBCLANG_PATH=C:/tools/llvm/LLVM/bin
# SDK launchers need Python 3.10+ on PATH. Set this when PATH has an older Python.
PYTHON=C:/tools/emsdk/python/3.13.3_64bit/python.exe
# Optional: use an existing Ninja installation.
# NINJA=C:/tools/ninja/ninja.exe
