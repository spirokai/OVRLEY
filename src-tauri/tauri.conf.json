{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OVRLEY",
  "version": "0.1.0",
  "identifier": "com.ovrley.desktop",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev:frontend",
    "beforeBuildCommand": "pnpm build:frontend && pnpm prepare:packaging"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OVRLEY",
        "width": 1920,
        "height": 1080,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "decorations": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost http://asset.localhost; media-src 'self' asset: https://asset.localhost http://asset.localhost http://127.0.0.1:* http://localhost:*",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../fonts": "fonts",
      "../templates": "templates",
      "../vendor/ffmpeg": "vendor/ffmpeg",
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-libav",
          "gstreamer1.0-plugins-good",
          "libayatana-appindicator3-1",
          "libgtk-3-0",
          "librsvg2-2",
          "libssl3",
          "libwebkit2gtk-4.1-0"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBENUE0NkEyQ0UwMzMyQ0IKUldUTE1nUE9va1phRFF1Q0hvSGZoQW5GOGRkYkwyOEFUblhtV3FmWnh4WFdyaXFNL0VWNjg1b2cK",
      "endpoints": ["https://github.com/spirokai/OVRLEY/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
