import { Theme } from "../theme/theme.slint";
import { Icon, Icons } from "icons.slint";
import { FocusRing } from "focus-ring.slint";
import { SimpleTooltip } from "simple-tooltip.slint";
import { PlacementAlign, PlacementSide } from "logic.slint";

// help-tooltip.jsx: a 0.875rem info icon in a round button with 0.125rem padding, muted and
// `foreground` on hover, with the help cursor and an accessible label. Its tooltip has no delay,
// sits at the bottom start, is 20rem wide, and honours newlines.
export component HelpTooltip {
    in property <string> content;
    // The button's accessible name; defaults to the content.
    in property <string> label: root.content;
    in property <PlacementSide> side: PlacementSide.bottom;
    in property <PlacementAlign> align: PlacementAlign.start;
    in property <length> content-width: 20rem;

    property <length> box: 0.875rem + 0.25rem;
    width: root.box;
    height: root.box;

    tip := SimpleTooltip {
        content: root.content;
        side: root.side;
        align: root.align;
        delay: 0ms;
        content-width: root.content-width;
        mouse-cursor: MouseCursor.help;

        button := Rectangle {
            width: root.box;
            height: root.box;
            border-radius: self.width / 2;
            forward-focus: focus;
            accessible-role: AccessibleRole.button;
            accessible-label: root.label;

            Icon {
                glyph: Icons.info;
                size: 0.875rem;
                color: tip.has-hover ? Theme.foreground : Theme.muted-foreground;
            }
            focus := FocusScope {
                out property <bool> focus-visible;
                focus-on-click: false;
                focus-gained(reason) => {
                    self.focus-visible = reason == FocusReason.tab-navigation;
                }
                focus-lost => {
                    self.focus-visible = false;
                }
            }
            // `focus-visible:outline-2 outline-ring`.
            FocusRing {
                shown: focus.focus-visible;
                ring-width: 2px;
                radius: parent.width / 2;
                ring-color: Theme.ring;
            }
        }
    }
}
