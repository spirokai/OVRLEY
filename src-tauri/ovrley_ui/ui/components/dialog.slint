import { Theme, WindowMetrics } from "../theme/theme.slint";
import { AppText } from "app-text.slint";
import { AlertLayerView } from "alert-layer.slint";

// dialog.jsx: modal over the whole window. The scrim is `surface-overlay` at the caller's opacity
// (today 70% or 82%); the 12px backdrop blur is not available in Slint 1.18 (Q3). The slot is
// centred with 1rem side padding; feature dialogs draw their own panel in it, as today. Escape
// and a scrim click report `open-changed(false)`; focus moves into the content on open. A dialog
// opened later stacks above one opened earlier, which matches today's z-index use (130 over 120).
// `title` and `description` are the dialog's accessible name and description.
export component Dialog {
    in property <bool> open;
    // `surface-overlay/82` by default; callers pass `surface-overlay/70` where they use it.
    in property <color> scrim: Theme.surface-overlay.transparentize(0.18);
    in property <string> title;
    in property <string> description;
    callback open-changed(open: bool);

    changed open => {
        if root.open {
            popup.show();
        } else {
            popup.close();
        }
    }

    width: 0px;
    height: 0px;

    popup := PopupWindow {
        close-policy: PopupClosePolicy.no-auto-close;
        x: -root.absolute-position.x;
        y: -root.absolute-position.y;
        width: WindowMetrics.width;
        height: WindowMetrics.height;

        Rectangle {
            background: root.scrim;
            TouchArea {
                clicked => {
                    root.open-changed(false);
                }
            }
        }
        focus := FocusScope {
            accessible-role: AccessibleRole.groupbox;
            accessible-label: root.title;
            accessible-description: root.description;
            init => {
                self.focus();
            }
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.open-changed(false);
                    return accept;
                }
                reject
            }
            HorizontalLayout {
                padding-left: 1rem;
                padding-right: 1rem;
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    // Clicks on the content do not reach the scrim.
                    TouchArea {
                        min-width: dialog-content.min-width;
                        preferred-width: dialog-content.preferred-width;
                        min-height: dialog-content.min-height;
                        preferred-height: dialog-content.preferred-height;
                        dialog-content := VerticalLayout {
                            @children
                        }
                    }
                }
            }
        }
        // The error alert stays visible and clickable above an open dialog (D12).
        AlertLayerView { }
    }
}

// The dialog's visible title; pass the same text as the dialog's `title`.
export component DialogTitle inherits AppText {
    uppercase: true;
}

// The dialog's visible description; pass the same text as the dialog's `description`.
export component DialogDescription inherits AppText {
    uppercase: true;
    wrap: word-wrap;
}

// A control that closes the dialog. Slint parts cannot reach their dialog, so `clicked` goes to
// the caller, which reports `open-changed(false)` as Radix's `DialogClose` does.
export component DialogClose inherits TouchArea {
    accessible-role: AccessibleRole.button;
    mouse-cursor: MouseCursor.pointer;
}
