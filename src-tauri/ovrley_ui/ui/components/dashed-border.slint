// CSS `border-dashed`: a dashed outline of the parent's rounded box, drawn inside it. Slint
// rectangles draw only solid borders; a path's stroke can be dashed. The view box matches the
// element in pixels, so the stroke and its dashes keep their size.
export component DashedBorder inherits Path {
    in property <length> radius;
    in property <length> border-width: 1px;
    in property <brush> border-color;

    // The stroke is centred on the path, so the path runs half a stroke inside the edge.
    property <float> inset: root.border-width / 2px;
    property <float> r: max(0, root.radius / 1px - root.inset);
    property <float> left: root.inset;
    property <float> top: root.inset;
    property <float> right: root.width / 1px - root.inset;
    property <float> bottom: root.height / 1px - root.inset;

    width: 100%;
    height: 100%;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: root.width / 1px;
    viewbox-height: root.height / 1px;
    fill: transparent;
    stroke: root.border-color;
    stroke-width: root.border-width;
    stroke-dash-array: [4px, 3px];
    commands: "M \{root.left + root.r} \{root.top} "
        + "L \{root.right - root.r} \{root.top} "
        + "A \{root.r} \{root.r} 0 0 1 \{root.right} \{root.top + root.r} "
        + "L \{root.right} \{root.bottom - root.r} "
        + "A \{root.r} \{root.r} 0 0 1 \{root.right - root.r} \{root.bottom} "
        + "L \{root.left + root.r} \{root.bottom} "
        + "A \{root.r} \{root.r} 0 0 1 \{root.left} \{root.bottom - root.r} "
        + "L \{root.left} \{root.top + root.r} "
        + "A \{root.r} \{root.r} 0 0 1 \{root.left + root.r} \{root.top} Z";
}
