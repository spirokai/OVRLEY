import { Theme, WindowMetrics } from "../theme/theme.slint";
import { AppText } from "app-text.slint";
import { Icon, Icons } from "icons.slint";
import { Button, ButtonVariant, ButtonSize } from "button.slint";
import { Shadow, ShadowSize } from "shadow.slint";
import { ScrollArea } from "scroll-area.slint";

// The error alert's layer (D12). React portals `ErrorAlert` above every layer, dialog scrims
// included. In Slint dialogs are full-window popups drawn above the main tree, and a popup takes
// all pointer input, so the alert cannot be a popup itself. Like `TooltipLayer`, its view is drawn
// last in `FluidWindow` and last inside `Dialog`'s popup, so it stays visible and clickable above
// an open dialog. The app-shell projection fills the global and binds its callbacks.
export global AlertLayer {
    in-out property <bool> shown;
    // Already translated (`translateBackendError`).
    in-out property <string> message;
    callback copy-requested(string);
    callback dismiss-requested();
}

// `ErrorAlert`: 1rem from the top and right, at most 28rem wide; it fades in and slides 1rem down
// over 300 ms. Every error carries the same title, a React oddity that is kept.
export component AlertLayerView {
    width: 100%;
    height: 100%;
    property <bool> copied;

    copied-timer := Timer {
        interval: 1500ms;
        running: root.copied;
        triggered => {
            root.copied = false;
        }
    }

    if AlertLayer.shown: panel := Rectangle {
        property <length> panel-width: min(28rem, WindowMetrics.width - 2rem);
        x: root.width - self.width - 1rem;
        y: 1rem + (self.entered ? 0 : -1rem);
        width: self.panel-width;
        height: layout.preferred-height;
        opacity: self.entered ? 1 : 0;
        property <bool> entered;
        init => {
            self.entered = true;
        }
        animate opacity, y { duration: Theme.duration-300; easing: ease-out; }

        Shadow {
            size: ShadowSize.md;
            radius: Theme.radius-xs * 1rem;
        }
        Rectangle {
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: Theme.radius-xs * 1rem;
            accessible-role: AccessibleRole.text;
            accessible-live-region: assertive;
        }
        // Clicks on the alert do not reach what lies under it.
        TouchArea { }

        layout := VerticalLayout {
            padding-left: 1.25rem;
            padding-right: 3rem;
            padding-top: 0.75rem;
            padding-bottom: 0.75rem;
            spacing: 0.5rem;

            HorizontalLayout {
                spacing: 0.5rem;
                alignment: start;
                Icon {
                    glyph: Icons.circle-alert;
                    size: 1rem;
                    color: Theme.destructive;
                }
                AppText {
                    content: @tr("app-shell.errorRenderingVideo" => "Error Rendering Video");
                    color: Theme.destructive;
                    font-size: Theme.text-sm * 1rem;
                    font-weight: Theme.font-weight-medium;
                    tracking: Theme.tracking-tight;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Button {
                    variant: ButtonVariant.ghost;
                    size: ButtonSize.icon;
                    width: 1.5rem;
                    height: 1.5rem;
                    icon: root.copied ? Icons.check : Icons.copy;
                    icon-size: 0.875rem;
                    text-color: Theme.destructive;
                    hover-background: Theme.destructive.transparentize(0.9);
                    accessible-label: @tr("app-shell.copyError" => "Copy error");
                    clicked => {
                        AlertLayer.copy-requested(AlertLayer.message);
                        root.copied = true;
                    }
                }
            }
            // Selectable, wrapping anywhere and keeping newlines; scrolls past 60% of the window.
            ScrollArea {
                thin: true;
                max-height: WindowMetrics.height * 0.6;
                preferred-height: message.preferred-height;
                message := TextInput {
                    text: AlertLayer.message;
                    read-only: true;
                    single-line: false;
                    wrap: word-wrap;
                    color: Theme.destructive.transparentize(0.1);
                    font-size: Theme.text-sm * 1rem;
                    font-family: Theme.font-sans;
                    selection-background-color: Theme.destructive.transparentize(0.7);
                }
            }
        }

        Button {
            x: parent.width - self.width - 0.5rem;
            y: 0.5rem;
            variant: ButtonVariant.ghost;
            size: ButtonSize.icon;
            width: 2rem;
            height: 2rem;
            icon: Icons.x;
            icon-size: 1rem;
            text-color: Theme.destructive;
            hover-background: Theme.destructive.transparentize(0.9);
            clicked => {
                AlertLayer.dismiss-requested();
            }
        }
    }
}
