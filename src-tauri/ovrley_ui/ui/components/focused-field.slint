// The press-away blur (D19). A browser blurs a focused input when a press lands anywhere else, and
// the fields commit on blur. Slint keeps the focus until something else takes it. While a text field
// has focus it reports its window rectangle here; the platform's event handler sees every press
// before Slint routes it, and when one lands more than 8px outside that rectangle it bumps
// `blur-serial`. The field then gives up its focus, so it commits as when Tab moves the focus, and
// the press is routed as usual: a press on another field focuses that field.
export global FocusedField {
    in-out property <bool> active;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> width;
    in-out property <length> height;
    in-out property <int> blur-serial;
}
