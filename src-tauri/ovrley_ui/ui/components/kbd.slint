import { Theme } from "../theme/theme.slint";
import { AppText } from "app-text.slint";

// kbd.jsx: 1.5rem high, at least 1.25rem wide, 0.5rem side padding, `rounded-sm`,
// `muted-foreground` at 10%, `text-xs`, weight 500, muted, Figtree, uppercase. It takes no input.
export component Kbd inherits Rectangle {
    in property <string> text;

    min-height: 1.5rem;
    min-width: 1.25rem;
    max-height: 1.5rem;
    border-radius: Theme.radius-sm * 1rem;
    background: Theme.muted-foreground.transparentize(0.9);
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    HorizontalLayout {
        padding-left: 0.5rem;
        padding-right: 0.5rem;
        spacing: 0.25rem;
        alignment: center;
        AppText {
            content: root.text;
            uppercase: true;
            font-size: Theme.text-xs * 1rem;
            font-weight: Theme.font-weight-medium;
            color: Theme.muted-foreground;
            line-height: Theme.text-xs-line-height;
        }
        @children
    }
}

// KbdGroup: keys 0.25rem apart.
export component KbdGroup inherits HorizontalLayout {
    spacing: 0.25rem;
    alignment: start;
}
