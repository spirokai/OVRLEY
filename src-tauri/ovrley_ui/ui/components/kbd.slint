import { Theme } from "../theme/theme.slint";
import { AppText } from "app-text.slint";

// kbd.jsx: 1.5rem high, at least 1.25rem wide, 0.5rem side padding, `rounded-sm`,
// `muted-foreground` at 10%, `text-xs`, weight 500, muted, Figtree, uppercase. It takes no input.
// A hard shadow 2px below (no blur), a darker shade of the face, makes it read as a key. The face
// is the 10% tint mixed into `surface`, opaque, so the shadow does not show through it.
export component Kbd inherits Rectangle {
    in property <string> text;
    // What the key sits on: the dialogs' `card`.
    in property <color> surface: Theme.card;

    min-height: 1.5rem;
    min-width: 1.25rem;
    max-height: 1.5rem;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    property <color> face: Theme.muted-foreground.mix(root.surface, 0.1);

    Rectangle {
        y: 2px;
        border-radius: Theme.radius-sm * 1rem;
        background: root.face.darker(0.35);
    }
    Rectangle {
        border-radius: Theme.radius-sm * 1rem;
        background: root.face;
    }

    HorizontalLayout {
        padding-left: 0.5rem;
        padding-right: 0.5rem;
        spacing: 0.25rem;
        alignment: center;
        AppText {
            content: root.text;
            uppercase: true;
            font-size: Theme.text-xs * 1rem;
            font-weight: Theme.font-weight-medium;
            color: Theme.muted-foreground;
            line-height: Theme.text-xs-line-height;
        }
        @children
    }
}

// KbdGroup: keys 0.25rem apart.
export component KbdGroup inherits HorizontalLayout {
    spacing: 0.25rem;
    alignment: start;
}
