import { Theme } from "../theme/theme.slint";
import { AppText } from "app-text.slint";
import { Input } from "input.slint";
import { Icon, Icons } from "icons.slint";
import { SimpleTooltip } from "simple-tooltip.slint";

// The placement slot: none, a reset button for a value set by hand, or a clock for an automatic
// one.
export enum SecondsSlot { none, manual, auto }

// seconds-input.jsx: the one input for times and durations, typed as a clock (`05:30`), as plain
// seconds, or as a sum (`05:30+10`). Rust owns the field (`lib/seconds_input.rs`): it accepts or
// refuses each edit, commits on Enter, blur and a step's key release, and discards on Escape. Below
// the field: the error (0.65rem `destructive`) or the preview (0.65rem muted). With `show-unit` a
// `SEC` unit sits inside the field's right edge (without step buttons or a slot). With
// `step-buttons` a 1.25rem column of up and down buttons on `surface-strong` sits at the right edge;
// the placement slot (`slot`) sits left of it.
export component SecondsInput inherits VerticalLayout {
    in property <string> text;
    in property <bool> disabled;
    in property <bool> step-buttons;
    in property <SecondsSlot> slot: SecondsSlot.none;
    in property <string> reset-label;
    in property <string> manual-hint;
    in property <string> auto-hint;
    callback step(direction: int);
    callback reset();
    in property <string> preview;
    in property <string> error;
    in property <string> label;
    in property <bool> show-unit;
    in property <length> field-height: 2.25rem;
    in property <length> font-size: Theme.text-sm * 1rem;
    // The text changed; returns whether Rust accepted it. A refused edit restores `text`.
    callback edited(text: string) -> bool;
    // A key in the field; returns whether Rust used it.
    callback key(text: string, alt: bool, control: bool, shift: bool, meta: bool) -> bool;
    callback key-up(text: string) -> bool;
    callback blurred();

    // The field's own text: Rust's `text`, and the typing in between. A one-way binding would be
    // dropped at the first keystroke.
    property <string> draft;
    init => {
        root.draft = root.text;
    }
    changed text => {
        root.draft = root.text;
    }

    spacing: 0.25rem;
    Rectangle {
        height: root.field-height;
        field := Input {
            width: parent.width;
            height: parent.height;
            text <=> root.draft;
            label: root.label;
            invalid: root.error != "";
            font-size: root.font-size;
            border-width: 1px;
            border-color: Theme.border.transparentize(0.3);
            disabled: root.disabled;
            inset-right: root.show-unit && !root.step-buttons && root.slot == SecondsSlot.none ? 2.25rem
                : root.step-buttons && root.slot != SecondsSlot.none ? 3.25rem
                : root.step-buttons || root.slot != SecondsSlot.none ? 1.75rem : 0.75rem;
            edited(text) => {
                if !root.edited(text) {
                    root.draft = root.text;
                }
            }
            accepted => {
                root.key("\n", false, false, false, false);
            }
            key-pressed(event) => {
                root.key(event.text, event.modifiers.alt, event.modifiers.control, event.modifiers.shift, event.modifiers.meta) ? accept : reject
            }
            key-released(event) => {
                root.key-up(event.text) ? accept : reject
            }
            focus-changed(focused) => {
                if !focused {
                    root.blurred();
                }
            }

            if root.step-buttons: Rectangle {
                x: parent.width - self.width - 0.25rem;
                y: 0.25rem;
                width: 1.25rem;
                height: parent.height - 0.5rem;
                border-radius: 0.25rem;
                background: Theme.surface-strong;
                clip: true;
                VerticalLayout {
                    for direction in [1, -1]: step-touch := TouchArea {
                        enabled: !root.disabled;
                        clicked => {
                            root.step(direction);
                        }
                        Rectangle {
                            background: step-touch.has-hover ? Theme.surface-accent-soft : transparent;
                            Icon {
                                glyph: direction > 0 ? Icons.chevron-up : Icons.chevron-down;
                                size: 0.75rem;
                                color: step-touch.has-hover ? Theme.primary : Theme.muted-foreground;
                            }
                        }
                    }
                }
            }
            if root.slot == SecondsSlot.manual: reset-touch := SimpleTooltip {
                x: parent.width - self.width - (root.step-buttons ? 1.75rem : 0.25rem);
                y: 0.25rem;
                width: 1.25rem;
                height: parent.height - 0.5rem;
                content: root.manual-hint;
                accessible-role: AccessibleRole.button;
                accessible-label: root.reset-label;
                enabled: !root.disabled;
                clicked => {
                    root.reset();
                }
                Rectangle {
                    border-radius: 0.25rem;
                    background: reset-touch.has-hover ? Theme.surface-accent-soft : transparent;
                    Icon {
                        glyph: Icons.rotate-ccw;
                        size: 0.75rem;
                        color: reset-touch.has-hover ? Theme.primary : Theme.muted-foreground;
                    }
                }
            }
            if root.slot == SecondsSlot.auto: SimpleTooltip {
                x: parent.width - self.width - (root.step-buttons ? 1.75rem : 0.25rem);
                y: 0.25rem;
                width: 1.25rem;
                height: parent.height - 0.5rem;
                content: root.auto-hint;
                Icon {
                    glyph: Icons.clock;
                    size: 0.75rem;
                    color: Theme.muted-foreground.transparentize(0.5);
                }
            }
            if root.show-unit && !root.step-buttons && root.slot == SecondsSlot.none: AppText {
                x: parent.width - self.width - 0.5rem;
                content: @tr("components.secondsUnit" => "SEC");
                font-size: Theme.text-xs * 1rem;
                color: Theme.muted-foreground;
            }
        }
    }
    if root.error != "": AppText {
        content: root.error;
        font-size: 0.65rem;
        color: Theme.destructive;
        wrap: word-wrap;
    }
    if root.error == "" && root.preview != "": AppText {
        content: root.preview;
        font-size: 0.65rem;
        color: Theme.muted-foreground;
    }
}
