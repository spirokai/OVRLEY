import { Theme } from "../theme/theme.slint";
import { AppText } from "app-text.slint";
import { Icon } from "icons.slint";
import { Separator } from "separator.slint";

export enum SectionHeadingVariant { compact, drawer }

// section-heading.jsx: a `primary` 1rem icon and a bold, uppercase title in `muted-foreground` at
// 70%, 0.741rem, tracking 0.05em; a separator fills the remaining width, followed by the optional
// trailing slot. compact: 0.5rem gap, 0.75rem vertical padding, 0.75rem root gap; drawer: no
// vertical padding. Callers pass the translated `title`.
export component SectionHeading inherits HorizontalLayout {
    in property <string> title;
    // An `Icons` path.
    in property <string> icon;
    in property <SectionHeadingVariant> variant: SectionHeadingVariant.compact;

    spacing: 0.75rem;
    accessible-role: AccessibleRole.text;
    accessible-label: root.title;

    HorizontalLayout {
        horizontal-stretch: 1;
        spacing: 0.5rem;
        padding-top: root.variant == SectionHeadingVariant.compact ? 0.75rem : 0px;
        padding-bottom: self.padding-top;
        Icon {
            glyph: root.icon;
            size: 1rem;
            color: Theme.primary;
        }
        AppText {
            content: root.title;
            uppercase: true;
            font-size: 0.741rem;
            font-weight: Theme.font-weight-bold;
            tracking: Theme.tracking-wider;
            color: Theme.muted-foreground.transparentize(0.3);
        }
        Separator { }
    }
    @children
}
