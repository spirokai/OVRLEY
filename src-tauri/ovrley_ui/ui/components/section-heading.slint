import { Theme } from "../theme/theme.slint";
import { AppText } from "app-text.slint";
import { Icon } from "icons.slint";
import { Separator } from "separator.slint";
import { HelpTooltip } from "help-tooltip.slint";

export enum SectionHeadingVariant { compact, drawer, scene }

// section-heading.jsx: a `primary` 1rem icon and a bold, uppercase title in `muted-foreground` at
// 70%, 0.741rem, tracking 0.05em; a separator fills the remaining width, followed by the optional
// trailing slot. compact: 0.5rem gap, 0.75rem vertical padding, 0.75rem root gap; drawer: no
// vertical padding; scene (scene settings' own heading): 0.75rem gap, no vertical padding,
// `tracking-widest`, muted at full strength. Callers pass the translated `title`, and optionally `help`, shown by an info
// icon right after the title (0.25rem closer).
export component SectionHeading inherits HorizontalLayout {
    in property <string> title;
    // An `Icons` path.
    in property <string> icon;
    in property <SectionHeadingVariant> variant: SectionHeadingVariant.compact;
    in property <string> help;

    spacing: 0.75rem;
    accessible-role: AccessibleRole.text;
    accessible-label: root.title;

    HorizontalLayout {
        horizontal-stretch: 1;
        spacing: root.variant == SectionHeadingVariant.scene ? 0.75rem : 0.5rem;
        padding-top: root.variant == SectionHeadingVariant.compact ? 0.75rem : 0px;
        padding-bottom: self.padding-top;
        Icon {
            glyph: root.icon;
            size: 1rem;
            color: Theme.primary;
        }

        AppText {
            content: root.title;
            uppercase: true;
            font-size: 0.741rem;
            font-weight: Theme.font-weight-extrabold;
            tracking: root.variant == SectionHeadingVariant.scene ? Theme.tracking-widest : Theme.tracking-wider;
            color: root.variant == SectionHeadingVariant.scene ? Theme.muted-foreground : Theme.muted-foreground.transparentize(0.3);
        }

        if root.help != "": HorizontalLayout {
            // Its own width only: the separator takes the rest, as `flex-1` does.
            horizontal-stretch: 0;
            padding-left: -0.25rem;
            alignment: center;
            VerticalLayout {
                alignment: center;
                HelpTooltip { content: root.help; }
            }
        }

        Separator {
            horizontal-stretch: 1;
        }
    }

    @children
}
