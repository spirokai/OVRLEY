import { Theme } from "../theme/theme.slint";

// The shared text element. Defaults are the React root's: Figtree, 1rem, line height 1.5,
// tracking 0.03em, weight 400, `foreground`, uppercase. Set `content`, not `text`: Slint has no
// `text-transform`, so `uppercase` uppercases the displayed string. Text the browser does not
// transform (buttons, inputs) or React marks `normal-case` sets `uppercase: false`.
export component AppText inherits Text {
    in property <string> content;
    in property <bool> uppercase: true;
    in property <bool> mono;
    // CSS line-height factor.
    in property <float> line-height: Theme.leading-root;
    // Letter spacing, in em.
    in property <float> tracking: Theme.tracking-root;

    text: root.uppercase ? root.content.to-uppercase() : root.content;
    font-family: root.mono ? Theme.font-mono : Theme.font-sans;
    font-size: 1rem;
    font-weight: Theme.font-weight-normal;
    color: Theme.foreground;
    line-height-factor: root.line-height / (root.mono ? Theme.font-mono-natural-line-height : Theme.font-sans-natural-line-height);
    letter-spacing: self.font-size * root.tracking;
    vertical-alignment: center;
}
