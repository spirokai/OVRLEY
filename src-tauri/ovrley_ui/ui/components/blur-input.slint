import { Theme } from "../theme/theme.slint";
import { Icon, Icons } from "icons.slint";
import { Input, InputVariant } from "input.slint";
import { NumberConstraints, NumberInputLogic, StepDirection } from "logic.slint";

// One of the number mode's step buttons: it does not take focus from the field.
component StepButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> disabled;
    callback clicked();

    background: touch.has-hover && !root.disabled ? Theme.surface-accent-soft : transparent;
    opacity: root.disabled ? 0.5 : 1;
    accessible-role: AccessibleRole.button;
    accessible-enabled: !root.disabled;
    accessible-action-default => {
        root.clicked();
    }
    animate background { duration: Theme.duration-150; easing: cubic-bezier(0.4, 0, 0.2, 1); }

    Icon {
        glyph: root.glyph;
        size: 0.75rem;
        color: touch.has-hover && !root.disabled ? Theme.primary : Theme.muted-foreground;
    }
    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

// blur-input.jsx: an `Input` with a local draft. Values are strings in Slint, so React's mix of
// strict and loose comparison disappears: a draft equal to the committed text is never dirty.
// - It commits (`changed`) on blur when the draft differs from `value`; Enter blurs.
// - A new `value` replaces the draft, unless the field is focused with an uncommitted edit.
// - While the draft differs it shows `surface-accent-soft`. Its `border` colours (70%, and
//   `accent-border` while dirty) are kept, but the input's border is 0, as in React.
// - Number mode: 2.75rem right padding and a 1.25rem column of step buttons; the buttons and ↑/↓
//   step the value as `stepUp()`/`stepDown()` do and commit at once.
// `font-size`, `mono`, `height`, `background` and `inset-right` are the call sites' overrides (D5).
export component BlurInput {
    in property <string> value;
    in property <bool> number;
    in property <NumberConstraints> constraints: { step: "" };
    in property <string> placeholder;
    in property <bool> disabled;
    in property <length> font-size: Theme.text-sm * 1rem;
    in property <bool> mono;
    // The clean field's fill (`bg-surface` in the widget editor); a dirty draft shows its own.
    in property <color> background: transparent;
    in property <length> inset-right: root.number ? 2.75rem : 0.75rem;
    // `aria-label`: the field's accessible name.
    in property <string> label;
    callback changed(value: string);
    callback blurred();

    property <string> draft;
    property <string> last-value;
    property <bool> dirty: root.draft != root.value;

    init => {
        root.draft = root.value;
        root.last-value = root.value;
    }
    changed value => {
        let draft-was-dirty = root.draft != root.last-value;
        root.last-value = root.value;
        // Preserve an in-progress draft when the committed value changes upstream.
        if field.has-focus && draft-was-dirty {
            return;
        }
        root.draft = root.value;
    }

    function step(direction: StepDirection) {
        let next = NumberInputLogic.step(root.draft, root.constraints, direction);
        if next.stepped {
            root.draft = next.text;
            // Reading `next.text` twice trips a Slint 1.18 code generation bug (a moved value).
            root.changed(root.draft);
        }
    }

    min-height: field.min-height;
    max-height: field.max-height;
    horizontal-stretch: 1;
    forward-focus: field;

    field := Input {
        width: root.width;
        height: root.height;
        text <=> root.draft;
        number: root.number;
        placeholder: root.placeholder;
        disabled: root.disabled;
        font-size: root.font-size;
        mono: root.mono;
        background: root.dirty ? Theme.surface-accent-soft : root.background;
        border-color: root.dirty ? Theme.accent-border : Theme.border.transparentize(0.3);
        inset-right: root.inset-right;
        label: root.label;

        focus-changed(focused) => {
            if !focused {
                if root.draft != root.value {
                    root.changed(root.draft);
                }
                root.blurred();
            }
        }
        accepted => {
            self.blur();
        }
        key-pressed(event) => {
            if root.number && event.text == Key.UpArrow {
                root.step(StepDirection.up);
                return accept;
            }
            if root.number && event.text == Key.DownArrow {
                root.step(StepDirection.down);
                return accept;
            }
            reject
        }
    }

    if root.number: Rectangle {
        x: root.width - 0.25rem - self.width;
        y: 0.25rem;
        width: 1.25rem;
        height: root.height - 0.5rem;
        border-radius: Theme.rounded * 1rem;
        background: Theme.surface-strong;
        clip: true;

        VerticalLayout {
            StepButton {
                vertical-stretch: 1;
                glyph: Icons.chevron-up;
                disabled: root.disabled;
                accessible-label: @tr("components.increaseValue" => "Increase value");
                clicked => {
                    root.step(StepDirection.up);
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.border.transparentize(0.4);
            }
            StepButton {
                vertical-stretch: 1;
                glyph: Icons.chevron-down;
                disabled: root.disabled;
                accessible-label: @tr("components.decreaseValue" => "Decrease value");
                clicked => {
                    root.step(StepDirection.down);
                }
            }
        }
    }
}
