// A lucide icon, stroked at lucide's width of 2 on the 24 grid, so strokes scale with the size
// as in the browser. Set `glyph` to an `Icons` property. It takes the height it is given and
// centres the glyph, so icons sit level with text in a row (layouts ignore `y`).
export component Icon {
    in property <string> glyph;
    in property <length> size: 1rem;
    in property <color> color: Theme.foreground;
    // lucide's stroke width on the 24 grid.
    in property <float> stroke: 2;
    width: root.size;
    min-height: root.size;
    preferred-height: root.size;
    max-height: 100000px;
    accessible-role: AccessibleRole.none;

    Path {
        y: (root.height - root.size) / 2;
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.glyph;
        fill: transparent;
        stroke: root.color;
        stroke-width: root.size * root.stroke / 24;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}
