// Tailwind shadows, read from the compiled CSS:
//   xs  0 1px 2px 0 #0000000d
//   sm  0 1px 3px 0 #0000001a, 0 1px 2px -1px #0000001a
//   md  0 4px 6px -1px #0000001a, 0 2px 4px -2px #0000001a
//   2xl 0 25px 50px -12px #00000040
// Slint gives one drop shadow per Rectangle and has no spread: layers stack rectangles, and a
// negative spread shrinks the rectangle that casts the shadow.
export enum ShadowSize { none, xs, sm, md, xxl }

component ShadowLayer {
    width: 100%;
    height: 100%;
    in property <length> offset-y;
    in property <length> blur;
    in property <length> spread;
    in property <color> shadow-color;
    in property <length> radius;

    Rectangle {
        x: -root.spread;
        y: -root.spread;
        width: root.width + 2 * root.spread;
        height: root.height + 2 * root.spread;
        border-radius: max(0px, root.radius + root.spread);
        drop-shadow-offset-y: root.offset-y;
        drop-shadow-blur: root.blur;
        drop-shadow-color: root.shadow-color;
    }
}

// Draws the shadow of its parent's border box. Place it as the first child so it sits behind;
// it fills the parent.
// `color` replaces every layer's colour, as a Tailwind shadow colour (`shadow-background/40`) does;
// it applies when `has-color` is set.
export component Shadow {
    width: 100%;
    height: 100%;
    in property <ShadowSize> size;
    in property <length> radius;
    in property <bool> has-color;
    in property <color> color;

    function layer-color(base: color) -> color {
        root.has-color ? root.color : base
    }

    if root.size != ShadowSize.none: ShadowLayer {
        radius: root.radius;
        offset-y: root.size == ShadowSize.xs ? 1px : root.size == ShadowSize.sm ? 1px : root.size == ShadowSize.md ? 4px : 25px;
        blur: root.size == ShadowSize.xs ? 2px : root.size == ShadowSize.sm ? 3px : root.size == ShadowSize.md ? 6px : 50px;
        spread: root.size == ShadowSize.md ? -1px : root.size == ShadowSize.xxl ? -12px : 0px;
        shadow-color: root.layer-color(root.size == ShadowSize.xs ? #0000000d : root.size == ShadowSize.xxl ? #00000040 : #0000001a);
    }
    if root.size == ShadowSize.sm || root.size == ShadowSize.md: ShadowLayer {
        radius: root.radius;
        offset-y: root.size == ShadowSize.sm ? 1px : 2px;
        blur: root.size == ShadowSize.sm ? 2px : 4px;
        spread: root.size == ShadowSize.sm ? -1px : -2px;
        shadow-color: root.layer-color(#0000001a);
    }
}
