// The `components.*` strings the shared components show. Each defaults to the English fallback
// written in the React code; Phase 2's i18n writes the active locale here. `components.gradient`
// is missing from every locale file today, so it always shows its fallback.
// Interpolated strings keep their `{{name}}` placeholders and are filled with `replace-all`.
export global ComponentStrings {
    in-out property <string> alpha-transparency-percentage: "Alpha transparency percentage";
    in-out property <string> blue-color-component-0255: "Blue color component (0-255)";
    in-out property <string> brightness-percentage-0100: "Brightness percentage (0-100)";
    in-out property <string> current-color-val: "Current color: {{val}}";
    in-out property <string> decrease-value: "Decrease value";
    in-out property <string> gradient: "Gradient";
    in-out property <string> gradient-add-stop-hint: "Click to add a color stop";
    in-out property <string> gradient-remove-stop: "Remove stop";
    in-out property <string> gradient-stop-label: "Color stop at {{percent}}%";
    in-out property <string> gradient-stops: "Gradient stops";
    in-out property <string> green-color-component-0255: "Green color component (0-255)";
    in-out property <string> hex-color-value: "Hex color value";
    in-out property <string> hue-degree-0360: "Hue degree (0-360)";
    in-out property <string> increase-value: "Increase value";
    in-out property <string> lightness-percentage-0100: "Lightness percentage (0-100)";
    in-out property <string> no-color-selected: "No color selected";
    in-out property <string> presets: "Presets";
    in-out property <string> recommended: "Recommended";
    in-out property <string> red-color-component-0255: "Red color component (0-255)";
    in-out property <string> saturation-percentage-0100: "Saturation percentage (0-100)";
    in-out property <string> system: "System";
}
