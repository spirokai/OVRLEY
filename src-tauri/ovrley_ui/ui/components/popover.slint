import { Theme, WindowMetrics } from "../theme/theme.slint";
import { AppText } from "app-text.slint";
import { Shadow, ShadowSize } from "shadow.slint";
import { OverlayMotion } from "overlay-motion.slint";
import { Placement, PlacementAlign, PlacementLogic, PlacementSide } from "logic.slint";

// popover.jsx `Popover` + `PopoverContent`, controlled through `open` and `open-changed`.
// Slint has one slot per component, so `Popover` is placed beside the trigger, inside the trigger's
// parent, which it fills and anchors to; its slot is the content. The content is centred by
// default, 4px from the trigger, 18rem wide, `rounded-xs`, bordered, `popover` fill, 1rem padding,
// `shadow-sm`, with the overlay animation. Escape and an outside click close it; focus moves into
// the content on open. Slint cannot focus an element of the caller, so the caller returns focus
// to its trigger in `open-changed`. Flip and shift come from the shared placement.
// `PopoverAnchor` has no caller and is not ported.
export component Popover {
    in property <bool> open;
    in property <PlacementSide> side: PlacementSide.bottom;
    in property <PlacementAlign> align: PlacementAlign.center;
    in property <length> side-offset: 4px;
    in property <length> content-width: 18rem;
    in property <length> content-padding: 1rem;
    in property <length> radius: Theme.radius-xs * 1rem;
    callback open-changed(open: bool);

    property <bool> popup-open: popup.is-open;
    changed popup-open => {
        if !root.popup-open && root.open {
            root.open-changed(false);
        }
    }
    changed open => {
        if root.open {
            popup.show();
        } else {
            popup.close();
        }
    }

    width: 100%;
    height: 100%;

    popup := PopupWindow {
        property <Placement> placed: PlacementLogic.place(
            { x: root.absolute-position.x, y: root.absolute-position.y, width: root.width, height: root.height },
            root.content-width, content.preferred-height, WindowMetrics.width, WindowMetrics.height, root.side, root.align, root.side-offset);
        close-policy: PopupClosePolicy.close-on-click-outside;
        x: self.placed.x - root.absolute-position.x;
        y: self.placed.y - root.absolute-position.y;
        width: root.content-width;
        height: content.preferred-height;

        OverlayMotion {
            side: popup.placed.side;
            Shadow {
                size: ShadowSize.sm;
                radius: root.radius;
            }
            Rectangle {
                border-radius: root.radius;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.popover;
            }
            content := VerticalLayout {
                padding: root.content-padding;
                FocusScope {
                    init => {
                        self.focus();
                    }
                    VerticalLayout {
                        @children
                    }
                }
            }
        }
    }
}

// `flex flex-col gap-1 text-sm`.
export component PopoverHeader inherits VerticalLayout {
    spacing: 0.25rem;
}

// `font-medium`.
export component PopoverTitle inherits AppText {
    uppercase: true;
    font-size: Theme.text-sm * 1rem;
    font-weight: Theme.font-weight-medium;
    line-height: Theme.text-sm-line-height;
    color: Theme.popover-foreground;
}

// `text-muted-foreground`.
export component PopoverDescription inherits AppText {
    uppercase: true;
    font-size: Theme.text-sm * 1rem;
    line-height: Theme.text-sm-line-height;
    color: Theme.muted-foreground;
    wrap: word-wrap;
}
