import { FluidWindow } from "../theme/fluid-window.slint";
import { Theme } from "../theme/theme.slint";
import { AppShell } from "../features/app-shell/index.slint";

// `main.jsx`'s failure page: the whole window, `p-8`, destructive text, announced as an alert.
component StartupError inherits Rectangle {
    in property <string> message;
    background: Theme.background;
    VerticalLayout {
        padding: 2rem;
        Text {
            text: root.message;
            color: Theme.destructive;
            wrap: word-wrap;
            accessible-role: text;
            accessible-label: root.message;
        }
    }
}

// The composition root that `App.jsx` is (D5). Window chrome per platform (D9): on macOS the native
// title bar stays, transparent, over the header; elsewhere the window has no frame, draws its own
// controls, and resizes from Slint's own border.
export component AppWindow inherits FluidWindow {
    title: "OVRLEY";
    min-width: 1100px;
    min-height: 720px;
    no-frame: Platform.os != OperatingSystemType.macos;
    resize-border-width: Platform.os == OperatingSystemType.macos ? 0px : 6px;

    if AppShell.startup-error != "": StartupError {
        message: AppShell.startup-error;
    }
}
