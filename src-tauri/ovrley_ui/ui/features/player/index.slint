import { Choice } from "../../components/logic.slint";

// A pointer event a timeline element reports to Rust (D9), with its x in timeline coordinates.
export enum PointerPhase { down, move, up, cancel }

// The timeline surface a scrub or pan starts on.
export enum TimelineSurfaceKind { axis, playhead, lanes }

// A major tick: its line's x (on the device pixel grid) and its label's centre, from the strip's
// anchor.
export struct MajorTickView {
    line-x: length,
    label-x: length,
    label: string,
}

// Where a marker's hit area and line sit against its edge.
export enum MarkerAlign { start, center, end }

// A clip on a lane (D8), in timeline pixels; what sits inside it is relative to its box.
export struct ClipView {
    lane-id: string,
    x: length,
    width: length,
    label: string,
    duration-label: string,
    format-label: string,
    missing: bool,
    show-text: bool,
    text-x: length,
    text-width: length,
    badge-x: length,
    badge-max-width: length,
    selected: bool,
    has-selected-segment: bool,
    has-warnings: bool,
}

// A segment of a video clip, in timeline pixels, with the stripes of an excluded one.
export struct SegmentView {
    lane-id: string,
    key: string,
    x: length,
    width: length,
    excluded: bool,
    missing: bool,
    seam-before: bool,
    seam-after: bool,
    selected: bool,
    stripes: string,
}

// A striped span: an overlap band or an activity trim mask.
export struct BandView {
    x: length,
    width: length,
    stripes: string,
}

// A cut marker (`cut-id` a cut, `edge-start` or `edge-end`) or an activity trim handle (lane
// `activity`, `cut-id` `start` or `end`). `x` is its edge.
export struct MarkerView {
    lane-id: string,
    cut-id: string,
    x: length,
    align: MarkerAlign,
    line-inside: bool,
    label: string,
    dragging: bool,
    removable: bool,
}

// The hovered clip's tooltip; its anchor in timeline pixels.
export struct ClipTooltipView {
    visible: bool,
    lane-id: string,
    anchor-x: length,
    title: string,
    duration-label: string,
    metrics: string,
    warnings: [string],
}

// The player feature's global (D5), written by `src/features/player.rs`.
export global Player {
    // `hasActivity || hasVideo`: the player shows.
    in property <bool> visible;

    // The transport.
    in property <bool> transport-disabled;
    in property <bool> playing;
    // `current / total`.
    in property <string> time-label;
    in property <bool> has-video;
    in property <bool> muted;

    // The viewport's toolbar controls.
    in property <bool> can-zoom-in;
    in property <bool> can-zoom-out;
    in property <bool> reset-view-disabled;
    in property <[Choice]> fit-targets;
    // The fit target the viewport matches; empty for none.
    in property <string> fit-target;

    // The axis: the tick strip moves by `strip-offset` while panning within one step.
    in property <length> strip-offset;
    in property <[MajorTickView]> major-ticks;
    in property <[length]> minor-ticks;
    // The playhead's origin, snapped to a screen pixel.
    in property <length> playhead-x;
    // The snap guideline while a drag snapped, on the device pixel grid.
    in property <bool> guideline-visible;
    in property <length> guideline-x;

    // The video lane.
    in property <bool> video-lane-visible;
    in property <[ClipView]> video-clips;
    in property <[SegmentView]> segments;
    in property <[BandView]> overlap-bands;
    in property <[MarkerView]> cut-markers;
    // The activity lane.
    in property <bool> activity-lane-visible;
    in property <bool> activity-clip-visible;
    in property <ClipView> activity-clip;
    in property <[BandView]> trim-masks;
    in property <[MarkerView]> trim-markers;
    in property <ClipTooltipView> tooltip;
    // The tooltip's warnings, one per line.
    in property <string> tooltip-warning-text;

    callback play();
    callback pause();
    callback reset-to-start();
    callback step(seconds: float);
    callback jump-to-end();
    callback toggle-mute();
    callback zoom-in();
    callback zoom-out();
    callback reset-view();
    callback fit-target-selected(id: string);

    // Pointer events of the axis, the playhead and the lane background.
    callback surface-pointer(surface: TimelineSurfaceKind, phase: PointerPhase, x: length);
    callback wheel(delta-y: length, x: length, ctrl: bool);
    // A clip's pointer events and hover; a marker's pointer events.
    callback clip-pointer(lane-id: string, phase: PointerPhase, x: length);
    callback clip-hover(lane-id: string, hovered: bool);
    callback marker-pointer(lane-id: string, cut-id: string, phase: PointerPhase, x: length);
    // The timeline's width and absolute x (D8), when they change.
    callback timeline-metrics(width: length, x: length, rem: length);
}
