import { Theme } from "../../theme/theme.slint";
import { AppText } from "../../components/app-text.slint";
import { Player, PointerPhase, TimelineSurfaceKind } from "index.slint";

// `TimelineSurface`: the axis (`h-7`, `mt-4 mb-1`, crosshair) with its tick strip, the lane
// background (`border` at 40%, `foreground` at 3%, `py-1`, `space-y-0.5`, `e-resize`) holding the
// lanes (the slot) and the snap guideline, and the playhead over both. Positions come from Rust
// in timeline pixels; Slint reports the pointer (D8, D9).
export component TimelineSurface {
    // The playhead SVG's geometry (`playheadGeometry.js`): 13px wide, a 13px head with 5px
    // shoulders, the 1px line at x 6, and 4px of hit padding around the head.
    property <length> playhead-width: 13px;
    property <length> playhead-head: 13px;
    property <length> playhead-shoulder: 5px;
    property <length> playhead-line-x: 6px;
    property <length> playhead-hit: 4px;

    function report() {
        Player.timeline-metrics(root.width, root.absolute-position.x, 1rem);
    }
    init => {
        root.report();
    }
    changed width => {
        root.report();
    }
    changed absolute-position => {
        root.report();
    }

    // Pointer events with the x of `area` in timeline coordinates.
    function forward(surface: TimelineSurfaceKind, event: PointerEvent, x: length) {
        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
            Player.surface-pointer(surface, PointerPhase.down, x);
        } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
            Player.surface-pointer(surface, PointerPhase.up, x);
        } else if event.kind == PointerEventKind.cancel {
            Player.surface-pointer(surface, PointerPhase.cancel, x);
        }
    }

    VerticalLayout {
        padding-top: 0.5rem;
        // The axis.
        VerticalLayout {
            padding-top: 1rem;
            padding-bottom: 0.25rem;
            axis := Rectangle {
                height: 1.75rem;
                clip: true;
                Rectangle {
                    x: Player.strip-offset;
                    for tick in Player.minor-ticks: Rectangle {
                        x: tick;
                        y: 0px;
                        width: 1px;
                        height: 0.375rem;
                        background: Theme.border.transparentize(0.3);
                    }
                    for tick in Player.major-ticks: Rectangle {
                        x: 0px;
                        y: 0px;
                        width: 0px;
                        height: 0px;
                        Rectangle {
                            x: tick.line-x;
                            y: 0px;
                            width: 1px;
                            height: 0.625rem;
                            background: Theme.border;
                        }
                        label := AppText {
                            x: tick.label-x - self.preferred-width / 2;
                            y: 0.75rem;
                            content: tick.label;
                            uppercase: false;
                            font-size: 0.6rem;
                            color: Theme.muted-foreground;
                            vertical-alignment: top;
                        }
                    }
                }
                TouchArea {
                    mouse-cursor: MouseCursor.crosshair;
                    pointer-event(event) => {
                        root.forward(TimelineSurfaceKind.axis, event, self.mouse-x);
                    }
                    moved => {
                        Player.surface-pointer(TimelineSurfaceKind.axis, PointerPhase.move, self.mouse-x);
                    }
                    scroll-event(event) => {
                        Player.wheel(-event.delta-y, self.mouse-x, event.modifiers.control);
                        accept
                    }
                }
            }
        }
        // The lane background.
        lanes := Rectangle {
            border-width: 1px;
            border-color: Theme.border.transparentize(0.6);
            background: Theme.foreground.transparentize(0.97);
            min-height: lane-layout.preferred-height;
            TouchArea {
                mouse-cursor: MouseCursor.e-resize;
                pointer-event(event) => {
                    root.forward(TimelineSurfaceKind.lanes, event, self.mouse-x);
                }
                moved => {
                    Player.surface-pointer(TimelineSurfaceKind.lanes, PointerPhase.move, self.mouse-x);
                }
                scroll-event(event) => {
                    Player.wheel(-event.delta-y, self.mouse-x, event.modifiers.control);
                    accept
                }
            }
            lane-layout := VerticalLayout {
                padding-top: 0.25rem;
                padding-bottom: 0.25rem;
                spacing: 0.125rem;
                @children
            }
            // `bg-success` with a 6px glow.
            if Player.guideline-visible: Rectangle {
                x: Player.guideline-x;
                width: 1px;
                drop-shadow-blur: 6px;
                drop-shadow-color: Theme.success;
                background: Theme.success;
            }
        }
    }

    // The playhead: the head and the 1px line share one parent at a screen-pixel origin, so the
    // line never drifts against the head.
    Rectangle {
        x: Player.playhead-x;
        y: 0px;
        width: root.playhead-width;
        height: root.height;
        Rectangle {
            x: root.playhead-line-x;
            y: 0px;
            width: 1px;
            height: parent.height;
            background: Theme.primary;
        }
        Path {
            x: 0px;
            y: 0px;
            width: root.playhead-width;
            height: root.playhead-head;
            viewbox-width: 13;
            viewbox-height: 13;
            fill: Theme.primary;
            commands: "M 0 0 L 13 0 L 13 5 L 6.5 13 L 0 5 Z";
        }
        handle := TouchArea {
            x: -root.playhead-hit;
            y: -root.playhead-hit;
            width: root.playhead-width + 2 * root.playhead-hit;
            height: root.playhead-head + 2 * root.playhead-hit;
            mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
            pointer-event(event) => {
                root.forward(TimelineSurfaceKind.playhead, event, Player.playhead-x + self.x + self.mouse-x);
            }
            moved => {
                Player.surface-pointer(TimelineSurfaceKind.playhead, PointerPhase.move, Player.playhead-x + self.x + self.mouse-x);
            }
        }
    }
}
