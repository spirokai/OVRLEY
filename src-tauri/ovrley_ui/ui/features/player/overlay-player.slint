import { Theme } from "../../theme/theme.slint";
import { Player } from "index.slint";
import { PlayerToolbar } from "player-toolbar.slint";
import { TimelineSurface } from "timeline-surface.slint";

// `OverlayPlayer` (D20): below the editor while there is something to play or a video;
// `px-8 py-2`, black at 30%, holding `PlayerToolbar` and `TimelineSurface`.
export component OverlayPlayer inherits Rectangle {
    vertical-stretch: 0;
    background: #000000.transparentize(0.7);

    VerticalLayout {
        padding-left: 2rem;
        padding-right: 2rem;
        padding-top: 0.5rem;
        padding-bottom: 0.5rem;
        PlayerToolbar { }
        TimelineSurface { }
    }
}
