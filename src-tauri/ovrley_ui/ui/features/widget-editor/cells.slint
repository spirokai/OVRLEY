import { Theme } from "../../theme/theme.slint";
import { AppText } from "../../components/app-text.slint";
import { Button, ButtonVariant, ButtonSize } from "../../components/button.slint";
import { ButtonGroup } from "../../components/button-group.slint";
import { Input } from "../../components/input.slint";
import { Select } from "../../components/select.slint";
import { HexColorPicker } from "../../components/hex-color-picker.slint";
import { SimpleTooltip } from "../../components/simple-tooltip.slint";
import { GroupPosition } from "../../components/group-surface.slint";
import { Icons } from "../../components/icons.slint";
import { Choice } from "../../components/logic.slint";
import { ShapeToggleView } from "index.slint";
import { FieldBlock } from "form-controls.slint";

// The inspector's bespoke cells (D3): the pieces of React's editors that are not one of the shared
// form controls. Each reports through `changed(value)` or `pressed()` with its cell's id kept by
// the caller.

// `ShapeToggleButton`: `border`, `rounded-sm` (the corners `rounded-*-xl` on their own corner),
// active `primary` border on `primary` at 30%, else `border` at 70% on `background` with a
// `surface-accent-soft` hover. An edge shows its strip: `primary` when active, else a dashed
// `primary` outline at 50% (solid here: Slint has no dashed strokes).
component ShapeToggleButton inherits Rectangle {
    in property <ShapeToggleView> toggle;
    // The corner rounded `xl`: 0 top-left, 1 top-right, 2 bottom-left, 3 bottom-right, -1 none.
    in property <int> corner: -1;
    // The strip's side: 0 top, 1 right, 2 bottom, 3 left, -1 none.
    in property <int> side: -1;
    callback clicked();

    property <length> small: Theme.radius-sm * 1rem;
    property <length> large: 0.75rem;
    border-width: 1px;
    border-color: root.toggle.active ? Theme.primary : Theme.border.transparentize(0.3);
    background: root.toggle.active ? Theme.primary.transparentize(0.7) : touch.has-hover ? Theme.surface-accent-soft : Theme.background;
    border-top-left-radius: root.corner == 0 ? root.large : root.small;
    border-top-right-radius: root.corner == 1 ? root.large : root.small;
    border-bottom-left-radius: root.corner == 2 ? root.large : root.small;
    border-bottom-right-radius: root.corner == 3 ? root.large : root.small;
    accessible-role: AccessibleRole.button;
    accessible-label: root.toggle.label;
    accessible-checkable: true;
    accessible-checked: root.toggle.active;
    accessible-action-default => {
        root.clicked();
    }
    if root.side >= 0: Rectangle {
        // `top-1 inset-x-1 h-1` and its rotations: 0.25rem from the edges, 0.25rem thick.
        x: root.side == 1 ? parent.width - 0.5rem : 0.25rem;
        y: root.side == 2 ? parent.height - 0.5rem : 0.25rem;
        width: root.side == 1 || root.side == 3 ? 0.25rem : parent.width - 0.5rem;
        height: root.side == 0 || root.side == 2 ? 0.25rem : parent.height - 0.5rem;
        border-radius: 0.125rem;
        background: root.toggle.active ? Theme.primary : transparent;
        border-width: root.toggle.active ? 0px : 1px;
        border-color: Theme.primary;
        opacity: root.toggle.active ? 1 : 0.5;
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.clicked();
        }
    }
}

// `ShapeGrid`: an 8rem square (`h-32 w-32`, `py-3 pr-3 pl-1`) of 3 × 3 cells 0.375rem apart:
// the corner toggles at the corners, the edge toggles between them, and the dashed backdrop body
// in the centre. `toggles` come in `SHAPE_GRID_CELLS` order without the centre.
export component ShapeGrid inherits Rectangle {
    in property <[ShapeToggleView]> toggles;
    in property <string> label;
    callback toggled(key: string);

    property <length> gap: 0.375rem;
    property <length> cell-width: (root.width - 0.25rem - 0.75rem - 2 * root.gap) / 3;
    property <length> cell-height: (root.height - 1.5rem - 2 * root.gap) / 3;
    width: 8rem;
    height: 8rem;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: root.label;

    for toggle[index] in root.toggles: ShapeToggleButton {
        // The cell's position in the 3 × 3 grid, skipping the centre.
        property <int> cell: index < 4 ? index : index + 1;
        x: 0.25rem + mod(self.cell, 3) * (root.cell-width + root.gap);
        y: 0.75rem + floor(self.cell / 3) * (root.cell-height + root.gap);
        width: root.cell-width;
        height: root.cell-height;
        toggle: toggle;
        corner: toggle.edge ? -1 : self.cell == 0 ? 0 : self.cell == 2 ? 1 : self.cell == 6 ? 2 : 3;
        side: !toggle.edge ? -1 : self.cell == 1 ? 0 : self.cell == 5 ? 1 : self.cell == 7 ? 2 : 3;
        clicked => {
            root.toggled(toggle.key);
        }
    }
    // The centre: `rounded-sm border border-dashed border-border/70` (solid here).
    Rectangle {
        x: 0.25rem + root.cell-width + root.gap;
        y: 0.75rem + root.cell-height + root.gap;
        width: root.cell-width;
        height: root.cell-height;
        border-radius: Theme.radius-sm * 1rem;
        border-width: 1px;
        border-color: Theme.border.transparentize(0.3);
    }
}

// A ghost `toolbar-icon` button of the series row: muted, `foreground` on hover.
component RowButton inherits Button {
    width: 1.75rem;
    height: 1.75rem;
    variant: ButtonVariant.ghost;
    size: ButtonSize.toolbar-icon;
    text-color: Theme.muted-foreground;
    hover-text-color: Theme.foreground;
}

// `ChartSeriesRow`: the metric select (filling the row), the swatch-only colour picker, and the
// move up, move down and remove buttons, 0.25rem apart. Actions report as text: `metric:<type>`,
// `color:<hex>`, `up`, `down`, `remove`.
export component ChartSeriesRow inherits HorizontalLayout {
    in property <string> metric;
    in property <[Choice]> options;
    in property <string> color;
    in property <bool> first;
    in property <bool> last;
    in property <bool> only;
    in property <string> metric-label;
    callback action(value: string);

    spacing: 0.25rem;
    alignment: stretch;
    Select {
        horizontal-stretch: 1;
        height: 2.25rem;
        items: root.options;
        value: root.metric;
        font-size: Theme.text-xs * 1rem;
        background: Theme.surface;
        border-color: Theme.border.transparentize(0.3);
        accessible-label: root.metric-label;
        value-changed(value) => {
            root.action("metric:" + value);
        }
    }
    HexColorPicker {
        width: 2.25rem;
        horizontal-stretch: 0;
        value: root.color;
        show-value: false;
        changed(hex) => {
            root.action("color:" + hex);
        }
    }
    RowButton {
        icon: Icons.chevron-up;
        disabled: root.first;
        accessible-label: @tr("widget-editor.moveUp" => "Move up");
        clicked => {
            root.action("up");
        }
    }
    RowButton {
        icon: Icons.chevron-down;
        disabled: root.last;
        accessible-label: @tr("widget-editor.moveDown" => "Move down");
        clicked => {
            root.action("down");
        }
    }
    RowButton {
        icon: Icons.trash-2;
        disabled: root.only;
        accessible-label: @tr("widget-editor.removeMetric" => "Remove metric");
        clicked => {
            root.action("remove");
        }
    }
}

// The raster image picker (D5): a full-width `ButtonGroup` of the read-only path (`h-9 text-xs`,
// square right corners; the input draws no border, as in React) under a wrapping tooltip of the path, and the outline
// folder button, disabled while an image loads; the error below (`text-xs destructive`).
export component RasterPicker inherits VerticalLayout {
    in property <string> path;
    in property <string> placeholder;
    in property <string> label;
    in property <string> button-label;
    in property <bool> loading;
    in property <string> error;
    callback pick();

    spacing: 0.5rem;
    ButtonGroup {
        Rectangle {
            horizontal-stretch: 1;
            height: 2.25rem;
            Input {
                text: root.path;
                placeholder: root.placeholder;
                read-only: true;
                label: root.label;
                font-size: Theme.text-xs * 1rem;
                group-position: GroupPosition.first;
            }
            // Over the read-only field, which takes no edits.
            SimpleTooltip {
                content: root.path;
                wrap-text: true;
            }
        }
        Button {
            height: 2.25rem;
            width: 2.25rem;
            variant: ButtonVariant.outline;
            size: ButtonSize.icon;
            icon: Icons.folder-open;
            icon-size: 1rem;
            group-position: GroupPosition.last;
            disabled: root.loading;
            background: Theme.surface-elevated;
            hover-background: Theme.surface-strong;
            text-color: Theme.foreground;
            hover-text-color: Theme.foreground;
            accessible-label: root.button-label;
            clicked => {
                root.pick();
            }
        }
    }
    if root.error != "": AppText {
        content: root.error;
        uppercase: false;
        font-size: Theme.text-xs * 1rem;
        color: Theme.destructive;
        wrap: word-wrap;
        accessible-role: AccessibleRole.text;
        accessible-live-region: assertive;
    }
}

// The chart's time window (`useWindowSecondsInput`): `FieldBlock` with a text input in
// `CONTROL_CLASS`; malformed or out-of-range text stays as an invalid draft. Focus selects the
// text; Enter commits; Escape discards the draft.
export component WindowSecondsField inherits FieldBlock {
    in property <string> text;
    in property <bool> invalid;
    callback committed(text: string);
    callback cancelled();

    property <string> draft: root.text;
    changed text => {
        root.draft = root.text;
    }
    field := Input {
        height: 2.25rem;
        text <=> root.draft;
        invalid: root.invalid;
        label: root.label;
        font-size: Theme.text-xs * 1rem;
        background: Theme.surface;
        accepted => {
            root.committed(root.draft);
        }
        focus-changed(focused) => {
            if !focused && root.draft != root.text {
                root.committed(root.draft);
            }
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            reject
        }
    }
}
