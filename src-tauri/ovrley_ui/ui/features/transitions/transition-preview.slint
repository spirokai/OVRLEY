import { Theme } from "../../theme/theme.slint";
import { TransitionPreviews } from "index.slint";

// A transition's animated preview: its cell of the shared sprite frame, filling the box.
export component TransitionPreview inherits Rectangle {
    in property <int> index;
    clip: true;
    border-radius: 2px;
    Image {
        width: parent.width;
        height: parent.height;
        source: TransitionPreviews.frame;
        source-clip-x: Math.mod(root.index, TransitionPreviews.columns) * TransitionPreviews.cell-width;
        source-clip-y: Math.floor(root.index / TransitionPreviews.columns) * TransitionPreviews.cell-height;
        source-clip-width: TransitionPreviews.cell-width;
        source-clip-height: TransitionPreviews.cell-height;
        image-fit: fill;
    }
}
