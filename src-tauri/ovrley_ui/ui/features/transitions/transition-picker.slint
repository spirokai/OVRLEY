import { Theme } from "../../theme/theme.slint";
import { AppText } from "../../components/app-text.slint";
import { Icon, Icons } from "../../components/icons.slint";
import { Input } from "../../components/input.slint";
import { ScrollArea } from "../../components/scroll-area.slint";
import { TransitionOption, TransitionOptionKind } from "index.slint";
import { TransitionPreview } from "transition-preview.slint";

// One tile: `rounded-xs`, `border` at 60% (`primary` on `surface-accent-soft` when selected, a
// `primary` border on hover), `p-1`, a 120 : 68 preview box on `muted`, a 0.65rem medium label.
component PickerTile inherits Rectangle {
    in property <TransitionOption> option;
    in property <bool> selected;
    callback chosen();
    property <length> preview-height: (self.width - 0.5rem) * 68 / 120;
    height: 0.25rem + self.preview-height + 0.25rem + label.preferred-height + 0.25rem;
    border-radius: Theme.radius-xs * 1rem;
    border-width: 1px;
    border-color: root.selected || touch.has-hover ? Theme.primary : Theme.border.transparentize(0.4);
    background: root.selected ? Theme.surface-accent-soft : transparent;
    accessible-role: AccessibleRole.button;
    accessible-label: root.option.label;
    Rectangle {
        x: 0.25rem;
        y: 0.25rem;
        width: parent.width - 0.5rem;
        height: root.preview-height;
        border-radius: 2px;
        background: Theme.muted;
        if root.option.kind == TransitionOptionKind.xfade: TransitionPreview {
            index: root.option.index;
        }
        if root.option.kind == TransitionOptionKind.none: Icon {
            glyph: Icons.ban;
            size: 1rem;
            color: Theme.muted-foreground;
        }
        if root.option.kind == TransitionOptionKind.default: AppText {
            content: @tr("transitions.default" => "Default");
            font-size: 0.6rem;
            font-weight: Theme.font-weight-bold;
            color: Theme.muted-foreground;
        }
    }
    label := AppText {
        x: 0.25rem;
        y: 0.25rem + root.preview-height + 0.25rem;
        width: parent.width - 0.5rem;
        content: root.option.label;
        uppercase: false;
        font-size: 0.65rem;
        font-weight: Theme.font-weight-medium;
        overflow: elide;
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.chosen();
        }
    }
}

// `TransitionPicker`: the filter (`h-7`, `text-xs`, `mb-2`), then Default (for joins), None and
// each `xfade` as tiles in four columns (`gap-1.5`), at most 20rem high, scrolling with the thin
// scrollbar. Rust filters the options.
export component TransitionPicker inherits VerticalLayout {
    in property <[TransitionOption]> options;
    in property <string> value;
    in property <string> filter;
    callback filter-edited(text: string);
    callback chosen(value: string);

    property <length> gap: 0.375rem;
    property <length> tile-width: (grid.width - 3 * root.gap) / 4;
    property <length> tile-height: 0.75rem + (root.tile-width - 0.5rem) * 68 / 120 + 0.65rem * 1.6;
    property <int> rows: Math.ceil(root.options.length / 4);

    spacing: 0.5rem;
    Rectangle {
        height: 1.75rem;
        Input {
            width: parent.width;
            height: parent.height;
            text: root.filter;
            placeholder: @tr("transitions.filter" => "Filter transitions");
            label: @tr("transitions.filter" => "Filter transitions");
            font-size: Theme.text-xs * 1rem;
            edited(text) => {
                root.filter-edited(text);
            }
        }
    }
    ScrollArea {
        thin: true;
        height: min(20rem, root.rows * (root.tile-height + root.gap));
        grid := Rectangle {
            height: root.rows * (root.tile-height + root.gap) - root.gap;
            for option[index] in root.options: PickerTile {
                x: Math.mod(index, 4) * (root.tile-width + root.gap);
                y: Math.floor(index / 4) * (root.tile-height + root.gap);
                width: root.tile-width;
                option: option;
                selected: option.value == root.value;
                chosen => {
                    root.chosen(option.value);
                }
            }
        }
    }
}
