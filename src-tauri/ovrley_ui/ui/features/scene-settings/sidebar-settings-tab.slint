import { InspectorBlocks } from "../widget-editor/inspector-blocks.slint";
import { WidgetEditor } from "../widget-editor/index.slint";
import { SceneSettings } from "index.slint";

// `SidebarSettingsTab` (`space-y-8 py-6 px-4`): the overlay section, then the global settings.
export component SidebarSettingsTab inherits VerticalLayout {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
    padding-left: 1rem;
    padding-right: 1rem;
    alignment: start;
    InspectorBlocks {
        rows: SceneSettings.rows;
        // Every font select shares the system fonts the widget editor lists.
        system-fonts: WidgetEditor.system-fonts;
        draft(id, value) => {
            SceneSettings.draft(id, value);
        }
        commit-draft => {
            SceneSettings.commit-draft();
        }
        set-number(id, raw) => {
            SceneSettings.set-number(id, raw);
        }
        set-text(id, value) => {
            SceneSettings.set-text(id, value);
        }
        set-flag(id, value) => {
            SceneSettings.set-flag(id, value);
        }
        press(id) => {
            SceneSettings.press(id);
        }
    }
}
