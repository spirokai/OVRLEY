// The canvas background behind the scene. Image and video arrive with Phase 6.
export enum BackgroundMode { checker, black, white }

// One widget on the canvas (D10): its image and its raster rectangle, in logical pixels relative
// to the scene's top-left corner. Rotated families bake their rotation into the pixels.
export struct WidgetView {
    id: string,
    image: image,
    x: length,
    y: length,
    width: length,
    height: length,
}

// A transform handle in stage pixels: a resize square, rotated with its widget, or the knob.
export struct HandleView {
    x: length,
    y: length,
    rotation: angle,
    knob: bool,
}

// A guide's distance label in stage pixels.
export struct GuideLabelView {
    x: length,
    y: length,
    text: string,
    vertical: bool,
}

// A widget's type badge in stage pixels.
export struct BadgeView {
    x: length,
    y: length,
    rotation: angle,
    label: string,
}

// The overlay-editor feature's global (D5), written by `src/features/overlay_editor.rs`.
export global OverlayEditor {
    // The stage (the scroll area's content) and the scene inside it, in logical pixels.
    in property <length> stage-width;
    in property <length> stage-height;
    in property <length> scene-left;
    in property <length> scene-top;
    in property <length> scene-width;
    in property <length> scene-height;
    // Rust owns the scroll position (D11).
    in property <length> scroll-x;
    in property <length> scroll-y;
    in property <float> display-scale: 1;
    // "1920 × 1080".
    in property <string> scene-size-label;

    in property <BackgroundMode> background-mode;
    in property <color> background-color;
    in property <bool> grid-visible;
    // Grid lines as path commands in scene-display pixels, on device-pixel centres.
    in property <string> grid-commands;
    in property <bool> snap-to-grid;
    // "100%".
    in property <string> zoom-label;

    // Widgets in stacking order.
    in property <[WidgetView]> widgets;
    // A resource or render failure.
    in property <string> error;

    // The selection (D12, D13), in stage pixels: outlines as path commands, the handles, the
    // rotation line, the guides by style, their labels, the marquee and the badges.
    in property <string> selection-commands;
    in property <length> border-width: 1px;
    in property <[HandleView]> handles;
    in property <string> knob-line-commands;
    in property <length> handle-size;
    in property <length> knob-size;
    in property <length> guide-scale: 1px;
    in property <string> guides-normal;
    in property <string> guides-bold;
    in property <string> guides-dashed;
    in property <[GuideLabelView]> guide-labels;
    in property <bool> marquee-shown;
    in property <length> marquee-x;
    in property <length> marquee-y;
    in property <length> marquee-width;
    in property <length> marquee-height;
    in property <[BadgeView]> badges;
    // The pointer is over a widget (the move cursor).
    in property <bool> over-widget;

    // The editor area, the scroll area below the toolbar row, and the stage's padding.
    callback viewport-changed(editor-width: length, editor-height: length, scroll-width: length, scroll-height: length, padding: length, rem: length);
    // A wheel over the stage: deltas in logical pixels as Slint reports them, the cursor in
    // scroll-area coordinates, and the modifiers.
    callback wheel(delta-x: length, delta-y: length, x: length, y: length, alt: bool, control: bool, shift: bool, meta: bool);
    // The pointer over the stage, in scroll-area coordinates, with its modifiers.
    callback pointer-down(x: length, y: length, alt: bool, control: bool, shift: bool, meta: bool);
    callback pointer-move(x: length, y: length, alt: bool, control: bool, shift: bool, meta: bool);
    callback pointer-up(x: length, y: length, alt: bool, control: bool, shift: bool, meta: bool);
    callback pointer-leave();
    callback zoom-in();
    callback zoom-out();
    callback reset-zoom();
    callback set-background-mode(BackgroundMode);
    callback set-grid-visible(bool);
    callback set-snap-to-grid(bool);
}
