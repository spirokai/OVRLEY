import { Theme } from "../../theme/theme.slint";
import { AppText } from "../../components/app-text.slint";
import { Icon, Icons } from "../../components/icons.slint";
import { Button, ButtonVariant, ButtonSize } from "../../components/button.slint";
import { SectionHeading, SectionHeadingVariant } from "../../components/section-heading.slint";
import { ScrollArea } from "../../components/scroll-area.slint";
import { Select, SelectSize, SelectPosition } from "../../components/select.slint";
import { ShadowSize } from "../../components/shadow.slint";
import { SimpleTooltip } from "../../components/simple-tooltip.slint";
import { TabsList, TabsListVariant, TabsTriggerVariant, TabsContent } from "../../components/tabs.slint";
import { ChoiceKind, PlacementAlign } from "../../components/logic.slint";
import { SliderField } from "../widget-editor/form-controls.slint";
import { VideoSyncControls } from "video-sync-controls.slint";
import { VideoSync, LandmarkKind, LandmarkRowView, CandidateListView } from "index.slint";

export global Landmarks {
    // A landmark type's colour (`VIDEO_SYNC_LANDMARK_PRESENTATION`): stop, turn or location.
    public pure function color(kind: LandmarkKind) -> color {
        if kind == LandmarkKind.stop {
            return Theme.video-sync-stop;
        }
        if kind == LandmarkKind.location {
            return Theme.video-sync-location;
        }
        Theme.video-sync-turn
    }

    public pure function icon(kind: LandmarkKind) -> string {
        if kind == LandmarkKind.stop {
            return Icons.octagon-minus;
        }
        if kind == LandmarkKind.left-turn {
            return Icons.corner-up-left;
        }
        if kind == LandmarkKind.right-turn {
            return Icons.corner-up-right;
        }
        Icons.map-pin
    }

    public pure function label(kind: LandmarkKind) -> string {
        if kind == LandmarkKind.stop {
            return @tr("videoSync.stop" => "Stop");
        }
        if kind == LandmarkKind.left-turn {
            return @tr("videoSync.leftTurn" => "Left Turn");
        }
        if kind == LandmarkKind.right-turn {
            return @tr("videoSync.rightTurn" => "Right Turn");
        }
        @tr("videoSync.location" => "Location")
    }

    public pure function value(kind: LandmarkKind) -> string {
        if kind == LandmarkKind.stop {
            return "stop";
        }
        if kind == LandmarkKind.left-turn {
            return "leftTurn";
        }
        if kind == LandmarkKind.right-turn {
            return "rightTurn";
        }
        "location"
    }

    public pure function kind-of(value: string) -> LandmarkKind {
        if value == "stop" {
            return LandmarkKind.stop;
        }
        if value == "leftTurn" {
            return LandmarkKind.left-turn;
        }
        if value == "rightTurn" {
            return LandmarkKind.right-turn;
        }
        LandmarkKind.location
    }
}

// One landmark row: `min-h-10`, `rounded-xs`, a 70% border on `surface-elevated` at 70%; the
// `w-1` stripe in the type's colour, the type select (`h-7 w-40`, 0.7rem semibold uppercase in
// the type's colour), the video time (`text-xs`, tabular, muted) and delete (`h-7 w-7`).
component LandmarkRow inherits Rectangle {
    in property <LandmarkRowView> landmark;
    in property <bool> location-taken;

    min-height: 2.5rem;
    border-radius: Theme.radius-xs * 1rem;
    border-width: 1px;
    border-color: Theme.border.transparentize(0.3);
    background: Theme.surface-elevated.transparentize(0.3);
    clip: true;
    HorizontalLayout {
        Rectangle {
            width: 0.25rem;
            background: Landmarks.color(root.landmark.kind);
        }
        HorizontalLayout {
            padding-left: 0.25rem;
            padding-right: 0.25rem;
            spacing: 0.25rem;
            alignment: stretch;
            VerticalLayout {
                alignment: center;
                Select {
                    width: 10rem;
                    size: SelectSize.sm;
                    min-height: 1.75rem;
                    preferred-height: 1.75rem;
                    max-height: 1.75rem;
                    padding-x: 0.375rem;
                    font-size: 0.7rem;
                    uppercase: true;
                    shadow: ShadowSize.none;
                    position: SelectPosition.popper;
                    align: PlacementAlign.end;
                    item-icon-in-trigger: true;
                    text-color: Landmarks.color(root.landmark.kind);
                    chevron-color: Landmarks.color(root.landmark.kind);
                    value: Landmarks.value(root.landmark.kind);
                    items: [
                        { kind: ChoiceKind.item, value: "stop", label: @tr("videoSync.stop" => "Stop"), icon: Icons.octagon-minus, icon-color: Theme.video-sync-stop },
                        { kind: ChoiceKind.item, value: "leftTurn", label: @tr("videoSync.leftTurn" => "Left Turn"), icon: Icons.corner-up-left, icon-color: Theme.video-sync-turn },
                        { kind: ChoiceKind.item, value: "rightTurn", label: @tr("videoSync.rightTurn" => "Right Turn"), icon: Icons.corner-up-right, icon-color: Theme.video-sync-turn },
                        { kind: ChoiceKind.item, value: "location", label: @tr("videoSync.location" => "Location"), icon: Icons.map-pin, icon-color: Theme.video-sync-location, disabled: root.location-taken && root.landmark.kind != LandmarkKind.location },
                    ];
                    accessible-label: @tr("videoSync.changeLandmarkType" => "Change {0} landmark type", root.landmark.label);
                    value-changed(value) => {
                        VideoSync.set-landmark-kind(root.landmark.id, Landmarks.kind-of(value));
                    }
                }
            }
            AppText {
                horizontal-stretch: 1;
                min-width: 0px;
                content: root.landmark.time;
                font-size: Theme.text-xs * 1rem;
                color: Theme.muted-foreground;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                Button {
                    variant: ButtonVariant.ghost;
                    size: ButtonSize.icon;
                    width: 1.75rem;
                    height: 1.75rem;
                    icon: Icons.trash-2;
                    icon-size: 0.875rem;
                    text-color: Theme.muted-foreground;
                    hover-text-color: Theme.primary;
                    hover-background: Theme.surface-accent-soft;
                    accessible-label: @tr("videoSync.deleteLandmark" => "Delete {0} landmark", root.landmark.label);
                    clicked => {
                        VideoSync.remove-landmark(root.landmark.id);
                    }
                }
            }
        }
    }
}

// `VideoSyncLandmarkList`: the heading with Clear, then the sorted rows, or "No landmarks marked yet.".
component LandmarkList inherits VerticalLayout {
    spacing: 0.75rem;
    HorizontalLayout {
        SectionHeading {
            horizontal-stretch: 1;
            icon: Icons.map-pin;
            title: @tr("videoSync.yourLandmarks" => "Video Landmarks");
            variant: SectionHeadingVariant.drawer;
        }
        VerticalLayout {
            alignment: center;
            Button {
                variant: ButtonVariant.ghost;
                size: ButtonSize.sm;
                height: 1.5rem;
                padding-x: 0.5rem;
                font-size: 0.741rem;
                text: @tr("videoSync.clearLandmarks" => "Clear");
                text-color: Theme.muted-foreground;
                hover-text-color: Theme.foreground;
                hover-background: Theme.surface-elevated;
                disabled: VideoSync.landmarks.length == 0;
                clicked => {
                    VideoSync.clear-landmarks();
                }
            }
        }
    }
    if VideoSync.landmarks.length > 0: VerticalLayout {
        spacing: 0.375rem;
        accessible-role: list;
        accessible-label: @tr("videoSync.videoLandmarks" => "Video landmarks");
        for landmark in VideoSync.landmarks: LandmarkRow {
            landmark: landmark;
            location-taken: VideoSync.has-location-landmark;
        }
    }
    if VideoSync.landmarks.length == 0: HorizontalLayout {
        padding-left: 0.25rem;
        padding-right: 0.25rem;
        AppText {
            content: @tr("videoSync.noLandmarks" => "No landmarks marked yet.");
            font-size: Theme.text-xs * 1rem;
            color: Theme.muted-foreground.transparentize(0.5);
        }
    }
}

// One detected-event count: the number and its icon in the type's colour, with a tooltip.
component EventCount inherits Rectangle {
    in property <int> count;
    in property <string> glyph;
    in property <length> glyph-size: 1rem;
    in property <color> tone;
    in property <string> label;

    accessible-role: list-item;
    accessible-label: root.count + " " + root.label;
    HorizontalLayout {
        alignment: center;
        SimpleTooltip {
            content: root.label;
            HorizontalLayout {
                spacing: 0.25rem;
                AppText {
                    vertical-alignment: center;
                    content: root.count;
                    font-size: 0.8rem;
                    font-weight: Theme.font-weight-semibold;
                    color: root.tone;
                    }
                VerticalLayout {
                    alignment: center;
                    Icon {
                        glyph: root.glyph;
                        size: root.glyph-size;
                        color: root.tone;
                        stroke: 2.5;
                    }
                }
            }
        }
    }
}

// `VideoSyncCandidateList`: hidden until searched; the error, the stale notice, the cards, or the
// empty notice.
component CandidateList inherits VerticalLayout {
    in property <string> scope;
    in property <string> title;
    in property <CandidateListView> result;

    spacing: 1rem;
    if root.result.error != "": Rectangle {
        border-radius: Theme.radius-sm * 1rem;
        background: Theme.destructive.transparentize(0.9);
        VerticalLayout {
            padding: 1rem;
            AppText {
                content: root.result.error;
                font-size: Theme.text-xs * 1rem;
                font-weight: Theme.font-weight-medium;
                color: Theme.destructive;
                wrap: word-wrap;
                accessible-role: text;
            }
        }
    }
    if root.result.stale: AppText {
        content: @tr("videoSync.staleCandidates" => "Landmarks changed. Rerun the Sync again");
        font-size: Theme.text-xs * 1rem;
        font-weight: Theme.font-weight-medium;
        color: #fbbf24;
        wrap: word-wrap;
    }
    if root.result.cards.length > 0: VerticalLayout {
        spacing: 1rem;
        SectionHeading {
            icon: Icons.rotate-cw-clock;
            title: root.title;
            variant: SectionHeadingVariant.drawer;
        }
        VerticalLayout {
            spacing: 0.375rem;
            accessible-role: list;
            accessible-label: @tr("videoSync.candidates" => "Sync candidates");
            for card[index] in root.result.cards: Rectangle {
                min-height: 3.5rem;
                Button {
                    width: parent.width;
                    height: parent.height;
                    variant: card.applied ? ButtonVariant.default : ButtonVariant.ghost;
                    radius: Theme.radius-xs * 1rem;
                    border-width: 1px;
                    border-color: Theme.border.transparentize(0.3);
                    background: card.applied ? Theme.primary : Theme.surface-elevated.transparentize(0.3);
                    hover-background: card.applied ? Theme.primary.transparentize(0.1) : Theme.surface-elevated;
                    disabled: root.result.disabled;
                    accessible-label: @tr("videoSync.applyCandidate" => "Apply offset {0} seconds", card.offset);
                    clicked => {
                        VideoSync.apply-candidate(root.scope, index);
                    }
                }
                VerticalLayout {
                    x: 0.75rem;
                    width: parent.width - 3.25rem;
                    padding-top: 0.5rem;
                    padding-bottom: 0.5rem;
                    spacing: 0.125rem;
                    alignment: center;
                    AppText {
                        content: card.offset;
                        font-size: Theme.text-base * 1rem;
                        font-weight: Theme.font-weight-bold;
                                uppercase: true;
                        color: card.applied ? Theme.primary-foreground : Theme.foreground;
                    }
                    AppText {
                        content: card.subline;
                        font-size: 0.75rem;
                        font-weight: Theme.font-weight-bold;
                        uppercase: true;
                        color: card.applied ? Theme.primary-foreground.transparentize(0.4) : Theme.muted-foreground.transparentize(0.5);
                    }
                }
                if card.score != "": AppText {
                    x: parent.width - 0.75rem - self.preferred-width;
                    y: 0.5rem;
                    content: card.score;
                    font-size: Theme.text-sm * 1rem;
                    font-weight: Theme.font-weight-semibold;
                        color: card.score-color;
                }
                if card.applied: Rectangle {
                    x: parent.width - 0.5rem - self.width;
                    y: parent.height - 0.5rem - self.height;
                    width: 0.875rem;
                    height: 0.875rem;
                    border-radius: self.width / 2;
                    background: Theme.primary-foreground;
                    Icon {
                        glyph: Icons.check;
                        size: 0.625rem;
                        color: Theme.primary;
                        stroke: 3;
                    }
                }
            }
        }
    }
    if root.result.empty: AppText {
        content: @tr("videoSync.noCandidate" => "No candidate aligns at least two landmarks");
        font-size: Theme.text-xs * 1rem;
        color: Theme.muted-foreground;
        wrap: word-wrap;
    }
}

// The Manual Sync tab: the landmarks, then the sensitivity, the counts, both searches and their
// candidates (`space-y-8 pt-6`).
component ManualSyncTab inherits VerticalLayout {
    padding-top: 1.5rem;
    spacing: 2rem;
    LandmarkList { }
    VerticalLayout {
        spacing: 1rem;
        accessible-role: groupbox;
        accessible-label: @tr("videoSync.detection" => "Sensitivity & Detection");
        SectionHeading {
            icon: Icons.activity;
            title: @tr("videoSync.detection" => "Sensitivity & Detection");
            variant: SectionHeadingVariant.drawer;
        }
        HorizontalLayout {
            spacing: 1rem;
            SliderField {
                horizontal-stretch: 1;
                label: @tr("videoSync.speedSensitivity" => "Speed");
                value: VideoSync.speed-draft;
                minimum: VideoSync.speed-minimum;
                maximum: VideoSync.speed-maximum;
                step: 0.5;
                editable: false;
                value-display: VideoSync.speed-label;
                value-changed(value) => {
                    VideoSync.speed-changed(value);
                }
                value-committed(value) => {
                    VideoSync.speed-committed(value);
                }
            }
            SliderField {
                horizontal-stretch: 1;
                label: @tr("videoSync.turnSensitivity" => "Min turn");
                value: VideoSync.turn-draft;
                minimum: VideoSync.turn-minimum;
                maximum: VideoSync.turn-maximum;
                step: 5;
                editable: false;
                value-display: VideoSync.turn-label;
                value-changed(value) => {
                    VideoSync.turn-changed(value);
                }
                value-committed(value) => {
                    VideoSync.turn-committed(value);
                }
            }
        }
        // Four columns, `py-2`, dividers at 50%.
        Rectangle {
            height: 2.25rem;
            accessible-role: list;
            accessible-label: @tr("videoSync.detectedEvents" => "Detected events");
            HorizontalLayout {
                EventCount {
                    horizontal-stretch: 1;
                    count: VideoSync.left-turns;
                    glyph: Icons.corner-up-left;
                    tone: Theme.video-sync-turn;
                    label: @tr("videoSync.leftTurns" => "Left Turns");
                }
                EventCount {
                    horizontal-stretch: 1;
                    count: VideoSync.stops;
                    glyph: Icons.octagon-minus;
                    tone: Theme.video-sync-stop;
                    label: @tr("videoSync.stops" => "Stops");
                }
                EventCount {
                    horizontal-stretch: 1;
                    count: VideoSync.right-turns;
                    glyph: Icons.corner-up-right;
                    tone: Theme.video-sync-turn;
                    label: @tr("videoSync.rightTurns" => "Right Turns");
                }
                EventCount {
                    horizontal-stretch: 1;
                    count: VideoSync.locations;
                    glyph: Icons.map-pin;
                    glyph-size: 0.875rem;
                    tone: Theme.video-sync-location;
                    label: @tr("videoSync.locations" => "Locations");
                }
            }
            for column in 3: Rectangle {
                x: parent.width * (column + 1) / 4;
                y: 0.5rem;
                width: Theme.hairline;
                height: parent.height - 1rem;
                background: Theme.border.transparentize(0.5);
            }
        }
        VerticalLayout {
            spacing: 0.5rem;
            Button {
                text: @tr("videoSync.syncLandmarks" => "Sync All Landmarks");
                disabled: !VideoSync.can-calculate-all || VideoSync.calculating;
                clicked => {
                    VideoSync.calculate("all");
                }
            }
            Button {
                text: @tr("videoSync.syncLocation" => "Match Location Only");
                disabled: !VideoSync.can-calculate-location || VideoSync.calculating;
                clicked => {
                    VideoSync.calculate("location");
                }
            }
        }
        if !VideoSync.can-calculate-all && VideoSync.all-explanation != "": VerticalLayout {
            padding-top: 0.5rem;
            padding-bottom: 0.5rem;
            AppText {
                content: VideoSync.all-explanation;
                font-size: 0.741rem;
                color: Theme.muted-foreground;
                wrap: word-wrap;
            }
        }
        if VideoSync.location-result.shown: CandidateList {
            scope: "location";
            title: @tr("videoSync.locationSyncCandidates" => "Location Sync");
            result: VideoSync.location-result;
        }
        if VideoSync.all-result.shown: CandidateList {
            scope: "all";
            title: @tr("videoSync.syncCandidates" => "Sync Candidates");
            result: VideoSync.all-result;
        }
    }
}

// `VideoSyncDrawerContent`: the Autodetect and Manual Sync tabs (`main` variant, `text-sm`,
// `p-4 pt-2`) over a scrolling body (`px-3 pb-4`).
export component VideoSyncDrawer inherits VerticalLayout {
    TabsList {
        variant: TabsListVariant.main;
        trigger-variant: TabsTriggerVariant.main;
        stretch: true;
        trigger-padding-y: 0.5rem;
        items: [
            { kind: ChoiceKind.item, value: "autodetect", label: @tr("videoSync.autodetect" => "Autodetect") },
            { kind: ChoiceKind.item, value: "manual", label: @tr("videoSync.manualSync" => "Manual Sync") },
        ];
        value: VideoSync.tab;
        value-changed(value) => {
            VideoSync.set-tab(value);
        }
    }
    ScrollArea {
        vertical-stretch: 1;
        // Radix unmounts the inactive tab's content.
        if VideoSync.tab == "autodetect": VerticalLayout {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
            padding-bottom: 1rem;
            padding-top: 1.5rem;
            if VideoSync.has-videos: VideoSyncControls {
                sync: VideoSync.sync;
                can-open-manual-sync: true;
                compute => {
                    VideoSync.compute();
                }
                reset-creation-times => {
                    VideoSync.reset-creation-times();
                }
                filename-creation-times => {
                    VideoSync.filename-creation-times();
                }
                set-utc(utc) => {
                    VideoSync.set-utc(utc);
                }
                open-manual-sync => {
                    VideoSync.open-manual-sync();
                }
            }
        }
        if VideoSync.tab == "manual": VerticalLayout {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
            padding-bottom: 1rem;
            ManualSyncTab { }
        }
    }
}
