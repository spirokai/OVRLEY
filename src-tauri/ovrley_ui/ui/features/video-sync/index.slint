import { SecondsFieldView } from "../seconds-fields/index.slint";
import { Choice } from "../../components/logic.slint";

// `deriveVideoSyncControls` for one collection: the store's, or the import dialog's draft.
export struct VideoSyncView {
    can-reset-creation-time: bool,
    filename-creation-time-available: bool,
    // Apply Timezone shows only with an activity timezone.
    timezone-shown: bool,
    timezone-disabled: bool,
    utc: bool,
    warning: string,
    shared-offset: SecondsFieldView,
}

// `VIDEO_SYNC_LANDMARK_TYPES`, in the type select's order.
export enum LandmarkKind { stop, left-turn, right-turn, location }

// One landmark row of the drawer.
export struct LandmarkRowView {
    id: string,
    kind: LandmarkKind,
    label: string,
    time: string,
}

// One candidate card (`buildVideoSyncCandidateCards`).
export struct CandidateCardView {
    offset: string,
    subline: string,
    score: string,
    score-color: color,
    applied: bool,
}

// One search's list (`VideoSyncCandidateList`).
export struct CandidateListView {
    shown: bool,
    error: string,
    stale: bool,
    empty: bool,
    disabled: bool,
    cards: [CandidateCardView],
}

// A detected event's band over the graph; its tone is stop, turn or location.
export struct EventBandView {
    left: length,
    width: length,
    tone: LandmarkKind,
    tooltip: string,
    accessible-label: string,
}

// A landmark on the timeline: its handle and line, in timeline pixels.
export struct TimelineLandmarkView {
    id: string,
    kind: LandmarkKind,
    left: length,
    interactive: bool,
    seconds: string,
}

// Sync Doctor's global (Phase 8), written by `src/features/video_sync.rs`.
export global VideoSync {
    // The workspace mode: Sync Doctor is the active tool.
    in property <bool> mode;
    // Each screen is the scene at the display scale; the gap is 16 scene units.
    in property <length> screen-width;
    in property <length> screen-height;
    in property <length> screen-gap;

    // The drawer.
    in property <string> tab: "autodetect";
    in property <bool> has-videos;
    in property <VideoSyncView> sync;
    in property <[LandmarkRowView]> landmarks;
    in property <bool> has-location-landmark;
    in property <float> speed-draft;
    in property <float> turn-draft;
    in property <string> speed-label;
    in property <string> turn-label;
    in property <float> speed-minimum;
    in property <float> speed-maximum;
    in property <float> turn-minimum;
    in property <float> turn-maximum;
    in property <int> left-turns;
    in property <int> stops;
    in property <int> right-turns;
    in property <int> locations;
    in property <bool> can-calculate-all;
    in property <bool> can-calculate-location;
    in property <bool> calculating;
    in property <string> all-explanation;
    in property <CandidateListView> location-result;
    in property <CandidateListView> all-result;

    // The mark controls at the playhead.
    in property <bool> can-mark;
    in property <bool> can-mark-location;
    in property <string> mark-reason;
    in property <string> location-reason;

    // The timeline's graph row and landmark layer (D9).
    in property <length> graph-width;
    in property <string> speed-path;
    in property <string> turning-path;
    in property <[EventBandView]> bands;
    in property <[TimelineLandmarkView]> timeline-landmarks;

    // The selection map (D5): its image placed against the camera on show, and the markers.
    in property <bool> has-map-image;
    in property <image> map-image;
    in property <length> map-image-x;
    in property <length> map-image-y;
    in property <length> map-image-width;
    in property <length> map-image-height;
    in property <color> map-background;
    in property <bool> playback-shown;
    in property <length> playback-x;
    in property <length> playback-y;
    in property <bool> hover-shown;
    in property <length> hover-x;
    in property <length> hover-y;
    in property <bool> action-shown;
    in property <length> action-x;
    in property <length> action-y;
    in property <bool> pin-shown;
    in property <length> pin-x;
    in property <length> pin-y;
    in property <bool> popup-open;
    in property <bool> map-dragging;
    in property <bool> map-can-zoom-in;
    in property <bool> map-can-zoom-out;
    in property <[Choice]> map-styles;
    in property <string> map-style;
    in property <string> attribution;

    // The chase inset (D6).
    in property <bool> has-nav-image;
    in property <image> nav-image;
    in property <bool> nav-marker-shown;
    in property <float> nav-pitch;
    in property <float> nav-max-pitch;
    in property <bool> nav-can-zoom-in;
    in property <bool> nav-can-zoom-out;

    callback set-tab(tab: string);
    // The selection map's pointer: "down", "move", "up" or "leave", in screen coordinates.
    callback map-pointer(phase: string, x: length, y: length);
    callback map-wheel(delta-y: length, x: length, y: length, shift: bool);
    callback map-double-click(x: length, y: length, shift: bool);
    callback map-zoom(zoom-in: bool);
    callback set-location();
    callback pin-dropped(x: length, y: length);
    callback pin-clicked();
    callback delete-location();
    callback set-map-style(id: string);
    callback nav-wheel(delta-y: length, shift: bool);
    callback nav-zoom(zoom-in: bool);
    callback nav-pitch-changed(pitch: float);
    // A landmark handle's pointer: "down", "move" (timeline x), "up" or "cancel".
    callback landmark-pointer(id: string, phase: string, x: length);
    callback compute();
    callback reset-creation-times();
    callback filename-creation-times();
    callback set-utc(utc: bool);
    callback open-manual-sync();
    callback clear-landmarks();
    callback set-landmark-kind(id: string, kind: LandmarkKind);
    callback remove-landmark(id: string);
    callback speed-changed(value: float);
    callback speed-committed(value: float);
    callback turn-changed(value: float);
    callback turn-committed(value: float);
    callback calculate(scope: string);
    callback apply-candidate(scope: string, index: int);
    callback mark(kind: LandmarkKind);
}
