import { SecondsFieldView } from "../seconds-fields/index.slint";

// `deriveVideoSyncControls` for one collection: the store's, or the import dialog's draft.
export struct VideoSyncView {
    can-reset-creation-time: bool,
    filename-creation-time-available: bool,
    // Apply Timezone shows only with an activity timezone.
    timezone-shown: bool,
    timezone-disabled: bool,
    utc: bool,
    warning: string,
    shared-offset: SecondsFieldView,
}

// `VIDEO_SYNC_LANDMARK_TYPES`, in the type select's order.
export enum LandmarkKind { stop, left-turn, right-turn, location }

// One landmark row of the drawer.
export struct LandmarkRowView {
    id: string,
    kind: LandmarkKind,
    label: string,
    time: string,
}

// One candidate card (`buildVideoSyncCandidateCards`).
export struct CandidateCardView {
    offset: string,
    subline: string,
    score: string,
    score-color: color,
    applied: bool,
}

// One search's list (`VideoSyncCandidateList`).
export struct CandidateListView {
    shown: bool,
    error: string,
    stale: bool,
    empty: bool,
    disabled: bool,
    cards: [CandidateCardView],
}

// Sync Doctor's global (Phase 8), written by `src/features/video_sync.rs`.
export global VideoSync {
    // The workspace mode: Sync Doctor is the active tool.
    in property <bool> mode;
    // Each screen is the scene at the display scale; the gap is 16 scene units.
    in property <length> screen-width;
    in property <length> screen-height;
    in property <length> screen-gap;

    // The drawer.
    in property <string> tab: "autodetect";
    in property <bool> has-videos;
    in property <VideoSyncView> sync;
    in property <[LandmarkRowView]> landmarks;
    in property <bool> has-location-landmark;
    in property <float> speed-draft;
    in property <float> turn-draft;
    in property <string> speed-label;
    in property <string> turn-label;
    in property <float> speed-minimum;
    in property <float> speed-maximum;
    in property <float> turn-minimum;
    in property <float> turn-maximum;
    in property <int> left-turns;
    in property <int> stops;
    in property <int> right-turns;
    in property <int> locations;
    in property <bool> can-calculate-all;
    in property <bool> can-calculate-location;
    in property <bool> calculating;
    in property <string> all-explanation;
    in property <CandidateListView> location-result;
    in property <CandidateListView> all-result;

    // The mark controls at the playhead.
    in property <bool> can-mark;
    in property <bool> can-mark-location;
    in property <string> mark-reason;
    in property <string> location-reason;

    callback set-tab(tab: string);
    callback compute();
    callback reset-creation-times();
    callback filename-creation-times();
    callback set-utc(utc: bool);
    callback open-manual-sync();
    callback clear-landmarks();
    callback set-landmark-kind(id: string, kind: LandmarkKind);
    callback remove-landmark(id: string);
    callback speed-changed(value: float);
    callback speed-committed(value: float);
    callback turn-changed(value: float);
    callback turn-committed(value: float);
    callback calculate(scope: string);
    callback apply-candidate(scope: string, index: int);
    callback mark(kind: LandmarkKind);
}
