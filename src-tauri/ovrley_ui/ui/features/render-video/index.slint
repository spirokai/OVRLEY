import { Choice } from "../../components/logic.slint";

// `RenderProgressPanel`'s values.
export struct RenderProgressView {
    finished: bool,
    title: string,
    subtitle: string,
    summary: [string],
    percent-text: string,
    frames-text: string,
    percent: float,
    show-stats: bool,
    fps: string,
    remaining: string,
    cancel-shown: bool,
    cancelling: bool,
}

// One row of the video list beside a video export's progress.
export struct RenderQueueRow {
    filename: string,
    tooltip: string,
    done: bool,
    status-text: string,
    show-progress: bool,
    progress: float,
    loading: bool,
    has-stats: bool,
    stats-fps: string,
    stats-remaining: string,
    note: string,
    error: string,
}

// The render-video feature's global (Phase 7 D4), written by `src/features/render_video.rs`.
export global RenderVideo {
    // The dialog.
    in property <bool> open;
    // A single render's progress replaces the settings.
    in property <bool> progress-phase;
    // Escape and pressing outside close it.
    in property <bool> dismissable;
    // The video list opens beside the progress (72rem instead of 36rem).
    in property <bool> wide;
    in property <bool> has-videos;
    // The resolution mismatch screen's message; empty without one.
    in property <string> mismatch;

    // `RenderExportSettings`.
    in property <bool> show-export-mode;
    in property <bool> composite;
    in property <bool> show-output-modes;
    in property <bool> separate;
    in property <bool> locked;
    in property <string> fps-locked-text;
    in property <string> fps-mode;
    in property <string> fps;
    in property <[Choice]> update-rates;
    in property <string> update-rate;
    in property <string> container-fps-text;
    in property <[Choice]> formats;
    in property <string> format;
    in property <[Choice]> accelerations;
    in property <string> acceleration;
    in property <bool> show-quality;
    in property <bool> bitrate;
    in property <string> quality-label;
    in property <float> slider-value;
    in property <float> slider-minimum;
    in property <float> slider-maximum;
    in property <float> slider-step;
    in property <bool> show-full-activity;
    in property <bool> full-activity;
    in property <bool> show-folder;
    in property <string> folder-text;
    in property <string> output-path;
    in property <string> path-error;
    in property <bool> show-footer;
    in property <bool> cancel-disabled;
    in property <bool> settings-start-disabled;
    in property <bool> browse-disabled;

    // The progress and a video export's footer.
    in property <RenderProgressView> progress;
    in property <bool> show-batch-progress;
    in property <[RenderQueueRow]> rows;
    in property <[string]> blockers;
    in property <string> review-error;
    in property <string> close-text;
    in property <bool> close-disabled;
    in property <bool> show-start;
    in property <bool> start-running;
    in property <bool> start-disabled;

    // The overwrite question and the missing-videos notice.
    in property <bool> overwrite-open;
    in property <string> overwrite-path;
    in property <bool> missing-open;
    in property <string> missing-title;
    in property <string> missing-description;

    callback close();
    callback dismiss-missing();
    callback set-composite(composite: bool);
    callback set-separate(separate: bool);
    callback select-fps-mode(mode: string);
    callback set-custom-fps(fps: string);
    callback set-update-rate(rate: string);
    callback select-format(format: string);
    callback select-acceleration(acceleration: string);
    callback set-bitrate(bitrate: bool);
    callback set-quality(position: float);
    callback set-full-activity(enabled: bool);
    callback commit-output-path(path: string);
    callback browse();
    callback pick-folder();
    callback start();
    callback cancel-render();
    callback confirm-overwrite();
    callback cancel-overwrite();
}
