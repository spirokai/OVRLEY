import { Choice } from "../../components/logic.slint";

// How the user answers the unsaved-changes dialog.
export enum UnsavedAnswer { save, discard, cancel }

// The template-manager feature's global (D5), written by `src/features/template_manager.rs`.
export global TemplateManager {
    // The template select's entries: per resolution group a label and a separator, then the
    // templates, user templates suffixed "(User)".
    in property <[Choice]> choices;
    // The bundled template's id while one is loaded, else empty.
    in property <string> selected;
    // A file source's file name for the empty select; empty shows "Select Template...".
    in property <string> file-name;
    // Save is enabled while the status shows (Draft or Modified).
    in property <bool> can-save;
    // Increments when the select should open (`template.select`, Mod+T).
    in property <int> selector-open-serial;
    // The unsaved-changes dialog for a new template.
    in property <bool> confirm-open;

    callback select-template(string);
    callback new-template();
    callback import-template();
    callback save-template();
    callback answer-confirm(UnsavedAnswer);
}
