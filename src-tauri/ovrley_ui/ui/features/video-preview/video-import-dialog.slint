import { Theme, WindowMetrics } from "../../theme/theme.slint";
import { AppText } from "../../components/app-text.slint";
import { Icon, Icons } from "../../components/icons.slint";
import { Button, ButtonVariant, ButtonSize } from "../../components/button.slint";
import { Badge, BadgeVariant } from "../../components/badge.slint";
import { Dialog, DialogTitle } from "../../components/dialog.slint";
import { HelpTooltip } from "../../components/help-tooltip.slint";
import { ScrollArea } from "../../components/scroll-area.slint";
import { SectionHeading, SectionHeadingVariant } from "../../components/section-heading.slint";
import { SimpleTooltip } from "../../components/simple-tooltip.slint";
import { Switch, SwitchVariant } from "../../components/switch.slint";
import { SecondsSlot } from "../../components/seconds-input.slint";
import { PlacementAlign } from "../../components/logic.slint";
import { DialogPanel } from "../app-shell/dialogs.slint";
import { Spinner } from "../app-shell/shell-panels.slint";
import { FieldSecondsInput, SecondsFields } from "../seconds-fields/index.slint";
import { VideoSyncControls } from "../video-sync/video-sync-controls.slint";
import { TransitionSelectTrigger } from "../transitions/transition-select.slint";
import { VideoImport, ImportPhase, ImportTone, ImportRowView } from "index.slint";

// 0.7rem status lines.
component StatusLine inherits AppText {
    font-size: 0.7rem;
    uppercase: false;
    wrap: word-wrap;
}

// The amber alert of the single-file issues and the far question: `rounded-sm`, amber-500 at 15%,
// `p-3`, a 1rem triangle.
component AmberAlert inherits Rectangle {
    border-radius: Theme.radius-sm * 1rem;
    background: #f59e0b26;
    HorizontalLayout {
        padding: 0.75rem;
        spacing: 0.5rem;
        VerticalLayout {
            alignment: start;
            Icon {
                glyph: Icons.triangle-alert;
                color: #f59e0b;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0.25rem;
            @children
        }
    }
}

// `VideoImportRow`: a grid `2rem | 1fr | 4rem | 9.5rem`, `gap-3`, `px-2 py-2`, `rounded-sm`,
// hover `surface-elevated`: the status switch, the name (tooltip: path) with the "New" badge and
// the status lines, the move buttons, and the sync with its placement slot.
component ImportRow inherits TouchArea {
    in property <ImportRowView> entry;
    Rectangle {
        border-radius: Theme.radius-sm * 1rem;
        background: root.has-hover ? Theme.surface-elevated : transparent;
    }
    HorizontalLayout {
        padding: 0.5rem;
        spacing: 0.75rem;
        VerticalLayout {
            width: 2rem;
            alignment: start;
            Switch {
                variant: SwitchVariant.status;
                checked: root.entry.included;
                disabled: !root.entry.can-switch;
                accessible-label: root.entry.switch-label;
                checked-changed(checked) => {
                    VideoImport.row-included(root.entry.id, checked);
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 0.125rem;
            opacity: root.entry.included ? 1 : 0.6;
            HorizontalLayout {
                spacing: 0.5rem;
                SimpleTooltip {
                    content: root.entry.path;
                    align: PlacementAlign.start;
                    wrap-text: true;
                    horizontal-stretch: 1;
                    min-width: 0px;
                    AppText {
                        content: root.entry.filename;
                        uppercase: false;
                        font-size: Theme.text-xs * 1rem;
                        font-weight: Theme.font-weight-medium;
                        overflow: elide;
                    }
                }
                if root.entry.is-new: Badge {
                    variant: BadgeVariant.secondary;
                    text: @tr("video-preview.importNew" => "New");
                    radius: Theme.radius-xs * 1rem;
                    padding-x: 0.375rem;
                    padding-y: 0px;
                    font-size: 0.6rem;
                }
            }
            StatusLine {
                content: root.entry.format-label;
                color: root.entry.format-tone == ImportTone.red ? #b91c1c : root.entry.format-tone == ImportTone.amber ? #f59e0b : Theme.muted-foreground.transparentize(0.3);
            }
            if root.entry.status != "": StatusLine {
                content: root.entry.status;
                color: root.entry.status-red ? #b91c1c : #f59e0b;
            }
            if root.entry.far != "": StatusLine {
                content: root.entry.far;
                color: #f59e0b;
            }
            if root.entry.positioned: StatusLine {
                content: @tr("video-preview.importPositioned" => "Recording time unknown: use the arrows to place it after another video.");
                color: Theme.muted-foreground.transparentize(0.3);
            }
            for overlap in root.entry.overlaps: StatusLine {
                content: overlap;
                color: #f59e0b;
            }
        }
        HorizontalLayout {
            width: 4rem;
            alignment: start;
            for up in [true, false]: Button {
                variant: ButtonVariant.ghost;
                size: ButtonSize.icon;
                width: 2rem;
                height: 2rem;
                icon: up ? Icons.arrow-up : Icons.arrow-down;
                icon-size: 0.875rem;
                disabled: up ? !root.entry.can-move-up : !root.entry.can-move-down;
                accessible-label: up ? root.entry.move-up-label : root.entry.move-down-label;
                clicked => {
                    VideoImport.row-move(root.entry.id, up);
                }
            }
        }
        VerticalLayout {
            width: 9.5rem;
            alignment: start;
            FieldSecondsInput {
                field: root.entry.offset;
                field-height: 2rem;
                font-size: Theme.text-xs * 1rem;
                disabled: !root.entry.included;
                label: root.entry.sync-label;
                slot: root.entry.manual ? SecondsSlot.manual : SecondsSlot.auto;
                reset-label: root.entry.reset-label;
                manual-hint: @tr("toolbar.resetVideoStartHint" => "Set by hand. Click to place it by its recording time again.");
                auto-hint: @tr("toolbar.videoStartAutoHint" => "Placed automatically. Type a time to set it by hand.");
                reset => {
                    SecondsFields.clear(root.entry.offset.key);
                    VideoImport.row-reset(root.entry.id);
                }
            }
        }
    }
}

// `VideoImportDialog`: `max-w-5xl`, `h-[min(42rem,90vh)]`, `p-6`. While files are read, a spinner
// and "Reading {count} files…"; then two columns (2 : 3, `gap-8`): the global sync and the default
// transitions; the videos with the single-file issues above them and the failures below. The far
// question (`mt-6`) and the footer: the error, Cancel or Back, and the import button.
export component VideoImportDialog {
    property <bool> loading: VideoImport.phase == ImportPhase.probing;
    property <bool> importing: VideoImport.phase == ImportPhase.importing;
    property <bool> confirming: VideoImport.phase == ImportPhase.confirming;
    property <string> description: @tr("video-preview.importDescription" => "Check the sync of every video before importing. Sync is the start of a video in seconds from the start of the activity (or of the first video).");

    Dialog {
        open: VideoImport.open;
        title: @tr("video-preview.importTitle" => "Import videos");
        description: root.description;
        open-changed(open) => {
            if !open && !root.importing {
                VideoImport.cancel();
            }
        }
        DialogPanel {
            max-width: 64rem;
            preferred-width: 64rem;
            height: min(42rem, WindowMetrics.height * 0.9);
            VerticalLayout {
                padding: 1.5rem;
                HorizontalLayout {
                    spacing: 0.25rem;
                    alignment: start;
                    DialogTitle {
                        content: @tr("video-preview.importTitle" => "Import videos");
                        font-size: Theme.text-lg * 1rem;
                        font-weight: Theme.font-weight-bold;
                    }
                    if !root.loading: HelpTooltip {
                        content: root.description;
                    }
                }
                if root.loading: HorizontalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: 0.5rem;
                    VerticalLayout {
                        alignment: center;
                        Spinner { }
                    }
                    AppText {
                        content: VideoImport.reading-label;
                        uppercase: false;
                        vertical-alignment: center;
                        font-size: Theme.text-sm * 1rem;
                        color: Theme.muted-foreground;
                    }
                }
                if !root.loading: HorizontalLayout {
                    vertical-stretch: 1;
                    padding-top: 1rem;
                    spacing: 2rem;
                    ScrollArea {
                        horizontal-stretch: 2;
                        preferred-width: 0px;
                        min-width: 0px;
                        VerticalLayout {
                            spacing: 2rem;
                            alignment: start;
                            VideoSyncControls {
                                title: @tr("video-preview.importGlobalSync" => "Global sync");
                                sync: VideoImport.sync;
                                compute => {
                                    VideoImport.sync-compute();
                                }
                                reset-creation-times => {
                                    VideoImport.sync-reset-creation-times();
                                }
                                filename-creation-times => {
                                    VideoImport.sync-filename-creation-times();
                                }
                                set-utc(utc) => {
                                    VideoImport.sync-set-utc(utc);
                                }
                            }
                            VerticalLayout {
                                spacing: 0.75rem;
                                SectionHeading {
                                    icon: Icons.blend;
                                    title: @tr("toolbar.transitionDefaults" => "Default transitions");
                                    variant: SectionHeadingVariant.drawer;
                                }
                                HorizontalLayout {
                                    spacing: 1rem;
                                    AppText {
                                        horizontal-stretch: 1;
                                        preferred-width: 0px;
                                        content: @tr("video-preview.transitionType" => "Transition");
                                        font-size: Theme.text-xs * 1rem;
                                        font-weight: Theme.font-weight-bold;
                                        color: Theme.muted-foreground;
                                        vertical-alignment: center;
                                    }
                                    TransitionSelectTrigger {
                                        horizontal-stretch: 1;
                                        preferred-width: 0px;
                                        target: "import-defaults";
                                        label: VideoImport.transition-label;
                                        preview-index: VideoImport.transition-preview-index;
                                        small: true;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 1rem;
                                    AppText {
                                        horizontal-stretch: 1;
                                        preferred-width: 0px;
                                        content: @tr("video-preview.transitionDuration" => "Duration");
                                        font-size: Theme.text-xs * 1rem;
                                        font-weight: Theme.font-weight-bold;
                                        color: Theme.muted-foreground;
                                        vertical-alignment: center;
                                    }
                                    FieldSecondsInput {
                                        horizontal-stretch: 1;
                                        preferred-width: 0px;
                                        field: VideoImport.transition-duration;
                                        field-height: 2rem;
                                        font-size: Theme.text-xs * 1rem;
                                        show-unit: true;
                                        label: @tr("video-preview.transitionDuration" => "Duration");
                                    }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 3;
                        preferred-width: 0px;
                        min-width: 0px;
                        spacing: 1rem;
                        SectionHeading {
                            icon: Icons.film;
                            title: @tr("video-preview.importVideosHeading" => "Importing videos");
                            variant: SectionHeadingVariant.drawer;
                        }
                        if VideoImport.issues.length > 0: AmberAlert {
                            AppText {
                                content: @tr("video-preview.importSingleFileBlocked" => "These videos cannot be exported as one file:");
                                uppercase: false;
                                font-size: Theme.text-xs * 1rem;
                                font-weight: Theme.font-weight-semibold;
                                color: #f59e0b;
                                wrap: word-wrap;
                            }
                            for issue in VideoImport.issues: AppText {
                                content: issue;
                                uppercase: false;
                                font-size: Theme.text-xs * 1rem;
                                color: #f59e0b;
                                wrap: word-wrap;
                            }
                        }
                        Rectangle {
                            vertical-stretch: 1;
                            border-radius: Theme.radius-sm * 1rem;
                            border-width: 1px;
                            border-color: Theme.border.transparentize(0.3);
                            background: Theme.surface;
                            ScrollArea {
                                x: 0.5rem;
                                y: 0.5rem;
                                width: parent.width - 1rem;
                                height: parent.height - 1rem;
                                VerticalLayout {
                                    spacing: 0.25rem;
                                    alignment: start;
                                    for entry in VideoImport.rows: ImportRow {
                                        entry: entry;
                                    }
                                    for failure in VideoImport.failures: VerticalLayout {
                                        padding: 0.5rem;
                                        spacing: 0.125rem;
                                        opacity: 0.6;
                                        SimpleTooltip {
                                            content: failure.path;
                                            align: PlacementAlign.start;
                                            wrap-text: true;
                                            AppText {
                                                content: failure.name;
                                                uppercase: false;
                                                font-size: Theme.text-xs * 1rem;
                                                font-weight: Theme.font-weight-medium;
                                                overflow: elide;
                                            }
                                        }
                                        StatusLine {
                                            content: failure.message;
                                            color: #b91c1c;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if root.confirming: VerticalLayout {
                    padding-top: 1.5rem;
                    AmberAlert {
                        AppText {
                            content: VideoImport.far-text;
                            uppercase: false;
                            font-size: Theme.text-xs * 1rem;
                            color: #f59e0b;
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    padding-top: 1.5rem;
                    spacing: 0.75rem;
                    AppText {
                        horizontal-stretch: 1;
                        content: root.loading ? "" : VideoImport.error;
                        uppercase: false;
                        font-size: Theme.text-xs * 1rem;
                        color: #b91c1c;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    Button {
                        variant: ButtonVariant.outline;
                        text: root.confirming ? @tr("video-preview.importBack" => "Back") : @tr("video-preview.cancel" => "Cancel");
                        disabled: root.importing;
                        clicked => {
                            if root.confirming {
                                VideoImport.back();
                            } else {
                                VideoImport.cancel();
                            }
                        }
                    }
                    Rectangle {
                        // The widest label any count or the far question can show. The hidden
                        // labels are stacked, so the height is the button's alone.
                        min-width: alternatives.preferred-width + 3rem;
                        height: import-button.min-height;
                        alternatives := VerticalLayout {
                            visible: false;
                            for label in VideoImport.import-label-alternatives: AppText {
                                content: label;
                                uppercase: false;
                                font-size: Theme.text-sm * 1rem;
                                font-weight: Theme.font-weight-semibold;
                            }
                        }
                        import-button := Button {
                            width: parent.width;
                            icon: root.importing ? Icons.loader-circle : Icons.download;
                            text: root.confirming ? @tr("video-preview.importAnyway" => "Import anyway") : VideoImport.import-label;
                            disabled: root.loading || root.importing || !VideoImport.can-import;
                            clicked => {
                                VideoImport.confirm();
                            }
                        }
                    }
                }
            }
        }
    }
}
