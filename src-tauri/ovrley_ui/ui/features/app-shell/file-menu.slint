import { Theme } from "../../theme/theme.slint";
import { Icons } from "../../components/icons.slint";
import { Button, ButtonVariant, ButtonSize } from "../../components/button.slint";
import { Popover } from "../../components/popover.slint";
import { PlacementAlign } from "../../components/logic.slint";
import { Separator } from "../../components/separator.slint";

// `ActivitySection`'s `MenuItem`: a full-width ghost row, 0.7rem semibold uppercase, a 0.875rem
// icon 0.75rem from the label, 0.5rem side padding, hover `muted-foreground` at 10%. It fills the
// popover's width (`w-full`), so the hover background spans the row.
component MenuItem inherits HorizontalLayout {
    in property <string> icon;
    in property <string> label;
    in property <bool> disabled;
    callback clicked();

    Button {
        horizontal-stretch: 1;
        variant: ButtonVariant.ghost;
        icon: root.icon;
        icon-size: 0.875rem;
        text: root.label;
        uppercase: true;
        font-size: 0.7rem;
        padding-x: 0.5rem;
        spacing: 0.75rem;
        alignment: LayoutAlignment.start;
        disabled: root.disabled;
        hover-background: Theme.muted-foreground.transparentize(0.9);
        clicked => {
            root.clicked();
        }
    }
}

// `ActivitySection`'s File menu: the File button, 2rem high like the template select's trigger (the
// user's choice; React's is `h-9`), and a popover 13.75rem wide with `p-1`,
// 6px below, aligned at the start: the project items (Phase 6A step 8), "Import Activity", then
// "Import Videos", the groups `my-1.5` separators apart.
export component FileMenu {
    callback import-activity();
    callback import-videos();

    property <bool> open;

    trigger := Button {
        size: ButtonSize.sm;
        height: 2rem;
        icon: Icons.menu;
        icon-size: 0.875rem;
        text: @tr("app-shell.file" => "File");
        spacing: 0.5rem;
        accessible-label: @tr("app-shell.fileMenu" => "File menu");
        clicked => {
            root.open = !root.open;
        }
    }
    Popover {
        open: root.open;
        align: PlacementAlign.start;
        side-offset: 6px;
        content-width: 13.75rem;
        content-padding: 0.25rem;
        open-changed(open) => {
            root.open = open;
        }
        MenuItem {
            icon: Icons.activity;
            label: @tr("app-shell.importActivity" => "Import Activity");
            clicked => {
                root.open = false;
                root.import-activity();
            }
        }
        Rectangle {
            height: 0.75rem;
            Separator { }
        }
        MenuItem {
            icon: Icons.film;
            label: @tr("app-shell.importVideo" => "Import Videos");
            clicked => {
                root.open = false;
                root.import-videos();
            }
        }
    }
}
