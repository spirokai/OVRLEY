import { Theme } from "../../theme/theme.slint";
import { AppText } from "../../components/app-text.slint";
import { Icon, Icons } from "../../components/icons.slint";
import { Badge, BadgeVariant } from "../../components/badge.slint";
import { SimpleTooltip } from "../../components/simple-tooltip.slint";
import { Choice } from "../../components/logic.slint";
import { FileMenu } from "file-menu.slint";
import { TemplateSection } from "template-section.slint";

// One window button: 2.5rem wide, full height, muted; on hover `surface-elevated` and
// `foreground`, or `destructive` with white text for close.
component WindowButton inherits Rectangle {
    in property <string> glyph;
    in property <length> glyph-size: 1rem;
    in property <bool> destructive;
    in property <string> label;
    callback clicked();

    width: 2.5rem;
    background: touch.has-hover ? (root.destructive ? Theme.destructive : Theme.surface-elevated) : transparent;
    animate background { duration: Theme.duration-150; }
    accessible-role: AccessibleRole.button;
    accessible-label: root.label;
    accessible-action-default => {
        root.clicked();
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    Icon {
        glyph: root.glyph;
        size: root.glyph-size;
        color: touch.has-hover ? (root.destructive ? #ffffff : Theme.foreground) : Theme.muted-foreground;
    }
}

component WindowButtonSeparator inherits Rectangle {
    width: Theme.hairline;
    VerticalLayout {
        alignment: center;
        Rectangle {
            height: 1.5rem;
            background: Theme.border.transparentize(0.5);
        }
    }
}

// `WindowControls` on Windows and Linux: minimise, maximise and close in a 2.25rem row. On macOS
// the native traffic lights are used and only a 0.025rem spacer remains. "Minimize" and "Maximize"
// are hard-coded English, as today. A layout root, so the conditional rows give it their width.
export component WindowControls inherits HorizontalLayout {
    callback minimize();
    callback toggle-maximize();
    callback close();

    if Platform.os == OperatingSystemType.macos: Rectangle {
        width: 0.025rem;
    }
    if Platform.os != OperatingSystemType.macos: HorizontalLayout {
        padding-left: 0.5rem;
        height: 2.25rem;
        WindowButton {
            glyph: Icons.minus;
            label: "Minimize";
            clicked => {
                root.minimize();
            }
        }
        WindowButtonSeparator { }
        WindowButton {
            glyph: Icons.square;
            glyph-size: 0.875rem;
            label: "Maximize";
            clicked => {
                root.toggle-maximize();
            }
        }
        WindowButtonSeparator { }
        WindowButton {
            glyph: Icons.x;
            destructive: true;
            label: @tr("app-shell.close" => "Close");
            clicked => {
                root.close();
            }
        }
    }
}

// `AppHeader`: `card` with a bottom border; 0.75rem top and bottom padding, 0.25rem right, and
// 1.5rem left, or 7rem while the macOS traffic lights overlay it. Three columns 1.5rem apart:
// `ActivitySection` (logo, version, divider, File menu), `TemplateSection`, and the right column
// with the window controls. Empty header space drags the window and a double-click on it maximises
// or restores; presses on controls stay with the controls.
export component AppHeader inherits Rectangle {
    in property <bool> traffic-light-inset;
    in property <string> version;
    in property <bool> agent-connected;
    in property <[Choice]> template-choices;
    in property <string> selected-template;
    in property <string> template-file-name;
    in property <bool> can-save-template;
    in property <int> template-selector-open-serial;
    callback minimize-window();
    callback toggle-maximize-window();
    callback close-window();
    callback import-activity();
    callback import-videos();
    callback select-template(string);
    callback new-template();
    callback import-template();
    callback save-template();

    background: Theme.card;
    Rectangle {
        y: parent.height - Theme.hairline;
        height: Theme.hairline;
        background: Theme.border;
    }

    WindowMoveArea {
        // Behind the header content: a double-click on empty header space maximises or restores,
        // like a native title bar. A drag past the threshold is still taken by the move area.
        TouchArea {
            double-clicked => {
                root.toggle-maximize-window();
            }
        }
        HorizontalLayout {
            padding-top: 0.75rem;
            padding-bottom: 0.75rem;
            padding-right: 0.25rem;
            padding-left: root.traffic-light-inset ? 7rem : 1.5rem;
            spacing: 1.5rem;

            // ActivitySection: logo, divider, version, then a divider and the File menu, 1.5rem apart.
            HorizontalLayout {
              horizontal-stretch: 0;
              spacing: 1.5rem;
              HorizontalLayout {
                spacing: 0.5rem;
                alignment: start;
                HorizontalLayout {
                    padding-right: 0.75rem;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../../../../app/public/logo.svg");
                            height: 1.25rem;
                            accessible-role: AccessibleRole.image;
                            accessible-label: "OVRLEY";
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: Theme.hairline;
                        height: 2rem;
                        background: Theme.border.transparentize(0.4);
                    }
                }
                HorizontalLayout {
                    padding-top: 0.25rem;
                    padding-left: 0.75rem;
                    AppText {
                        content: root.version;
                        uppercase: false;
                        font-size: 0.8rem;
                        font-weight: Theme.font-weight-semibold;
                        color: Theme.muted-foreground.transparentize(0.3);
                        line-height: Theme.leading-none;
                    }
                }
            }
              VerticalLayout {
                  alignment: center;
                  Rectangle {
                      width: Theme.hairline;
                      height: 2rem;
                      background: Theme.border.transparentize(0.4);
                  }
              }
              VerticalLayout {
                  alignment: center;
                  FileMenu {
                      import-videos => {
                          root.import-videos();
                      }
                      import-activity => {
                          root.import-activity();
                      }
                  }
              }
            }
            TemplateSection {
                horizontal-stretch: 1;
                choices: root.template-choices;
                selected: root.selected-template;
                file-name: root.template-file-name;
                can-save: root.can-save-template;
                selector-open-serial: root.template-selector-open-serial;
                select-template(id) => {
                    root.select-template(id);
                }
                new-template => {
                    root.new-template();
                }
                import-template => {
                    root.import-template();
                }
                save-template => {
                    root.save-template();
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 0.75rem;
                // D13: an agent is connected over MCP and allowed to edit.
                if root.agent-connected: VerticalLayout {
                    alignment: center;
                    SimpleTooltip {
                        content: @tr("app-shell.agentConnectedHelp" => "An AI agent is connected over MCP and may change this window. Turn off \"Allow agent edits\" in Settings to stop it.");
                        side: bottom;
                        content-width: 20rem;
                        Badge {
                            variant: BadgeVariant.outline;
                            radius: 0px;
                            padding-x: 0.75rem;
                            padding-y: 0.375rem;
                            text: @tr("app-shell.agentConnected" => "Agent connected");
                            text-color: Theme.primary;
                            border-color: Theme.primary.transparentize(0.4);
                            // The status dot: green while the agent is connected.
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 0.5rem;
                                    height: 0.5rem;
                                    border-radius: 0.25rem;
                                    background: Theme.success;
                                }
                            }
                        }
                    }
                }
                WindowControls {
                    minimize => {
                        root.minimize-window();
                    }
                    toggle-maximize => {
                        root.toggle-maximize-window();
                    }
                    close => {
                        root.close-window();
                    }
                }
            }
        }
    }
}
